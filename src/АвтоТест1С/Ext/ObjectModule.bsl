
////////////////////////////////////////////////////////////////////////////////
// АвтоТест1С — платформа тестирования 1С с покрытием «из коробки».
//
// Ядро продукта. Подключились к базе — получили карту объектов, автоматическое
// покрытие типовых процессов и первый прогон без единой написанной строки
// сценария (FR-01 … FR-03).
//
// Реализованные требования черновика v0.1:
//   FR-01  Автообнаружение метаданных .......... ПостроитьКартуОбъектов()
//   FR-02  Автоматический обход интерфейса ..... СписокФормДляОбхода() + модуль формы
//   FR-03  Генерация тестовых данных ........... ЗаполнитьРеквизитыОбъекта()
//   FR-05  Модульное тестирование кода ......... ПроверкиОбъекта() (создание/заполнение/проведение)
//   FR-08  Тестирование при обновлении релиза .. СохранитьСнимок() / АнализВлиянияИзменений()
//   FR-10  Статический анализ (по метаданным) .. ПроверкиСтандартов()
//   FR-11  Тестирование ролей и прав доступа ... ПроверкаПравДоступа()
//   FR-12  Анализ влияния изменений ............ АнализВлиянияИзменений()
//   FR-13  Поддержка расширений ................ УчестьРасширения()
//   FR-18  Процент покрытия по подсистемам ..... РассчитатьПокрытие()
//   FR-19  Отчёт для нетехнического заказчика .. ОтчетHTMLДляБизнеса()
//   FR-20  Риск-карта перед релизом ............ РассчитатьРискКарту()
//   FR-26  Обезличивание данных (детекция) ..... ПроверкаПерсональныхДанных()
//   FR-27  Изоляция тестовых контуров .......... ПроверкаИзоляцииКонтура()
//
// Принцип безопасности: любые записи в ИБ выполняются ТОЛЬКО внутри транзакции,
// которая гарантированно отменяется. База после прогона не изменяется.
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Настройки прогона по умолчанию.
Функция НастройкиПрогона() Экспорт

	Настройки = Новый Структура;
	Настройки.Вставить("ПроверятьСправочники",      Истина);
	Настройки.Вставить("ПроверятьДокументы",        Истина);
	Настройки.Вставить("ПроверятьРегистры",         Истина);
	Настройки.Вставить("ПроверятьОтчеты",           Истина);
	Настройки.Вставить("ПроверятьКонстанты",        Истина);
	Настройки.Вставить("ПроводитьДокументы",        Истина);
	Настройки.Вставить("ПроверятьСтандарты",        Истина);
	Настройки.Вставить("ПроверятьПрава",            Истина);
	Настройки.Вставить("ПроверятьПерсональныеДанные", Истина);
	Настройки.Вставить("ПроверятьИзоляцию",         Истина);
	Настройки.Вставить("ОбходитьФормы",             Истина);
	Настройки.Вставить("ЛимитОбъектовНаВид",        0);      // 0 — без ограничения
	Настройки.Вставить("ЛимитФорм",                 0);
	Настройки.Вставить("ТолькоЗатронутыеИзменением", Ложь);  // FR-12
	Настройки.Вставить("ПутьСнимка",                "");
	Настройки.Вставить("КаталогОтчетов",            "");

	Возврат Настройки;

КонецФункции

// Основной серверный прогон. Возвращает структуру результата.
// Обход форм выполняется клиентом отдельно (см. СписокФормДляОбхода).
Функция ВыполнитьПрогон(Настройки) Экспорт

	Результат = ПустойРезультат();
	Результат.Вставить("Настройки", Настройки);

	Лог(Результат, "Конфигурация: " + Метаданные.Синоним + " (" + Метаданные.Имя + "), версия " + Метаданные.Версия);
	Лог(Результат, "Режим базы: " + ?(ЭтоФайловаяБаза(), "файловая", "клиент-сервер"));

	Результат.КартаОбъектов = ПостроитьКартуОбъектов(Настройки);
	Лог(Результат, "FR-01. Карта объектов построена: " + Результат.КартаОбъектов.Количество() + " объектов метаданных.");

	// FR-12 / FR-08: сузить прогон до объектов, задетых изменением.
	Затронутые = Неопределено;
	Если Настройки.ТолькоЗатронутыеИзменением И ЗначениеЗаполнено(Настройки.ПутьСнимка) Тогда
		Влияние = АнализВлиянияИзменений(Настройки.ПутьСнимка, Результат.КартаОбъектов);
		Результат.Вставить("Влияние", Влияние);
		Затронутые = Влияние.Затронутые;
		Лог(Результат, "FR-12. Изменено объектов: " + Влияние.Изменено
			+ ", добавлено: " + Влияние.Добавлено
			+ ", удалено: " + Влияние.Удалено
			+ ". К перепрогону отобрано " + Затронутые.Количество() + " из "
			+ Результат.КартаОбъектов.Количество() + ".");
	КонецЕсли;

	Контекст = НовыйКонтекстДанных();

	Для Каждого Строка Из Результат.КартаОбъектов Цикл

		Если Затронутые <> Неопределено И Затронутые[Строка.ПолноеИмя] = Неопределено Тогда
			Строка.Проверялся = Ложь;
			Продолжить;
		КонецЕсли;

		Если Не ВидВключенВПрогон(Строка.Вид, Настройки) Тогда
			Продолжить;
		КонецЕсли;

		ПроверкиОбъекта(Результат, Строка, Настройки, Контекст);
		Строка.Проверялся = Истина;

	КонецЦикла;

	Если Настройки.ПроверятьСтандарты Тогда
		ПроверкиСтандартов(Результат);
	КонецЕсли;

	Если Настройки.ПроверятьПрава Тогда
		ПроверкаПравДоступа(Результат);
	КонецЕсли;

	Если Настройки.ПроверятьПерсональныеДанные Тогда
		ПроверкаПерсональныхДанных(Результат);
	КонецЕсли;

	Если Настройки.ПроверятьИзоляцию Тогда
		ПроверкаИзоляцииКонтура(Результат);
	КонецЕсли;

	УчестьРасширения(Результат);

	Возврат Результат;

КонецФункции

// FR-02. Список форм для клиентского обхода: [{ИмяФормы, Объект, ПолноеИмя, Процесс, Критичность}]
Функция СписокФормДляОбхода(Результат, Настройки) Экспорт

	Список = Новый Массив;

	Для Каждого Строка Из Результат.КартаОбъектов Цикл

		Если Не Строка.Проверялся Тогда
			Продолжить;
		КонецЕсли;

		МО = Метаданные.НайтиПоПолномуИмени(Строка.ПолноеИмя);
		Если МО = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Попытка
			Формы = МО.Формы;
		Исключение
			Продолжить;
		КонецПопытки;

		Для Каждого Форма Из Формы Цикл
			Описание = Новый Структура;
			Описание.Вставить("ИмяФормы",    Строка.ПолноеИмя + ".Форма." + Форма.Имя);
			Описание.Вставить("ПолноеИмя",   Строка.ПолноеИмя);
			Описание.Вставить("Объект",      Строка.Синоним);
			Описание.Вставить("Вид",         Строка.Вид);
			Описание.Вставить("Процесс",     Строка.Процесс);
			Описание.Вставить("Критичность", Строка.Критичность);
			Список.Добавить(Описание);

			Если Настройки.ЛимитФорм > 0 И Список.Количество() >= Настройки.ЛимитФорм Тогда
				Возврат Список;
			КонецЕсли;
		КонецЦикла;

	КонецЦикла;

	Возврат Список;

КонецФункции

// FR-02. Приём результатов клиентского обхода форм.
// ДанныеОбхода — массив структур {ИмяФормы, Объект, Вид, Процесс, Критичность, Успех, Сообщение, Длительность}
Процедура ДобавитьРезультатыОбходаФорм(Результат, ДанныеОбхода) Экспорт

	Для Каждого Элемент Из ДанныеОбхода Цикл

		Если Элемент.Успех Тогда
			ДобавитьПроверку(Результат, Элемент.Вид, Элемент.ИмяФормы, Элемент.Объект,
				Элемент.Процесс, Элемент.Критичность, "FR-02. Открытие формы", "Пройдено", "",
				Элемент.Длительность);
		Иначе
			Класс = КлассифицироватьОшибку(Элемент.Сообщение);
			ДобавитьПроверку(Результат, Элемент.Вид, Элемент.ИмяФормы, Элемент.Объект,
				Элемент.Процесс, Элемент.Критичность, "FR-02. Открытие формы", Класс.Статус,
				Класс.Причина + ": " + СокрЛП(Элемент.Сообщение), Элемент.Длительность);
		КонецЕсли;

	КонецЦикла;

	Лог(Результат, "FR-02. Обход интерфейса: проверено форм — " + ДанныеОбхода.Количество() + ".");

КонецПроцедуры

// Завершение прогона: покрытие, риск-карта, метрики.
Процедура ЗавершитьПрогон(Результат) Экспорт

	Результат.ДатаОкончания = ТекущаяДата();
	РассчитатьПокрытие(Результат);
	РассчитатьРискКарту(Результат);
	РассчитатьМетрики(Результат);

	Лог(Результат, "FR-18. Покрытие рассчитано по " + Результат.Покрытие.Количество() + " подсистемам.");
	Лог(Результат, "FR-20. Риск-карта: " + Результат.РискКарта.Количество() + " бизнес-процессов, "
		+ Результат.Метрики.Ошибок + " ошибок, " + Результат.Метрики.Предупреждений + " предупреждений.");
	Лог(Результат, "Прогон завершён за " + Формат(Результат.ДатаОкончания - Результат.ДатаНачала, "ЧЦ=10; ЧГ=0") + " сек.");

КонецПроцедуры

#КонецОбласти

#Область КартаОбъектов

// FR-01. Автообнаружение метаданных: карта объектов конфигурации без ручной настройки.
Функция ПостроитьКартуОбъектов(Настройки) Экспорт

	Карта = Новый ТаблицаЗначений;
	Карта.Колонки.Добавить("Вид",             Новый ОписаниеТипов("Строка"));
	Карта.Колонки.Добавить("Имя",             Новый ОписаниеТипов("Строка"));
	Карта.Колонки.Добавить("ПолноеИмя",       Новый ОписаниеТипов("Строка"));
	Карта.Колонки.Добавить("Синоним",         Новый ОписаниеТипов("Строка"));
	Карта.Колонки.Добавить("Подсистемы",      Новый ОписаниеТипов("Строка"));
	Карта.Колонки.Добавить("Процесс",         Новый ОписаниеТипов("Строка"));
	Карта.Колонки.Добавить("Критичность",     Новый ОписаниеТипов("Число"));
	Карта.Колонки.Добавить("Реквизитов",      Новый ОписаниеТипов("Число"));
	Карта.Колонки.Добавить("ТабличныхЧастей", Новый ОписаниеТипов("Число"));
	Карта.Колонки.Добавить("Форм",            Новый ОписаниеТипов("Число"));
	Карта.Колонки.Добавить("Хеш",             Новый ОписаниеТипов("Строка"));
	Карта.Колонки.Добавить("Проверялся",      Новый ОписаниеТипов("Булево"));

	ИндексПодсистем = ПостроитьИндексПодсистем();

	Коллекции = Новый Массив;
	Коллекции.Добавить(Новый Структура("Вид, Коллекция", "Справочник",             Метаданные.Справочники));
	Коллекции.Добавить(Новый Структура("Вид, Коллекция", "Документ",               Метаданные.Документы));
	Коллекции.Добавить(Новый Структура("Вид, Коллекция", "РегистрСведений",        Метаданные.РегистрыСведений));
	Коллекции.Добавить(Новый Структура("Вид, Коллекция", "РегистрНакопления",      Метаданные.РегистрыНакопления));
	Коллекции.Добавить(Новый Структура("Вид, Коллекция", "РегистрБухгалтерии",     Метаданные.РегистрыБухгалтерии));
	Коллекции.Добавить(Новый Структура("Вид, Коллекция", "ПланВидовХарактеристик", Метаданные.ПланыВидовХарактеристик));
	Коллекции.Добавить(Новый Структура("Вид, Коллекция", "ПланСчетов",             Метаданные.ПланыСчетов));
	Коллекции.Добавить(Новый Структура("Вид, Коллекция", "БизнесПроцесс",          Метаданные.БизнесПроцессы));
	Коллекции.Добавить(Новый Структура("Вид, Коллекция", "Задача",                 Метаданные.Задачи));
	Коллекции.Добавить(Новый Структура("Вид, Коллекция", "Отчет",                  Метаданные.Отчеты));
	Коллекции.Добавить(Новый Структура("Вид, Коллекция", "Обработка",              Метаданные.Обработки));
	Коллекции.Добавить(Новый Структура("Вид, Коллекция", "Константа",              Метаданные.Константы));
	Коллекции.Добавить(Новый Структура("Вид, Коллекция", "ПланОбмена",             Метаданные.ПланыОбмена));

	Для Каждого Описание Из Коллекции Цикл

		Счетчик = 0;

		Для Каждого МО Из Описание.Коллекция Цикл

			Если Настройки.ЛимитОбъектовНаВид > 0 И Счетчик >= Настройки.ЛимитОбъектовНаВид Тогда
				Прервать;
			КонецЕсли;
			Счетчик = Счетчик + 1;

			Строка = Карта.Добавить();
			Строка.Вид       = Описание.Вид;
			Строка.Имя       = МО.Имя;
			Строка.ПолноеИмя = МО.ПолноеИмя();
			Строка.Синоним   = ?(ПустаяСтрока(МО.Синоним), МО.Имя, МО.Синоним);

			Подсистемы = ИндексПодсистем[МО.ПолноеИмя()];
			Строка.Подсистемы = ?(Подсистемы = Неопределено, "", СтрСоединить(Подсистемы, ", "));

			Процесс = ОпределитьБизнесПроцесс(Строка.Имя, Строка.Синоним, Строка.Подсистемы, Строка.Вид);
			Строка.Процесс     = Процесс.Имя;
			Строка.Критичность = Процесс.Критичность;

			Строка.Реквизитов      = КоличествоЭлементов(МО, "Реквизиты");
			Строка.ТабличныхЧастей = КоличествоЭлементов(МО, "ТабличныеЧасти");
			Строка.Форм            = КоличествоЭлементов(МО, "Формы");
			Строка.Хеш             = ХешОбъектаМетаданных(МО);

		КонецЦикла;

	КонецЦикла;

	Возврат Карта;

КонецФункции

Функция КоличествоЭлементов(МО, ИмяКоллекции)

	Попытка
		Возврат МО[ИмяКоллекции].Количество();
	Исключение
		Возврат 0;
	КонецПопытки;

КонецФункции

// Индекс «полное имя объекта» -> массив синонимов подсистем (в т.ч. вложенных).
Функция ПостроитьИндексПодсистем()

	Индекс = Новый Соответствие;
	ОбойтиПодсистемы(Метаданные.Подсистемы, "", Индекс);
	Возврат Индекс;

КонецФункции

Процедура ОбойтиПодсистемы(Подсистемы, Префикс, Индекс)

	Для Каждого Подсистема Из Подсистемы Цикл

		Имя = ?(ПустаяСтрока(Подсистема.Синоним), Подсистема.Имя, Подсистема.Синоним);
		ПолноеИмяПодсистемы = ?(ПустаяСтрока(Префикс), Имя, Префикс + " / " + Имя);

		Для Каждого Объект Из Подсистема.Состав Цикл
			Ключ = Объект.ПолноеИмя();
			Список = Индекс[Ключ];
			Если Список = Неопределено Тогда
				Список = Новый Массив;
				Индекс.Вставить(Ключ, Список);
			КонецЕсли;
			Если Список.Найти(ПолноеИмяПодсистемы) = Неопределено Тогда
				Список.Добавить(ПолноеИмяПодсистемы);
			КонецЕсли;
		КонецЦикла;

		ОбойтиПодсистемы(Подсистема.Подсистемы, ПолноеИмяПодсистемы, Индекс);

	КонецЦикла;

КонецПроцедуры

// FR-19 / FR-20. Отображение объекта метаданных на язык бизнес-процессов.
// Правила подобраны под типовые конфигурации (Розница, УТ, ERP, БП, ЗУП).
Функция ОпределитьБизнесПроцесс(Имя, Синоним, Подсистемы, Вид)

	Текст = ВРег(Имя + " " + Синоним + " " + Подсистемы);

	Правила = ПравилаБизнесПроцессов();

	Для Каждого Правило Из Правила Цикл
		Для Каждого Ключ Из Правило.Ключи Цикл
			Если СтрНайти(Текст, Ключ) > 0 Тогда
				Возврат Новый Структура("Имя, Критичность", Правило.Процесс, Правило.Критичность);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Если Вид = "Справочник" Или Вид = "ПланВидовХарактеристик" Тогда
		Возврат Новый Структура("Имя, Критичность", "НСИ и справочные данные", 2);
	КонецЕсли;

	Возврат Новый Структура("Имя, Критичность", "Прочее", 1);

КонецФункции

Функция ПравилаБизнесПроцессов()

	Правила = Новый Массив;

	ДобавитьПравило(Правила, "Продажа и касса", 3,
		"ЧЕКККМ,РМК,КАССОВ,ПРОДАЖ,РОЗНИЧН,ВОЗВРАТТОВАРОВОТПОКУПАТ,ФИСКАЛЬН,СМЕНА");
	ДобавитьПравило(Правила, "Деньги и оплаты", 3,
		"ОПЛАТ,ПЛАТЕЖ,БАНК,ДЕНЕЖНЫХСРЕДСТВ,ЭКВАЙРИНГ,ИНКАССАЦ,РКО,ПКО,ВЗАИМОРАСЧЕТ");
	ДобавитьПравило(Правила, "Интеграции и обмены", 3,
		"ОБМЕН,СИНХРОНИЗАЦ,ИНТЕГРАЦ,ЭДО,МАРКЕТПЛЕЙС,ВЕБСЕРВИС,МАРКИРОВК,ЕГАИС,ЧЕСТНЫЙЗНАК,ОФД");
	ДобавитьПравило(Правила, "Закрытие периода и отчётность", 3,
		"ЗАКРЫТИЕ,РЕГЛАМЕНТ,НАЛОГ,ОТЧЕТНОСТЬ,ПЕРЕОЦЕНК,СЕБЕСТОИМОСТ");
	ДобавитьПравило(Правила, "Зарплата и персонал", 3,
		"ЗАРПЛАТ,СОТРУДНИК,НАЧИСЛЕН,УДЕРЖАН,КАДРОВ,ТАБЕЛЬ,ОТПУСК");
	ДобавитьПравило(Правила, "Отгрузка и склад", 2,
		"ПЕРЕМЕЩЕН,СКЛАД,ИНВЕНТАРИЗ,СПИСАНИЕ,ОПРИХОДОВАН,ОТГРУЗК,ПЕРЕСОРТ,СБОРК,УПАКОВК");
	ДобавитьПравило(Правила, "Закупки", 2,
		"ПОСТУПЛЕН,ЗАКУПК,ПОСТАВЩИК,ЗАКАЗПОСТАВЩИКУ,ВОЗВРАТТОВАРОВПОСТАВЩИК");
	ДобавитьПравило(Правила, "Маркетинг и лояльность", 2,
		"ЛОЯЛЬНОСТ,БОНУС,СКИДК,МАРКЕТИНГ,КУПОН,ПОДАРОЧН,АКЦИ,ЦЕНООБРАЗОВАН,ЦЕН");
	ДобавитьПравило(Правила, "НСИ и справочные данные", 2,
		"НОМЕНКЛАТУР,КОНТРАГЕНТ,ОРГАНИЗАЦИ,МАГАЗИН,ПАРТНЕР,ПОЛЬЗОВАТЕЛ,КЛАССИФИКАТОР");
	ДобавитьПравило(Правила, "Администрирование", 1,
		"АДМИНИСТРИР,НАСТРОЙК,СЕРВИС,ЖУРНАЛРЕГИСТР,ПРАВА,ДОСТУП,ВЕРСИОНИР");

	Возврат Правила;

КонецФункции

Процедура ДобавитьПравило(Правила, Процесс, Критичность, КлючиСтрокой)

	Правило = Новый Структура;
	Правило.Вставить("Процесс",     Процесс);
	Правило.Вставить("Критичность", Критичность);
	Правило.Вставить("Ключи",       СтрРазделить(КлючиСтрокой, ","));
	Правила.Добавить(Правило);

КонецПроцедуры

// Подпись структуры объекта — основа для FR-12 (анализ влияния изменений).
Функция ХешОбъектаМетаданных(МО)

	Подпись = МО.ПолноеИмя() + "|" + МО.Синоним + "|";

	Подпись = Подпись + СобратьПодписьКоллекции(МО, "Реквизиты");
	Подпись = Подпись + СобратьПодписьКоллекции(МО, "Измерения");
	Подпись = Подпись + СобратьПодписьКоллекции(МО, "Ресурсы");
	Подпись = Подпись + СобратьПодписьКоллекции(МО, "Формы");
	Подпись = Подпись + СобратьПодписьКоллекции(МО, "Команды");

	Попытка
		Для Каждого ТЧ Из МО.ТабличныеЧасти Цикл
			Подпись = Подпись + "ТЧ:" + ТЧ.Имя + "(" + СобратьПодписьКоллекции(ТЧ, "Реквизиты") + ")";
		КонецЦикла;
	Исключение
		// у объекта нет табличных частей
	КонецПопытки;

	Хеширование = Новый ХешированиеДанных(ХешФункция.MD5);
	Хеширование.Добавить(Подпись);

	// ХешСуммаСтрокой есть не во всех версиях платформы, поэтому переводим
	// двоичный результат в hex сами — формат подписи от этого не меняется
	Возврат ПолучитьHexСтрокуИзДвоичныхДанных(Хеширование.ХешСумма);

КонецФункции

Функция СобратьПодписьКоллекции(МО, ИмяКоллекции)

	Результат = "";

	Попытка
		Коллекция = МО[ИмяКоллекции];
	Исключение
		Возврат "";
	КонецПопытки;

	Для Каждого Элемент Из Коллекция Цикл
		Результат = Результат + Элемент.Имя;
		Попытка
			Результат = Результат + ":" + Строка(Элемент.Тип);
		Исключение
			// у элемента нет типа (формы, команды)
		КонецПопытки;
		Результат = Результат + ";";
	КонецЦикла;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область Проверки

Функция ВидВключенВПрогон(Вид, Настройки)

	Если Вид = "Справочник" Или Вид = "ПланВидовХарактеристик" Или Вид = "ПланСчетов"
		Или Вид = "БизнесПроцесс" Или Вид = "Задача" Или Вид = "ПланОбмена" Тогда
		Возврат Настройки.ПроверятьСправочники;
	ИначеЕсли Вид = "Документ" Тогда
		Возврат Настройки.ПроверятьДокументы;
	ИначеЕсли Вид = "РегистрСведений" Или Вид = "РегистрНакопления" Или Вид = "РегистрБухгалтерии" Тогда
		Возврат Настройки.ПроверятьРегистры;
	ИначеЕсли Вид = "Отчет" Тогда
		Возврат Настройки.ПроверятьОтчеты;
	ИначеЕсли Вид = "Константа" Тогда
		Возврат Настройки.ПроверятьКонстанты;
	КонецЕсли;

	Возврат Ложь;

КонецФункции

Процедура ПроверкиОбъекта(Результат, СтрокаКарты, Настройки, Контекст)

	Вид = СтрокаКарты.Вид;

	// Проверка 1 (общая): доступность таблицы объекта запросом.
	Если Вид <> "Константа" И Вид <> "Отчет" И Вид <> "Обработка" Тогда
		ПроверкаЗапросКТаблице(Результат, СтрокаКарты);
	КонецЕсли;

	Если Вид = "Справочник" Или Вид = "ПланВидовХарактеристик" Или Вид = "ПланСчетов"
		Или Вид = "БизнесПроцесс" Или Вид = "Задача" Или Вид = "ПланОбмена" Тогда

		ПроверкаСозданияЭлемента(Результат, СтрокаКарты, Контекст);

	ИначеЕсли Вид = "Документ" Тогда

		ПроверкаСозданияДокумента(Результат, СтрокаКарты, Настройки, Контекст);

	ИначеЕсли Вид = "РегистрНакопления" Тогда

		ПроверкаВиртуальныхТаблиц(Результат, СтрокаКарты);

	ИначеЕсли Вид = "Константа" Тогда

		ПроверкаКонстанты(Результат, СтрокаКарты);

	ИначеЕсли Вид = "Отчет" Тогда

		ПроверкаСхемыОтчета(Результат, СтрокаКарты);

	КонецЕсли;

КонецПроцедуры

Процедура ПроверкаЗапросКТаблице(Результат, СтрокаКарты)

	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();

	Попытка
		Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 * ИЗ " + СтрокаКарты.ПолноеИмя + " КАК Т");
		Запрос.Выполнить();
		ДобавитьПроверку(Результат, СтрокаКарты.Вид, СтрокаКарты.ПолноеИмя, СтрокаКарты.Синоним,
			СтрокаКарты.Процесс, СтрокаКарты.Критичность, "Доступность таблицы (запрос)", "Пройдено", "",
			ДлительностьСек(Начало));
	Исключение
		Класс = КлассифицироватьОшибку(ОписаниеОшибки());
		ДобавитьПроверку(Результат, СтрокаКарты.Вид, СтрокаКарты.ПолноеИмя, СтрокаКарты.Синоним,
			СтрокаКарты.Процесс, СтрокаКарты.Критичность, "Доступность таблицы (запрос)", Класс.Статус,
			ОписаниеОшибки(), ДлительностьСек(Начало));
	КонецПопытки;

КонецПроцедуры

// FR-03 + FR-05: создание объекта, автозаполнение и запись в отменяемой транзакции.
Процедура ПроверкаСозданияЭлемента(Результат, СтрокаКарты, Контекст)

	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();

	Попытка

		Менеджер = МенеджерОбъекта(СтрокаКарты.Вид, СтрокаКарты.Имя);
		Если Менеджер = Неопределено Тогда
			Возврат;
		КонецЕсли;

		Объект = СоздатьНовыйОбъект(Менеджер, СтрокаКарты.Вид);
		Если Объект = Неопределено Тогда
			Возврат;
		КонецЕсли;

		Попытка
			Объект.Заполнить(Неопределено);
		Исключение
			ДобавитьПроверку(Результат, СтрокаКарты.Вид, СтрокаКарты.ПолноеИмя, СтрокаКарты.Синоним,
				СтрокаКарты.Процесс, СтрокаКарты.Критичность, "FR-03. Обработка заполнения", "Ошибка",
				ОписаниеОшибки(), ДлительностьСек(Начало));
		КонецПопытки;

		МО = Метаданные.НайтиПоПолномуИмени(СтрокаКарты.ПолноеИмя);
		ЗаполнитьРеквизитыОбъекта(Объект, МО, Контекст);

		ДобавитьПроверку(Результат, СтрокаКарты.Вид, СтрокаКарты.ПолноеИмя, СтрокаКарты.Синоним,
			СтрокаКарты.Процесс, СтрокаКарты.Критичность, "FR-03. Создание и автозаполнение", "Пройдено", "",
			ДлительностьСек(Начало));

	Исключение
		Класс = КлассифицироватьОшибку(ОписаниеОшибки());
		ДобавитьПроверку(Результат, СтрокаКарты.Вид, СтрокаКарты.ПолноеИмя, СтрокаКарты.Синоним,
			СтрокаКарты.Процесс, СтрокаКарты.Критичность, "FR-03. Создание и автозаполнение", Класс.Статус,
			ОписаниеОшибки(), ДлительностьСек(Начало));
	КонецПопытки;

КонецПроцедуры

// FR-05. Сквозная проверка документа: заполнение -> проведение -> наличие движений.
// Всё внутри транзакции, которая всегда отменяется (FR-27: база не меняется).
Процедура ПроверкаСозданияДокумента(Результат, СтрокаКарты, Настройки, Контекст)

	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
	МО = Метаданные.НайтиПоПолномуИмени(СтрокаКарты.ПолноеИмя);

	Документ = Неопределено;

	Попытка
		Документ = Документы[СтрокаКарты.Имя].СоздатьДокумент();
		Документ.Дата = ТекущаяДата();
		Попытка
			Документ.Заполнить(Неопределено);
		Исключение
			ДобавитьПроверку(Результат, СтрокаКарты.Вид, СтрокаКарты.ПолноеИмя, СтрокаКарты.Синоним,
				СтрокаКарты.Процесс, СтрокаКарты.Критичность, "FR-03. Обработка заполнения", "Ошибка",
				ОписаниеОшибки(), ДлительностьСек(Начало));
		КонецПопытки;
		ЗаполнитьРеквизитыОбъекта(Документ, МО, Контекст);
		ДобавитьПроверку(Результат, СтрокаКарты.Вид, СтрокаКарты.ПолноеИмя, СтрокаКарты.Синоним,
			СтрокаКарты.Процесс, СтрокаКарты.Критичность, "FR-03. Создание и автозаполнение", "Пройдено", "",
			ДлительностьСек(Начало));
	Исключение
		Класс = КлассифицироватьОшибку(ОписаниеОшибки());
		ДобавитьПроверку(Результат, СтрокаКарты.Вид, СтрокаКарты.ПолноеИмя, СтрокаКарты.Синоним,
			СтрокаКарты.Процесс, СтрокаКарты.Критичность, "FR-03. Создание и автозаполнение", Класс.Статус,
			ОписаниеОшибки(), ДлительностьСек(Начало));
		Возврат;
	КонецПопытки;

	Если Не Настройки.ПроводитьДокументы Тогда
		Возврат;
	КонецЕсли;

	Если МО.Проведение = Метаданные.СвойстваОбъектов.Проведение.Запретить Тогда
		ДобавитьПроверку(Результат, СтрокаКарты.Вид, СтрокаКарты.ПолноеИмя, СтрокаКарты.Синоним,
			СтрокаКарты.Процесс, СтрокаКарты.Критичность, "FR-05. Проведение документа", "Пропущено",
			"Проведение для документа запрещено", 0);
		Возврат;
	КонецЕсли;

	НачалоПроведения = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Статус    = "Пройдено";
	Сообщение = "";

	НачатьТранзакцию();
	Попытка

		Документ.Записать(РежимЗаписиДокумента.Проведение);

		ЕстьДвижения = Ложь;
		Для Каждого НаборДвижений Из Документ.Движения Цикл
			Если НаборДвижений.Количество() > 0 Тогда
				ЕстьДвижения = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;

		Если Не ЕстьДвижения И МО.Движения.Количество() > 0 Тогда
			Статус    = "Предупреждение";
			Сообщение = "Документ проведён, но движения не сформированы — вероятна неполнота тестовых данных";
		КонецЕсли;

	Исключение
		Класс     = КлассифицироватьОшибку(ОписаниеОшибки());
		Статус    = Класс.Статус;
		Сообщение = Класс.Причина + ": " + ОписаниеОшибки();
	КонецПопытки;

	Если ТранзакцияАктивна() Тогда
		ОтменитьТранзакцию();
	КонецЕсли;

	ДобавитьПроверку(Результат, СтрокаКарты.Вид, СтрокаКарты.ПолноеИмя, СтрокаКарты.Синоним,
		СтрокаКарты.Процесс, СтрокаКарты.Критичность, "FR-05. Проведение документа", Статус, Сообщение,
		ДлительностьСек(НачалоПроведения));

КонецПроцедуры

Процедура ПроверкаВиртуальныхТаблиц(Результат, СтрокаКарты)

	МО = Метаданные.НайтиПоПолномуИмени(СтрокаКарты.ПолноеИмя);
	Если МО = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если МО.ВидРегистра <> Метаданные.СвойстваОбъектов.ВидРегистраНакопления.Остатки Тогда
		Возврат;
	КонецЕсли;

	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();

	Попытка
		Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 * ИЗ " + СтрокаКарты.ПолноеИмя + ".Остатки КАК Т");
		Запрос.Выполнить();
		ДобавитьПроверку(Результат, СтрокаКарты.Вид, СтрокаКарты.ПолноеИмя, СтрокаКарты.Синоним,
			СтрокаКарты.Процесс, СтрокаКарты.Критичность, "Виртуальная таблица остатков", "Пройдено", "",
			ДлительностьСек(Начало));
	Исключение
		ДобавитьПроверку(Результат, СтрокаКарты.Вид, СтрокаКарты.ПолноеИмя, СтрокаКарты.Синоним,
			СтрокаКарты.Процесс, СтрокаКарты.Критичность, "Виртуальная таблица остатков", "Ошибка",
			ОписаниеОшибки(), ДлительностьСек(Начало));
	КонецПопытки;

КонецПроцедуры

Процедура ПроверкаКонстанты(Результат, СтрокаКарты)

	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();

	Попытка
		Константы[СтрокаКарты.Имя].Получить();
		ДобавитьПроверку(Результат, СтрокаКарты.Вид, СтрокаКарты.ПолноеИмя, СтрокаКарты.Синоним,
			СтрокаКарты.Процесс, СтрокаКарты.Критичность, "Чтение константы", "Пройдено", "",
			ДлительностьСек(Начало));
	Исключение
		ДобавитьПроверку(Результат, СтрокаКарты.Вид, СтрокаКарты.ПолноеИмя, СтрокаКарты.Синоним,
			СтрокаКарты.Процесс, СтрокаКарты.Критичность, "Чтение константы", "Ошибка",
			ОписаниеОшибки(), ДлительностьСек(Начало));
	КонецПопытки;

КонецПроцедуры

// Компоновка макета по схеме СКД ловит большинство ошибок отчёта до его выполнения.
Процедура ПроверкаСхемыОтчета(Результат, СтрокаКарты)

	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();

	Схема = Неопределено;
	Попытка
		Схема = Отчеты[СтрокаКарты.Имя].ПолучитьМакет("ОсновнаяСхемаКомпоновкиДанных");
	Исключение
		ДобавитьПроверку(Результат, СтрокаКарты.Вид, СтрокаКарты.ПолноеИмя, СтрокаКарты.Синоним,
			СтрокаКарты.Процесс, СтрокаКарты.Критичность, "Схема компоновки отчёта", "Пропущено",
			"Отчёт без основной схемы компоновки", ДлительностьСек(Начало));
		Возврат;
	КонецПопытки;

	Попытка

		Компоновщик = Новый КомпоновщикНастроекКомпоновкиДанных;
		Компоновщик.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(Схема));
		Компоновщик.ЗагрузитьНастройки(Схема.НастройкиПоУмолчанию);

		КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
		КомпоновщикМакета.Выполнить(Схема, Компоновщик.ПолучитьНастройки(), , ,
			Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));

		ДобавитьПроверку(Результат, СтрокаКарты.Вид, СтрокаКарты.ПолноеИмя, СтрокаКарты.Синоним,
			СтрокаКарты.Процесс, СтрокаКарты.Критичность, "Схема компоновки отчёта", "Пройдено", "",
			ДлительностьСек(Начало));

	Исключение
		Класс = КлассифицироватьОшибку(ОписаниеОшибки());
		ДобавитьПроверку(Результат, СтрокаКарты.Вид, СтрокаКарты.ПолноеИмя, СтрокаКарты.Синоним,
			СтрокаКарты.Процесс, СтрокаКарты.Критичность, "Схема компоновки отчёта", Класс.Статус,
			ОписаниеОшибки(), ДлительностьСек(Начало));
	КонецПопытки;

КонецПроцедуры

// FR-10. Статический анализ на уровне метаданных — часть общего конвейера,
// а не отдельный продукт. Правила из стандартов разработки 1С.
Процедура ПроверкиСтандартов(Результат)

	Количество = 0;

	Для Каждого Строка Из Результат.КартаОбъектов Цикл

		МО = Метаданные.НайтиПоПолномуИмени(Строка.ПолноеИмя);
		Если МО = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Если ПустаяСтрока(МО.Синоним) Тогда
			ДобавитьПроверку(Результат, Строка.Вид, Строка.ПолноеИмя, Строка.Синоним, Строка.Процесс,
				Строка.Критичность, "FR-10. Стандарт: заполнен синоним", "Замечание",
				"У объекта не заполнен синоним — в интерфейсе виден техническим именем", 0);
			Количество = Количество + 1;
		КонецЕсли;

		Если ПустаяСтрока(Строка.Подсистемы) И Строка.Вид <> "Константа" Тогда
			ДобавитьПроверку(Результат, Строка.Вид, Строка.ПолноеИмя, Строка.Синоним, Строка.Процесс,
				Строка.Критичность, "FR-10. Стандарт: объект включён в подсистему", "Замечание",
				"Объект не входит ни в одну подсистему — не попадёт в командный интерфейс", 0);
			Количество = Количество + 1;
		КонецЕсли;

		Количество = Количество + ПроверитьРеквизитыПоСтандартам(Результат, Строка, МО);

	КонецЦикла;

	Лог(Результат, "FR-10. Статический анализ метаданных: замечаний — " + Количество + ".");

КонецПроцедуры

Функция ПроверитьРеквизитыПоСтандартам(Результат, Строка, МО)

	Количество = 0;

	Попытка
		Реквизиты = МО.Реквизиты;
	Исключение
		Возврат 0;
	КонецПопытки;

	Для Каждого Реквизит Из Реквизиты Цикл

		Типы = Реквизит.Тип.Типы();

		Если Типы.Количество() > 5 Тогда
			ДобавитьПроверку(Результат, Строка.Вид, Строка.ПолноеИмя + "." + Реквизит.Имя, Строка.Синоним,
				Строка.Процесс, Строка.Критичность, "FR-10. Стандарт: составной тип реквизита", "Замечание",
				"Реквизит «" + Реквизит.Имя + "» имеет " + Типы.Количество()
					+ " типов — запросы к нему деградируют по производительности", 0);
			Количество = Количество + 1;
		КонецЕсли;

		Если Типы.Количество() = 1 И Типы[0] = Тип("Строка") Тогда
			Квалификаторы = Реквизит.Тип.КвалификаторыСтроки;
			Если Квалификаторы.Длина = 0 Тогда
				ДобавитьПроверку(Результат, Строка.Вид, Строка.ПолноеИмя + "." + Реквизит.Имя, Строка.Синоним,
					Строка.Процесс, Строка.Критичность, "FR-10. Стандарт: длина строки", "Замечание",
					"Реквизит «" + Реквизит.Имя + "» — строка неограниченной длины (хранится отдельной таблицей)", 0);
				Количество = Количество + 1;
			КонецЕсли;
		КонецЕсли;

	КонецЦикла;

	Возврат Количество;

КонецФункции

// FR-11. Тестирование ролей и прав доступа: сценарии должны выполняться
// не только под полными правами.
Процедура ПроверкаПравДоступа(Результат)

	Пользователи = Новый Массив;
	Попытка
		Пользователи = ПользователиИнформационнойБазы.ПолучитьПользователей();
	Исключение
		Лог(Результат, "FR-11. Список пользователей ИБ недоступен: " + ОписаниеОшибки());
		Возврат;
	КонецПопытки;

	Если Пользователи.Количество() = 0 Тогда
		Лог(Результат, "FR-11. В базе не заведено пользователей ИБ — проверка прав пропущена.");
		Возврат;
	КонецЕсли;

	Критичные = Новый Массив;
	Для Каждого Строка Из Результат.КартаОбъектов Цикл
		Если Строка.Критичность >= 3 И (Строка.Вид = "Документ" Или Строка.Вид = "Справочник") Тогда
			Критичные.Добавить(Строка);
		КонецЕсли;
	КонецЦикла;

	Найдено = 0;

	Для Каждого Строка Из Критичные Цикл

		МО = Метаданные.НайтиПоПолномуИмени(Строка.ПолноеИмя);
		Если МО = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		ДоступенКомуТо = Ложь;

		Для Каждого Пользователь Из Пользователи Цикл
			Попытка
				Если ПравоДоступа("Чтение", МО, Пользователь) Тогда
					ДоступенКомуТо = Истина;
					Прервать;
				КонецЕсли;
			Исключение
				ДоступенКомуТо = Истина; // проверка недоступна — не считаем это дефектом
				Прервать;
			КонецПопытки;
		КонецЦикла;

		Если Не ДоступенКомуТо Тогда
			ДобавитьПроверку(Результат, Строка.Вид, Строка.ПолноеИмя, Строка.Синоним, Строка.Процесс,
				Строка.Критичность, "FR-11. Права: объект доступен хотя бы одному пользователю", "Предупреждение",
				"Критичный объект недоступен на чтение ни одному пользователю ИБ", 0);
			Найдено = Найдено + 1;
		КонецЕсли;

	КонецЦикла;

	Лог(Результат, "FR-11. Проверка прав по " + Пользователи.Количество() + " пользователям ИБ на "
		+ Критичные.Количество() + " критичных объектах: замечаний — " + Найдено + ".");

КонецПроцедуры

// FR-26. Детекция необезличенных персональных и финансовых данных
// в контуре тестирования. Обработка не изменяет данные — только сообщает.
Процедура ПроверкаПерсональныхДанных(Результат)

	Маркеры = СтрРазделить("ФАМИЛИЯ,ИМЯОТЧЕСТВ,ФИО,ПАСПОРТ,СНИЛС,ИНН,ТЕЛЕФОН,МОБИЛЬН,EMAIL,ПОЧТА,АДРЕС,КАРТАОПЛАТ,СЧЕТБАНК", ",");
	Найдено = 0;

	Для Каждого Строка Из Результат.КартаОбъектов Цикл

		Если Строка.Вид <> "Справочник" И Строка.Вид <> "Документ" И Строка.Вид <> "РегистрСведений" Тогда
			Продолжить;
		КонецЕсли;

		МО = Метаданные.НайтиПоПолномуИмени(Строка.ПолноеИмя);
		Если МО = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Попытка
			Реквизиты = МО.Реквизиты;
		Исключение
			Продолжить;
		КонецПопытки;

		Подозрительные = Новый Массив;
		Для Каждого Реквизит Из Реквизиты Цикл
			ИмяВРег = ВРег(Реквизит.Имя);
			Для Каждого Маркер Из Маркеры Цикл
				Если СтрНайти(ИмяВРег, Маркер) > 0 Тогда
					Подозрительные.Добавить(Реквизит.Имя);
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;

		Если Подозрительные.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;

		Если ЕстьЗаполненныеЗначения(Строка.ПолноеИмя, Подозрительные) Тогда
			ДобавитьПроверку(Результат, Строка.Вид, Строка.ПолноеИмя, Строка.Синоним, Строка.Процесс,
				Строка.Критичность, "FR-26. Обезличивание тестовых данных", "Предупреждение",
				"В тестовом контуре заполнены персональные/финансовые реквизиты: "
					+ СтрСоединить(Подозрительные, ", "), 0);
			Найдено = Найдено + 1;
		КонецЕсли;

	КонецЦикла;

	Лог(Результат, "FR-26. Детекция необезличенных данных: объектов с находками — " + Найдено + ".");

КонецПроцедуры

Функция ЕстьЗаполненныеЗначения(ПолноеИмя, Реквизиты)

	Условия = Новый Массив;
	Для Каждого Реквизит Из Реквизиты Цикл
		Условия.Добавить("Т." + Реквизит + " <> """"");
	КонецЦикла;

	ТекстЗапроса = "ВЫБРАТЬ ПЕРВЫЕ 1 1 КАК Поле ИЗ " + ПолноеИмя + " КАК Т ГДЕ "
		+ СтрСоединить(Условия, " ИЛИ ");

	Попытка
		Запрос = Новый Запрос(ТекстЗапроса);
		Возврат Не Запрос.Выполнить().Пустой();
	Исключение
		Возврат Ложь; // реквизиты нестрокового типа — сравнение с "" невозможно
	КонецПопытки;

КонецФункции

// FR-27. Изоляция тестовых контуров: реальная отправка во внешние системы
// должна быть исключена. Обработка выявляет включённые каналы и журналирует их.
Процедура ПроверкаИзоляцииКонтура(Результат)

	Найдено = 0;

	Для Каждого ПланОбмена Из Метаданные.ПланыОбмена Цикл

		Попытка
			Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 * ИЗ ПланОбмена." + ПланОбмена.Имя
				+ " КАК Т ГДЕ НЕ Т.ЭтотУзел И НЕ Т.ПометкаУдаления");
			Если Не Запрос.Выполнить().Пустой() Тогда
				ДобавитьПроверку(Результат, "ПланОбмена", ПланОбмена.ПолноеИмя(),
					?(ПустаяСтрока(ПланОбмена.Синоним), ПланОбмена.Имя, ПланОбмена.Синоним),
					"Интеграции и обмены", 3, "FR-27. Изоляция контура", "Предупреждение",
					"В плане обмена есть активные узлы — перед прогоном отключите обмен, иначе данные уйдут во внешнюю систему", 0);
				Найдено = Найдено + 1;
			КонецЕсли;
		Исключение
			// план обмена недоступен для запроса — пропускаем
		КонецПопытки;

	КонецЦикла;

	Попытка
		Задания = РегламентныеЗадания.ПолучитьРегламентныеЗадания(Новый Структура("Использование", Истина));
		Маркеры = СтрРазделить("ОБМЕН,СИНХРОНИЗАЦ,ОТПРАВК,ЗАГРУЗК,ИНТЕГРАЦ,ЭДО,МАРКИРОВК,ОФД", ",");
		Для Каждого Задание Из Задания Цикл
			Наименование = ВРег(Задание.Наименование + " " + Задание.Метаданные.Имя);
			Для Каждого Маркер Из Маркеры Цикл
				Если СтрНайти(Наименование, Маркер) > 0 Тогда
					ДобавитьПроверку(Результат, "РегламентноеЗадание", Задание.Метаданные.ПолноеИмя(),
						Задание.Наименование, "Интеграции и обмены", 3, "FR-27. Изоляция контура",
						"Предупреждение", "Включено регламентное задание внешнего взаимодействия — отключите на время прогона", 0);
					Найдено = Найдено + 1;
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
	Исключение
		Лог(Результат, "FR-27. Регламентные задания недоступны: " + ОписаниеОшибки());
	КонецПопытки;

	Если Найдено = 0 Тогда
		ДобавитьПроверку(Результат, "Контур", "ИзоляцияКонтура", "Тестовый контур", "Интеграции и обмены", 3,
			"FR-27. Изоляция контура", "Пройдено", "Активных каналов внешнего взаимодействия не обнаружено", 0);
	КонецЕсли;

	Лог(Результат, "FR-27. Проверка изоляции контура: находок — " + Найдено + ".");

КонецПроцедуры

// FR-13. Расширения — полноценный объект тестирования наравне с конфигурацией.
Процедура УчестьРасширения(Результат)

	Список = Новый Массив;

	Попытка
		Расширения = РасширенияКонфигурации.Получить();
	Исключение
		Лог(Результат, "FR-13. Список расширений недоступен: " + ОписаниеОшибки());
		Возврат;
	КонецПопытки;

	Для Каждого Расширение Из Расширения Цикл
		Список.Добавить(Расширение.Имя + " (" + Расширение.Версия + ")");
		ДобавитьПроверку(Результат, "Расширение", Расширение.Имя, Расширение.Синоним, "Прочее", 2,
			"FR-13. Расширение подключено", ?(Расширение.Активно, "Пройдено", "Предупреждение"),
			?(Расширение.Активно, "", "Расширение не активно — его доработки не участвуют в прогоне"), 0);
	КонецЦикла;

	Результат.Вставить("Расширения", Список);
	Лог(Результат, "FR-13. Расширений в базе: " + Список.Количество()
		+ ?(Список.Количество() > 0, " (" + СтрСоединить(Список, "; ") + ")", "") + ".");

КонецПроцедуры

#КонецОбласти

#Область ГенерацияТестовыхДанных

Функция НовыйКонтекстДанных()

	Контекст = Новый Структура;
	Контекст.Вставить("КешСсылок", Новый Соответствие);
	Контекст.Вставить("Счетчик",   0);
	Возврат Контекст;

КонецФункции

// FR-03. Подбор корректных значений — даты, суммы, ссылки на существующие
// объекты — для заполнения реквизитов при автопрогоне.
Процедура ЗаполнитьРеквизитыОбъекта(Объект, МО, Контекст) Экспорт

	Если МО = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Контекст.Счетчик = Контекст.Счетчик + 1;

	Попытка
		Реквизиты = МО.Реквизиты;
	Исключение
		Возврат;
	КонецПопытки;

	Для Каждого Реквизит Из Реквизиты Цикл
		Попытка
			Если Не ЗначениеЗаполнено(Объект[Реквизит.Имя]) Тогда
				Объект[Реквизит.Имя] = ЗначениеПоОписаниюТипов(Реквизит.Тип, Реквизит.Имя, Контекст);
			КонецЕсли;
		Исключение
			// реквизит только для чтения либо тип не поддерживает присваивание
		КонецПопытки;
	КонецЦикла;

	// Наименование / Код — стандартные реквизиты справочных объектов.
	Попытка
		Если Объект.Метаданные().ДлинаНаименования > 0 И ПустаяСтрока(Объект.Наименование) Тогда
			Объект.Наименование = Лев("АвтоТест " + Формат(Контекст.Счетчик, "ЧЦ=6; ЧВН="),
				Объект.Метаданные().ДлинаНаименования);
		КонецЕсли;
	Исключение
		// у объекта нет наименования
	КонецПопытки;

	Попытка
		ТабличныеЧасти = МО.ТабличныеЧасти;
	Исключение
		Возврат;
	КонецПопытки;

	Для Каждого ТЧ Из ТабличныеЧасти Цикл
		Попытка
			Таблица = Объект[ТЧ.Имя];
			Если Таблица.Количество() > 0 Тогда
				Продолжить;
			КонецЕсли;
			СтрокаТЧ = Таблица.Добавить();
			Для Каждого Реквизит Из ТЧ.Реквизиты Цикл
				Попытка
					СтрокаТЧ[Реквизит.Имя] = ЗначениеПоОписаниюТипов(Реквизит.Тип, Реквизит.Имя, Контекст);
				Исключение
					// реквизит строки не заполняется
				КонецПопытки;
			КонецЦикла;
		Исключение
			// табличная часть недоступна
		КонецПопытки;
	КонецЦикла;

КонецПроцедуры

Функция ЗначениеПоОписаниюТипов(ОписаниеТиповРеквизита, ИмяРеквизита, Контекст)

	Типы = ОписаниеТиповРеквизита.Типы();
	Если Типы.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	ТипЗначения = Типы[0];

	Если ТипЗначения = Тип("Строка") Тогда
		Длина = ОписаниеТиповРеквизита.КвалификаторыСтроки.Длина;
		Текст = "АТ-" + ИмяРеквизита;
		Возврат ?(Длина > 0, Лев(Текст, Длина), Текст);

	ИначеЕсли ТипЗначения = Тип("Число") Тогда
		Возврат ЧисловоеЗначение(ОписаниеТиповРеквизита, ИмяРеквизита);

	ИначеЕсли ТипЗначения = Тип("Дата") Тогда
		Возврат ТекущаяДата();

	ИначеЕсли ТипЗначения = Тип("Булево") Тогда
		Возврат Ложь;

	ИначеЕсли ТипЗначения = Тип("УникальныйИдентификатор") Тогда
		Возврат Новый УникальныйИдентификатор;

	КонецЕсли;

	Возврат ПодобратьСуществующуюСсылку(ТипЗначения, Контекст);

КонецФункции

Функция ЧисловоеЗначение(ОписаниеТиповРеквизита, ИмяРеквизита)

	Квалификаторы = ОписаниеТиповРеквизита.КвалификаторыЧисла;
	ИмяВРег = ВРег(ИмяРеквизита);

	Если СтрНайти(ИмяВРег, "КОЛИЧЕСТВО") > 0 Или СтрНайти(ИмяВРег, "КОЭФФИЦИЕНТ") > 0 Тогда
		Значение = 1;
	ИначеЕсли СтрНайти(ИмяВРег, "СУММА") > 0 Или СтрНайти(ИмяВРег, "ЦЕНА") > 0 Тогда
		Значение = 100;
	ИначеЕсли СтрНайти(ИмяВРег, "ПРОЦЕНТ") > 0 Или СтрНайти(ИмяВРег, "СТАВКА") > 0 Тогда
		Значение = 0;
	Иначе
		Значение = 1;
	КонецЕсли;

	Если Квалификаторы.Разрядность > 0 Тогда
		Предел = Цел(Pow(10, Квалификаторы.Разрядность - Квалификаторы.РазрядностьДробнойЧасти)) - 1;
		Если Значение > Предел Тогда
			Значение = Предел;
		КонецЕсли;
	КонецЕсли;

	Возврат Значение;

КонецФункции

// Подбор ссылки на реально существующий объект базы — ключевое отличие
// от «пустых» тестовых данных: документ должен провестись на живых данных.
Функция ПодобратьСуществующуюСсылку(ТипЗначения, Контекст)

	Кеш = Контекст.КешСсылок;
	Если Кеш[ТипЗначения] <> Неопределено Тогда
		Возврат Кеш[ТипЗначения];
	КонецЕсли;

	Значение = Неопределено;
	МО = Метаданные.НайтиПоТипу(ТипЗначения);

	Если МО <> Неопределено Тогда

		ПолноеИмя = МО.ПолноеИмя();

		Если СтрНачинаетсяС(ПолноеИмя, "Перечисление") Тогда
			Попытка
				Значение = Перечисления[МО.Имя][0];
			Исключение
				Значение = Неопределено;
			КонецПопытки;
		ИначеЕсли СтрНачинаетсяС(ПолноеИмя, "Справочник")
			Или СтрНачинаетсяС(ПолноеИмя, "ПланВидовХарактеристик")
			Или СтрНачинаетсяС(ПолноеИмя, "ПланСчетов")
			Или СтрНачинаетсяС(ПолноеИмя, "Документ") Тогда

			Попытка
				ТекстЗапроса = "ВЫБРАТЬ ПЕРВЫЕ 1 Т.Ссылка ИЗ " + ПолноеИмя + " КАК Т ГДЕ НЕ Т.ПометкаУдаления";
				Если СтрНачинаетсяС(ПолноеИмя, "Справочник") Тогда
					ТекстЗапроса = ТекстЗапроса + " И НЕ Т.ЭтоГруппа";
				КонецЕсли;
				Запрос = Новый Запрос(ТекстЗапроса);
				Выборка = Запрос.Выполнить().Выбрать();
				Если Выборка.Следующий() Тогда
					Значение = Выборка.Ссылка;
				КонецЕсли;
			Исключение
				Попытка
					Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Т.Ссылка ИЗ " + ПолноеИмя + " КАК Т");
					Выборка = Запрос.Выполнить().Выбрать();
					Если Выборка.Следующий() Тогда
						Значение = Выборка.Ссылка;
					КонецЕсли;
				Исключение
					Значение = Неопределено;
				КонецПопытки;
			КонецПопытки;

		КонецЕсли;

	КонецЕсли;

	Кеш.Вставить(ТипЗначения, Значение);

	Возврат Значение;

КонецФункции

#КонецОбласти

#Область ВлияниеИзменений

// FR-08 / FR-12. Снимок структуры конфигурации — база для сравнения «до / после».
Функция СохранитьСнимок(ПутьФайла, Карта) Экспорт

	Данные = ДанныеСнимка(Карта);

	ЗаписатьJSONВФайл(ПутьФайла, Данные);

	Возврат Данные.Объекты.Количество();

КонецФункции

Функция ДанныеСнимка(Карта)

	Данные = Новый Структура;
	Данные.Вставить("Конфигурация", Метаданные.Имя);
	Данные.Вставить("Версия",       Метаданные.Версия);
	Данные.Вставить("Дата",         Формат(ТекущаяДата(), "ДФ=yyyy-MM-ddTHH:mm:ss"));

	Объекты = Новый Массив;
	Для Каждого Строка Из Карта Цикл
		Элемент = Новый Структура;
		Элемент.Вставить("ПолноеИмя", Строка.ПолноеИмя);
		Элемент.Вставить("Хеш",       Строка.Хеш);
		Элемент.Вставить("Процесс",   Строка.Процесс);
		Объекты.Добавить(Элемент);
	КонецЦикла;
	Данные.Вставить("Объекты", Объекты);

	Возврат Данные;

КонецФункции

// FR-12. По diff'у структуры определяем, какие тесты нужно перезапустить.
Функция АнализВлиянияИзменений(ПутьСнимка, Карта) Экспорт

	Влияние = Новый Структура;
	Влияние.Вставить("Изменено",  0);
	Влияние.Вставить("Добавлено", 0);
	Влияние.Вставить("Удалено",   0);
	Влияние.Вставить("Затронутые", Новый Соответствие);
	Влияние.Вставить("Детали",     Новый Массив);

	Снимок = ПрочитатьJSONИзФайла(ПутьСнимка);
	Если Снимок = Неопределено Тогда
		// Снимка нет — прогоняем всё.
		Для Каждого Строка Из Карта Цикл
			Влияние.Затронутые.Вставить(Строка.ПолноеИмя, Истина);
		КонецЦикла;
		Возврат Влияние;
	КонецЕсли;

	Старые = Новый Соответствие;
	Для Каждого Элемент Из Снимок["Объекты"] Цикл
		Старые.Вставить(Элемент["ПолноеИмя"], Элемент["Хеш"]);
	КонецЦикла;

	ИзмененныеПроцессы = Новый Соответствие;

	Для Каждого Строка Из Карта Цикл

		СтарыйХеш = Старые[Строка.ПолноеИмя];

		Если СтарыйХеш = Неопределено Тогда
			Влияние.Добавлено = Влияние.Добавлено + 1;
			Влияние.Затронутые.Вставить(Строка.ПолноеИмя, Истина);
			ИзмененныеПроцессы.Вставить(Строка.Процесс, Истина);
			Влияние.Детали.Добавить("Добавлен: " + Строка.ПолноеИмя);
		ИначеЕсли СтарыйХеш <> Строка.Хеш Тогда
			Влияние.Изменено = Влияние.Изменено + 1;
			Влияние.Затронутые.Вставить(Строка.ПолноеИмя, Истина);
			ИзмененныеПроцессы.Вставить(Строка.Процесс, Истина);
			Влияние.Детали.Добавить("Изменён: " + Строка.ПолноеИмя);
		КонецЕсли;

		Старые.Удалить(Строка.ПолноеИмя);

	КонецЦикла;

	Для Каждого КлючЗначение Из Старые Цикл
		Влияние.Удалено = Влияние.Удалено + 1;
		Влияние.Детали.Добавить("Удалён: " + КлючЗначение.Ключ);
	КонецЦикла;

	// Зависимости: объекты того же бизнес-процесса тоже под риском.
	Для Каждого Строка Из Карта Цикл
		Если ИзмененныеПроцессы[Строка.Процесс] <> Неопределено Тогда
			Влияние.Затронутые.Вставить(Строка.ПолноеИмя, Истина);
		КонецЕсли;
	КонецЦикла;

	Возврат Влияние;

КонецФункции

#КонецОбласти

#Область Покрытие

// FR-18. Процент покрытия по подсистемам — визуальная карта «слепых зон».
Процедура РассчитатьПокрытие(Результат)

	Покрытие = Новый ТаблицаЗначений;
	Покрытие.Колонки.Добавить("Подсистема",     Новый ОписаниеТипов("Строка"));
	Покрытие.Колонки.Добавить("Всего",          Новый ОписаниеТипов("Число"));
	Покрытие.Колонки.Добавить("Проверено",      Новый ОписаниеТипов("Число"));
	Покрытие.Колонки.Добавить("Процент",        Новый ОписаниеТипов("Число"));
	Покрытие.Колонки.Добавить("Ошибок",         Новый ОписаниеТипов("Число"));
	Покрытие.Колонки.Добавить("Предупреждений", Новый ОписаниеТипов("Число"));

	ОшибкиПоОбъектам = Новый Соответствие;
	Для Каждого Проверка Из Результат.Проверки Цикл
		Если Проверка.Статус <> "Ошибка" И Проверка.Статус <> "Предупреждение" Тогда
			Продолжить;
		КонецЕсли;
		Счет = ОшибкиПоОбъектам[Проверка.ПолноеИмя];
		Если Счет = Неопределено Тогда
			Счет = Новый Структура("Ошибок, Предупреждений", 0, 0);
			ОшибкиПоОбъектам.Вставить(Проверка.ПолноеИмя, Счет);
		КонецЕсли;
		Если Проверка.Статус = "Ошибка" Тогда
			Счет.Ошибок = Счет.Ошибок + 1;
		Иначе
			Счет.Предупреждений = Счет.Предупреждений + 1;
		КонецЕсли;
	КонецЦикла;

	Для Каждого Строка Из Результат.КартаОбъектов Цикл

		Подсистемы = ?(ПустаяСтрока(Строка.Подсистемы), Новый Массив, СтрРазделить(Строка.Подсистемы, ", "));
		Если Подсистемы.Количество() = 0 Тогда
			Подсистемы.Добавить("(вне подсистем)");
		КонецЕсли;

		Для Каждого ИмяПодсистемы Из Подсистемы Цикл

			// Учитываем только корневой уровень — так карта читается руководителем.
			Корень = СтрРазделить(ИмяПодсистемы, "/")[0];
			Корень = СокрЛП(Корень);

			СтрокаПокрытия = Покрытие.Найти(Корень, "Подсистема");
			Если СтрокаПокрытия = Неопределено Тогда
				СтрокаПокрытия = Покрытие.Добавить();
				СтрокаПокрытия.Подсистема = Корень;
			КонецЕсли;

			СтрокаПокрытия.Всего = СтрокаПокрытия.Всего + 1;
			Если Строка.Проверялся Тогда
				СтрокаПокрытия.Проверено = СтрокаПокрытия.Проверено + 1;
			КонецЕсли;

			Счет = ОшибкиПоОбъектам[Строка.ПолноеИмя];
			Если Счет <> Неопределено Тогда
				СтрокаПокрытия.Ошибок         = СтрокаПокрытия.Ошибок + Счет.Ошибок;
				СтрокаПокрытия.Предупреждений = СтрокаПокрытия.Предупреждений + Счет.Предупреждений;
			КонецЕсли;

		КонецЦикла;

	КонецЦикла;

	Для Каждого СтрокаПокрытия Из Покрытие Цикл
		Если СтрокаПокрытия.Всего > 0 Тогда
			СтрокаПокрытия.Процент = Окр(СтрокаПокрытия.Проверено * 100 / СтрокаПокрытия.Всего, 0);
		КонецЕсли;
	КонецЦикла;

	Покрытие.Сортировать("Процент Возр, Подсистема Возр");
	Результат.Покрытие = Покрытие;

КонецПроцедуры

// FR-20. Риск-карта перед релизом: ранжирование по вероятному влиянию
// на критичные процессы.
Процедура РассчитатьРискКарту(Результат)

	Риски = Новый ТаблицаЗначений;
	Риски.Колонки.Добавить("Процесс",        Новый ОписаниеТипов("Строка"));
	Риски.Колонки.Добавить("Критичность",    Новый ОписаниеТипов("Число"));
	Риски.Колонки.Добавить("Проверок",       Новый ОписаниеТипов("Число"));
	Риски.Колонки.Добавить("Ошибок",         Новый ОписаниеТипов("Число"));
	Риски.Колонки.Добавить("Предупреждений", Новый ОписаниеТипов("Число"));
	Риски.Колонки.Добавить("Ранг",           Новый ОписаниеТипов("Число"));
	Риски.Колонки.Добавить("Вердикт",        Новый ОписаниеТипов("Строка"));
	Риски.Колонки.Добавить("Главное",        Новый ОписаниеТипов("Строка"));

	Для Каждого Проверка Из Результат.Проверки Цикл

		СтрокаРиска = Риски.Найти(Проверка.Процесс, "Процесс");
		Если СтрокаРиска = Неопределено Тогда
			СтрокаРиска = Риски.Добавить();
			СтрокаРиска.Процесс     = Проверка.Процесс;
			СтрокаРиска.Критичность = Проверка.Критичность;
		КонецЕсли;

		Если Проверка.Критичность > СтрокаРиска.Критичность Тогда
			СтрокаРиска.Критичность = Проверка.Критичность;
		КонецЕсли;
		СтрокаРиска.Проверок    = СтрокаРиска.Проверок + 1;

		Если Проверка.Статус = "Ошибка" Тогда
			СтрокаРиска.Ошибок = СтрокаРиска.Ошибок + 1;
			Если ПустаяСтрока(СтрокаРиска.Главное) Тогда
				СтрокаРиска.Главное = Проверка.Синоним + " — " + Лев(Проверка.Сообщение, 160);
			КонецЕсли;
		ИначеЕсли Проверка.Статус = "Предупреждение" Тогда
			СтрокаРиска.Предупреждений = СтрокаРиска.Предупреждений + 1;
		КонецЕсли;

	КонецЦикла;

	Для Каждого СтрокаРиска Из Риски Цикл

		СтрокаРиска.Ранг = СтрокаРиска.Критичность * (СтрокаРиска.Ошибок * 3 + СтрокаРиска.Предупреждений);

		Если СтрокаРиска.Ошибок > 0 И СтрокаРиска.Критичность >= 3 Тогда
			СтрокаРиска.Вердикт = "Не выпускать без разбора";
		ИначеЕсли СтрокаРиска.Ошибок > 0 Тогда
			СтрокаРиска.Вердикт = "Требует внимания";
		ИначеЕсли СтрокаРиска.Предупреждений > 0 Тогда
			СтрокаРиска.Вердикт = "Приемлемо, есть замечания";
		Иначе
			СтрокаРиска.Вердикт = "Проверено, рисков не найдено";
		КонецЕсли;

	КонецЦикла;

	Риски.Сортировать("Ранг Убыв, Критичность Убыв");
	Результат.РискКарта = Риски;

КонецПроцедуры

Процедура РассчитатьМетрики(Результат)

	Метрики = Новый Структура;
	Метрики.Вставить("Проверок",        Результат.Проверки.Количество());
	Метрики.Вставить("Пройдено",        0);
	Метрики.Вставить("Ошибок",          0);
	Метрики.Вставить("Предупреждений",  0);
	Метрики.Вставить("Замечаний",       0);
	Метрики.Вставить("Пропущено",       0);
	Метрики.Вставить("ОбъектовВсего",   Результат.КартаОбъектов.Количество());
	Метрики.Вставить("ОбъектовПроверено", 0);
	Метрики.Вставить("ПроцентПокрытия", 0);
	Метрики.Вставить("ДлительностьСек", Результат.ДатаОкончания - Результат.ДатаНачала);

	Для Каждого Проверка Из Результат.Проверки Цикл
		Если Проверка.Статус = "Пройдено" Тогда
			Метрики.Пройдено = Метрики.Пройдено + 1;
		ИначеЕсли Проверка.Статус = "Ошибка" Тогда
			Метрики.Ошибок = Метрики.Ошибок + 1;
		ИначеЕсли Проверка.Статус = "Предупреждение" Тогда
			Метрики.Предупреждений = Метрики.Предупреждений + 1;
		ИначеЕсли Проверка.Статус = "Замечание" Тогда
			Метрики.Замечаний = Метрики.Замечаний + 1;
		Иначе
			Метрики.Пропущено = Метрики.Пропущено + 1;
		КонецЕсли;
	КонецЦикла;

	Для Каждого Строка Из Результат.КартаОбъектов Цикл
		Если Строка.Проверялся Тогда
			Метрики.ОбъектовПроверено = Метрики.ОбъектовПроверено + 1;
		КонецЕсли;
	КонецЦикла;

	Если Метрики.ОбъектовВсего > 0 Тогда
		Метрики.ПроцентПокрытия = Окр(Метрики.ОбъектовПроверено * 100 / Метрики.ОбъектовВсего, 0);
	КонецЕсли;

	Результат.Метрики = Метрики;

КонецПроцедуры

#КонецОбласти

#Область Отчеты

// FR-18. Табличный отчёт: покрытие, риск-карта, детализация дефектов.
Функция ОтчетТабличныйДокумент(Результат) Экспорт

	ТабДок = Новый ТабличныйДокумент;
	ТабДок.ИмяПараметровПечати = "АвтоТест1С";
	НомерСтроки = 1;

	НомерСтроки = ВывестиЗаголовок(ТабДок, НомерСтроки, "АвтоТест1С — результат автоматического прогона");
	НомерСтроки = ВывестиСтрокуТекста(ТабДок, НомерСтроки, "Конфигурация: " + Метаданные.Синоним + " " + Метаданные.Версия);
	НомерСтроки = ВывестиСтрокуТекста(ТабДок, НомерСтроки, "Прогон: " + Формат(Результат.ДатаНачала, "ДЛФ=DT")
		+ " — " + Формат(Результат.ДатаОкончания, "ДЛФ=DT"));
	НомерСтроки = ВывестиСтрокуТекста(ТабДок, НомерСтроки, "Объектов обнаружено: " + Результат.Метрики.ОбъектовВсего
		+ ", проверено: " + Результат.Метрики.ОбъектовПроверено
		+ " (" + Результат.Метрики.ПроцентПокрытия + "%)");
	НомерСтроки = ВывестиСтрокуТекста(ТабДок, НомерСтроки, "Проверок: " + Результат.Метрики.Проверок
		+ " · пройдено " + Результат.Метрики.Пройдено
		+ " · ошибок " + Результат.Метрики.Ошибок
		+ " · предупреждений " + Результат.Метрики.Предупреждений
		+ " · замечаний " + Результат.Метрики.Замечаний);
	НомерСтроки = НомерСтроки + 1;

	// Риск-карта (FR-20)
	НомерСтроки = ВывестиЗаголовок(ТабДок, НомерСтроки, "Риск-карта перед релизом");
	Колонки = Новый Массив;
	Колонки.Добавить("Бизнес-процесс");
	Колонки.Добавить("Критичность");
	Колонки.Добавить("Проверок");
	Колонки.Добавить("Ошибок");
	Колонки.Добавить("Предупр.");
	Колонки.Добавить("Вердикт");
	Колонки.Добавить("Главное");
	НомерСтроки = ВывестиШапку(ТабДок, НомерСтроки, Колонки);

	Для Каждого СтрокаРиска Из Результат.РискКарта Цикл
		Значения = Новый Массив;
		Значения.Добавить(СтрокаРиска.Процесс);
		Значения.Добавить(ТекстКритичности(СтрокаРиска.Критичность));
		Значения.Добавить(Строка(СтрокаРиска.Проверок));
		Значения.Добавить(Строка(СтрокаРиска.Ошибок));
		Значения.Добавить(Строка(СтрокаРиска.Предупреждений));
		Значения.Добавить(СтрокаРиска.Вердикт);
		Значения.Добавить(СтрокаРиска.Главное);
		НомерСтроки = ВывестиСтрокуТаблицы(ТабДок, НомерСтроки, Значения, ЦветСтатуса(СтрокаРиска.Ошибок, СтрокаРиска.Предупреждений));
	КонецЦикла;
	НомерСтроки = НомерСтроки + 1;

	// Покрытие по подсистемам (FR-18)
	НомерСтроки = ВывестиЗаголовок(ТабДок, НомерСтроки, "Покрытие по подсистемам");
	Колонки = Новый Массив;
	Колонки.Добавить("Подсистема");
	Колонки.Добавить("Объектов");
	Колонки.Добавить("Проверено");
	Колонки.Добавить("Покрытие, %");
	Колонки.Добавить("Ошибок");
	Колонки.Добавить("Предупр.");
	НомерСтроки = ВывестиШапку(ТабДок, НомерСтроки, Колонки);

	Для Каждого СтрокаПокрытия Из Результат.Покрытие Цикл
		Значения = Новый Массив;
		Значения.Добавить(СтрокаПокрытия.Подсистема);
		Значения.Добавить(Строка(СтрокаПокрытия.Всего));
		Значения.Добавить(Строка(СтрокаПокрытия.Проверено));
		Значения.Добавить(Строка(СтрокаПокрытия.Процент));
		Значения.Добавить(Строка(СтрокаПокрытия.Ошибок));
		Значения.Добавить(Строка(СтрокаПокрытия.Предупреждений));
		НомерСтроки = ВывестиСтрокуТаблицы(ТабДок, НомерСтроки, Значения, ЦветСтатуса(СтрокаПокрытия.Ошибок, СтрокаПокрытия.Предупреждений));
	КонецЦикла;
	НомерСтроки = НомерСтроки + 1;

	// Детализация дефектов
	НомерСтроки = ВывестиЗаголовок(ТабДок, НомерСтроки, "Найденные дефекты");
	Колонки = Новый Массив;
	Колонки.Добавить("Процесс");
	Колонки.Добавить("Объект");
	Колонки.Добавить("Проверка");
	Колонки.Добавить("Статус");
	Колонки.Добавить("Сообщение");
	НомерСтроки = ВывестиШапку(ТабДок, НомерСтроки, Колонки);

	Дефекты = Результат.Проверки.Скопировать(Новый Структура("Статус", "Ошибка"));
	Дефекты.Сортировать("Критичность Убыв, Процесс Возр");
	Для Каждого Дефект Из Дефекты Цикл
		Значения = Новый Массив;
		Значения.Добавить(Дефект.Процесс);
		Значения.Добавить(Дефект.Синоним + " (" + Дефект.ПолноеИмя + ")");
		Значения.Добавить(Дефект.Проверка);
		Значения.Добавить(Дефект.Статус);
		Значения.Добавить(Лев(Дефект.Сообщение, 400));
		НомерСтроки = ВывестиСтрокуТаблицы(ТабДок, НомерСтроки, Значения, Новый Цвет(255, 235, 235));
	КонецЦикла;

	Если Дефекты.Количество() = 0 Тогда
		НомерСтроки = ВывестиСтрокуТекста(ТабДок, НомерСтроки, "Ошибок не найдено.");
	КонецЕсли;

	Возврат ТабДок;

КонецФункции

Функция ВывестиЗаголовок(ТабДок, НомерСтроки, Текст)

	Область = ТабДок.Область(НомерСтроки, 1, НомерСтроки, 7);
	Область.Объединить();
	Область.Текст = Текст;
	Область.Шрифт = Новый Шрифт(, 12, Истина);
	Возврат НомерСтроки + 1;

КонецФункции

Функция ВывестиСтрокуТекста(ТабДок, НомерСтроки, Текст)

	Область = ТабДок.Область(НомерСтроки, 1, НомерСтроки, 7);
	Область.Объединить();
	Область.Текст = Текст;
	Возврат НомерСтроки + 1;

КонецФункции

Функция ВывестиШапку(ТабДок, НомерСтроки, Колонки)

	Для Индекс = 0 По Колонки.ВГраница() Цикл
		Область = ТабДок.Область(НомерСтроки, Индекс + 1, НомерСтроки, Индекс + 1);
		Область.Текст = Колонки[Индекс];
		Область.Шрифт = Новый Шрифт(, , Истина);
		Область.ЦветФона = Новый Цвет(235, 235, 235);
		Область.Обвести(Истина, Истина, Истина, Истина);
	КонецЦикла;

	Возврат НомерСтроки + 1;

КонецФункции

Функция ВывестиСтрокуТаблицы(ТабДок, НомерСтроки, Значения, ЦветФона)

	Для Индекс = 0 По Значения.ВГраница() Цикл
		Область = ТабДок.Область(НомерСтроки, Индекс + 1, НомерСтроки, Индекс + 1);
		Область.Текст = Значения[Индекс];
		Область.ЦветФона = ЦветФона;
		Область.Обвести(Истина, Истина, Истина, Истина);
	КонецЦикла;

	Возврат НомерСтроки + 1;

КонецФункции

Функция ЦветСтатуса(Ошибок, Предупреждений)

	Если Ошибок > 0 Тогда
		Возврат Новый Цвет(255, 224, 224);
	ИначеЕсли Предупреждений > 0 Тогда
		Возврат Новый Цвет(255, 246, 214);
	КонецЕсли;

	Возврат Новый Цвет(230, 247, 230);

КонецФункции

Функция ТекстКритичности(Критичность)

	Если Критичность >= 3 Тогда
		Возврат "высокая";
	ИначеЕсли Критичность = 2 Тогда
		Возврат "средняя";
	КонецЕсли;

	Возврат "низкая";

КонецФункции

// FR-19. Отчёт для нетехнического заказчика — на языке бизнес-процессов.
Функция ОтчетHTMLДляБизнеса(Результат) Экспорт

	Т = Новый Массив;
	Т.Добавить("<html><head><meta charset=""utf-8""><title>АвтоТест1С — отчёт о готовности</title>");
	Т.Добавить("<style>body{font-family:Segoe UI,Arial,sans-serif;margin:32px;color:#1a1a1a}"
		+ "h1{font-size:22px}h2{font-size:17px;margin-top:28px}"
		+ "table{border-collapse:collapse;width:100%;margin-top:10px}"
		+ "th,td{border:1px solid #ddd;padding:7px 9px;text-align:left;font-size:14px}"
		+ "th{background:#f2f2f2}.err{background:#ffe3e3}.warn{background:#fff6d6}.ok{background:#e7f6e7}"
		+ ".sum{font-size:15px;line-height:1.7}</style></head><body>");

	Т.Добавить("<h1>Что проверено и что рискованно</h1>");
	Т.Добавить("<div class=""sum"">Конфигурация: <b>" + ЭкранироватьHTML(Метаданные.Синоним) + "</b>, версия "
		+ ЭкранироватьHTML(Метаданные.Версия) + "<br>Прогон: " + Формат(Результат.ДатаНачала, "ДЛФ=DT")
		+ " — " + Формат(Результат.ДатаОкончания, "ДЛФ=DT") + "<br>Проверено объектов: <b>"
		+ Результат.Метрики.ОбъектовПроверено + "</b> из " + Результат.Метрики.ОбъектовВсего
		+ " (" + Результат.Метрики.ПроцентПокрытия + "%), выполнено проверок: <b>"
		+ Результат.Метрики.Проверок + "</b></div>");

	Т.Добавить("<h2>Риск-карта: на что смотреть перед релизом</h2>");
	Т.Добавить("<table><tr><th>Бизнес-процесс</th><th>Важность</th><th>Проверок</th><th>Ошибок</th>"
		+ "<th>Предупреждений</th><th>Вывод</th><th>Главное</th></tr>");

	Для Каждого СтрокаРиска Из Результат.РискКарта Цикл
		Класс = ?(СтрокаРиска.Ошибок > 0, "err", ?(СтрокаРиска.Предупреждений > 0, "warn", "ok"));
		Т.Добавить("<tr class=""" + Класс + """><td>" + ЭкранироватьHTML(СтрокаРиска.Процесс) + "</td><td>"
			+ ТекстКритичности(СтрокаРиска.Критичность) + "</td><td>" + СтрокаРиска.Проверок + "</td><td>"
			+ СтрокаРиска.Ошибок + "</td><td>" + СтрокаРиска.Предупреждений + "</td><td>"
			+ ЭкранироватьHTML(СтрокаРиска.Вердикт) + "</td><td>" + ЭкранироватьHTML(СтрокаРиска.Главное) + "</td></tr>");
	КонецЦикла;
	Т.Добавить("</table>");

	Т.Добавить("<h2>Покрытие по подсистемам</h2>");
	Т.Добавить("<table><tr><th>Подсистема</th><th>Объектов</th><th>Проверено</th><th>Покрытие</th>"
		+ "<th>Ошибок</th></tr>");
	Для Каждого СтрокаПокрытия Из Результат.Покрытие Цикл
		Класс = ?(СтрокаПокрытия.Ошибок > 0, "err", ?(СтрокаПокрытия.Процент < 100, "warn", "ok"));
		Т.Добавить("<tr class=""" + Класс + """><td>" + ЭкранироватьHTML(СтрокаПокрытия.Подсистема) + "</td><td>"
			+ СтрокаПокрытия.Всего + "</td><td>" + СтрокаПокрытия.Проверено + "</td><td>"
			+ СтрокаПокрытия.Процент + "%</td><td>" + СтрокаПокрытия.Ошибок + "</td></tr>");
	КонецЦикла;
	Т.Добавить("</table>");

	Т.Добавить("</body></html>");

	Возврат СтрСоединить(Т, Символы.ПС);

КонецФункции

// Машиночитаемый результат для CI/CD и трекеров задач (FR-21, FR-22).
Функция ОтчетJSON(Результат) Экспорт

	Данные = Новый Структура;
	Данные.Вставить("конфигурация", Метаданные.Имя);
	Данные.Вставить("версия",       Метаданные.Версия);
	Данные.Вставить("начало",       Формат(Результат.ДатаНачала, "ДФ=yyyy-MM-ddTHH:mm:ss"));
	Данные.Вставить("окончание",    Формат(Результат.ДатаОкончания, "ДФ=yyyy-MM-ddTHH:mm:ss"));

	Метрики = Новый Структура;
	Для Каждого КлючЗначение Из Результат.Метрики Цикл
		Метрики.Вставить(КлючЗначение.Ключ, КлючЗначение.Значение);
	КонецЦикла;
	Данные.Вставить("метрики", Метрики);

	Данные.Вставить("проверки",  ТаблицаВМассив(Результат.Проверки));
	Данные.Вставить("покрытие",  ТаблицаВМассив(Результат.Покрытие));
	Данные.Вставить("рискКарта", ТаблицаВМассив(Результат.РискКарта));

	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку(Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Авто, Символы.Таб));
	ЗаписатьJSON(Запись, Данные);

	Возврат Запись.Закрыть();

КонецФункции

Функция ТаблицаВМассив(Таблица)

	Массив = Новый Массив;

	Для Каждого Строка Из Таблица Цикл
		Элемент = Новый Структура;
		Для Каждого Колонка Из Таблица.Колонки Цикл
			Значение = Строка[Колонка.Имя];
			Если ТипЗнч(Значение) = Тип("Дата") Тогда
				Значение = Формат(Значение, "ДФ=yyyy-MM-ddTHH:mm:ss");
			КонецЕсли;
			Элемент.Вставить(Колонка.Имя, Значение);
		КонецЦикла;
		Массив.Добавить(Элемент);
	КонецЦикла;

	Возврат Массив;

КонецФункции

// Файлы для записи на клиенте. Обработка считает на сервере, а сохраняет клиент:
// в файловой базе сервер и клиент — одна машина, но в клиент-серверной каталог
// вроде C:\1C-auto существует у пользователя, а не на сервере приложений.
//
// Возвращаемое значение:
//  Массив из Структура - ИмяФайла, Текст.
Функция ТекстыОтчетов(Результат) Экспорт

	Файлы = Новый Массив;
	Метка = Формат(Результат.ДатаНачала, "ДФ=yyyyMMdd-HHmmss");
	Префикс = "АвтоТест1С-" + Метка;

	Файлы.Добавить(ОписаниеТекстовогоФайла(Префикс + ".json", ОтчетJSON(Результат)));
	Файлы.Добавить(ОписаниеТекстовогоФайла(Префикс + ".html", ОтчетHTMLДляБизнеса(Результат)));

	Возврат Файлы;

КонецФункции

// Снимок конфигурации текстом — записывает его клиент.
Функция ТекстСнимка(Карта) Экспорт

	Данные = ДанныеСнимка(Карта);

	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку(Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Авто, Символы.Таб));
	ЗаписатьJSON(Запись, Данные);

	Возврат Запись.Закрыть();

КонецФункции

// Заготовки файлов исключений — по одной на вид объекта. Какие из них уже есть
// на диске, решает клиент: он же и пишет.
//
// Возвращаемое значение:
//  Массив из Структура - ИмяФайла, Текст.
Функция ЗаготовкиИсключений() Экспорт

	Файлы = Новый Массив;

	Для Каждого Элемент Из СоответствиеИменФайловВидам() Цикл
		Файлы.Добавить(ОписаниеТекстовогоФайла(
			ИмяФайлаИсключений(Элемент.Значение),
			ШапкаФайлаИсключений(Элемент.Значение)));
	КонецЦикла;

	Возврат Файлы;

КонецФункции

// Предложения исключений, разложенные по файлам: клиент сверит их с тем,
// что уже лежит в файле, и допишет только новое.
//
// Возвращаемое значение:
//  Массив из Структура - ИмяФайла, Строки (Массив), Шапка.
Функция ИсключенияПоФайлам(Предложения) Экспорт

	ПоВидам = Новый Соответствие;

	Для Каждого Строка Из Предложения Цикл

		Если ПустаяСтрока(Строка.Вид) Или ПустаяСтрока(Строка.Имя) Тогда
			Продолжить;
		КонецЕсли;

		Список = ПоВидам[Строка.Вид];
		Если Список = Неопределено Тогда
			Список = Новый Массив;
			ПоВидам.Вставить(Строка.Вид, Список);
		КонецЕсли;

		Значение = Строка.Имя + ?(ПустаяСтрока(Строка.ТипПроверки), "", "." + Строка.ТипПроверки);
		Если Список.Найти(Значение) = Неопределено Тогда
			Список.Добавить(Значение);
		КонецЕсли;

	КонецЦикла;

	Файлы = Новый Массив;

	Для Каждого Элемент Из ПоВидам Цикл
		Описание = Новый Структура;
		Описание.Вставить("ИмяФайла", ИмяФайлаИсключений(Элемент.Ключ));
		Описание.Вставить("Шапка",    ШапкаФайлаИсключений(Элемент.Ключ));
		Описание.Вставить("Строки",   Элемент.Значение);
		Файлы.Добавить(Описание);
	КонецЦикла;

	Возврат Файлы;

КонецФункции

Функция ОписаниеТекстовогоФайла(ИмяФайла, Текст)

	Описание = Новый Структура;
	Описание.Вставить("ИмяФайла", ИмяФайла);
	Описание.Вставить("Текст",    Текст);

	Возврат Описание;

КонецФункции

// Сохраняет весь комплект отчётов в каталог. Возвращает массив путей.
Функция СохранитьОтчеты(Результат, Каталог) Экспорт

	Файлы = Новый Массив;
	Метка = Формат(Результат.ДатаНачала, "ДФ=yyyyMMdd-HHmmss");
	Префикс = Каталог + ?(Прав(Каталог, 1) = "\", "", "\") + "АвтоТест1С-" + Метка;

	ЗаписатьТекстВФайл(Префикс + ".json", ОтчетJSON(Результат));
	Файлы.Добавить(Префикс + ".json");

	ЗаписатьТекстВФайл(Префикс + ".html", ОтчетHTMLДляБизнеса(Результат));
	Файлы.Добавить(Префикс + ".html");

	ОтчетТабличныйДокумент(Результат).Записать(Префикс + ".mxl");
	Файлы.Добавить(Префикс + ".mxl");

	Возврат Файлы;

КонецФункции

#КонецОбласти

