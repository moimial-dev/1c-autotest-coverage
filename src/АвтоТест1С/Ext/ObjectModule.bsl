#КонецОбласти
#Область ГенераторСценариевVanessa

// FR-02, FR-06. Генератор Gherkin-сценариев проверки пользовательского интерфейса
// для Vanessa Automation. Сценарии строятся по карте объектов, поэтому набор
// обновляется вместе с конфигурацией и не требует ручной поддержки.
//
// Возвращаемое значение:
//  Структура - настройки генерации, см. СгенерироватьСценарииVanessa.
Функция НастройкиГенерацииСценариев() Экспорт

	Настройки = Новый Структура;
	Настройки.Вставить("КаталогСценариев",        "");
	Настройки.Вставить("ПроверятьСписки",         Истина);
	Настройки.Вставить("ПроверятьСозданиеФорм",   Истина);
	Настройки.Вставить("ПроверятьОтчеты",         Истина);
	Настройки.Вставить("ПроверятьОбработки",      Ложь);    // обработка может что-то сделать при открытии
	Настройки.Вставить("ПроверятьРегистры",       Истина);
	// Видимость команд в панели функций метаданными не читается, поэтому проверка
	// команд даёт ложные падения на объектах, скрытых в интерфейсе, — по умолчанию выключена
	Настройки.Вставить("ПроверятьКоманды",        Ложь);    // открытие через командный интерфейс
	Настройки.Вставить("ГруппироватьПоРазделам",  Истина);  // файл на раздел командного интерфейса
	Настройки.Вставить("ГруппироватьПоПроцессам", Истина);  // иначе файл на каждый вид объекта
	Настройки.Вставить("ЛимитОбъектовНаВид",      0);       // 0 — без ограничения
	Настройки.Вставить("ЛимитСценариев",          0);
	Настройки.Вставить("ПрофильКлиента",          "");      // имя профиля TestClient в Vanessa
	Настройки.Вставить("ПользовательИБ",          "");      // отбор объектов по правам этого пользователя
	Настройки.Вставить("ПарольПользователя",      "");      // пароль для подключения TestClient под ним
	Настройки.Вставить("МинимальнаяКритичность",  0);       // 0 — все объекты
	Настройки.Вставить("КаталогИсключений",       "");      // каталог txt-файлов со списком исключений
	Настройки.Вставить("ТолькоВидимыеРазделы",    Истина);  // при выбранном пользователе — только то, что он видит в меню
	Настройки.Вставить("ПроверятьНепустыеСписки", Ложь);    // У-01: список должен содержать хотя бы одну строку
	Настройки.Вставить("УчитыватьФункциональныеОпции", Истина); // У-07: пропускать объекты выключенных опций
	Настройки.Вставить("ЗаписыватьФайлы",         Истина); // Ложь — форма пишет набор сама, на клиенте
	Настройки.Вставить("ФайлСлепкаФорм",          "");      // У-02: фактические имена форм, собранные прогоном
	Настройки.Вставить("ОбучающийНабор",          Ложь);    // У-02: генерировать набор для сбора слепка
	// У-05. Печать и ввод на основании — самые дорогие в поддержке места конфигурации.
	// Имена команд платформа не гарантирует, поэтому обе проверки по умолчанию выключены:
	// их включают, разобрав первый прогон через файлы исключений
	Настройки.Вставить("ПроверятьПечать",         Ложь);
	Настройки.Вставить("ПроверятьВводНаОсновании", Ложь);
	// У-06. Сценарии, которые могут оставить след в данных, выносятся в отдельные
	// файлы с тегом @ИзменяетДанные: на копии рабочей базы их можно не гонять
	Настройки.Вставить("ОтделятьПишущиеСценарии", Истина);
	Настройки.Вставить("ПотоковПрогона",          1);       // У-08: раскладка набора для параллельного запуска
	Настройки.Вставить("ЯзыкШагов",               "ru");    // У-10: ru | en
	// Ожидание вместо фиксированной паузы: сценарий идёт дальше, как только форма
	// открылась, а не досиживает секунды до конца. Это потолок на худший случай:
	// он тратится целиком только там, где ожидаемое событие так и не наступило
	Настройки.Вставить("ТаймаутОжидания",         8);
	// Печатная форма БСП открывается общей формой «ПечатьДокументов», где поля
	// табличных документов называются ПечатнаяФорма1, ПечатнаяФорма2… Ждём первое:
	// пустая печатная форма — это и есть дефект, ради которого сценарий пишется,
	// а факт открытия окна о заполнении ничего не говорит
	Настройки.Вставить("ЭлементПечатнойФормы",    "ПечатнаяФорма1");
	// Печатают проведённый документ: у непроведённого конфигурация либо откажет
	// («документ не проведён»), либо напечатает черновик, который никому не нужен.
	// Генератор сам находит подходящий объект и ставит ссылку прямо в сценарий
	Настройки.Вставить("ПечатьТолькоПроведенных", Истина);
	// Печать дороже открытия формы: платформа формирует макет, БСП собирает данные.
	// Общий таймаут для неё мал, поэтому у шагов печати он свой
	Настройки.Вставить("ТаймаутПечати",           30);
	// Ждём форму печати по имени, а не «любое новое окно»: заголовок у окна печати
	// тот же, что у документа («Оприходование товаров ТСРТ-000001 от …»),
	// и ожидание «окна с другим заголовком» висело бы до самого таймаута
	Настройки.Вставить("ФормаПечатиБСП",          "ОбщаяФорма.ПечатьДокументов");

	Возврат Настройки;

КонецФункции

// Генерирует набор .feature-файлов и, если задан каталог, сохраняет их на диск.
//
// Параметры:
//  НастройкиГенерации - Структура - см. НастройкиГенерацииСценариев.
//  Карта              - ТаблицаЗначений - карта объектов; если не передана, строится заново.
//
// Возвращаемое значение:
//  Структура:
//   *Файлы      - Массив из Структура - ИмяФайла, Путь, Текст, Сценариев, Группа.
//   *Сценариев  - Число - сколько сценариев сгенерировано всего.
//   *Объектов   - Число - по скольким объектам метаданных.
//   *Лог        - Массив из Строка.
Функция СгенерироватьСценарииVanessa(НастройкиГенерации, Карта = Неопределено) Экспорт

	Результат = Новый Структура;
	Результат.Вставить("Файлы",     Новый Массив);
	Результат.Вставить("Сценариев", 0);
	Результат.Вставить("Объектов",  0);
	Результат.Вставить("Лог",       Новый Массив);
	// У-09. Покрытие интерфейса: сколько объектов раздела попало в набор
	// и почему не попали остальные
	Результат.Вставить("Покрытие",  ТаблицаПокрытияИнтерфейса());

	Если Карта = Неопределено Тогда
		НастройкиКарты = НастройкиПрогона();
		НастройкиКарты.ЛимитОбъектовНаВид = НастройкиГенерации.ЛимитОбъектовНаВид;
		Карта = ПостроитьКартуОбъектов(НастройкиКарты);
	КонецЕсли;

	// Когда выбран пользователь, в набор попадают только те объекты, которые ему
	// доступны по ролям: иначе сценарии падали бы на правах, а не на дефектах
	ПользовательОтбора = ПользовательИБПоИмени(НастройкиГенерации.ПользовательИБ);
	ПропущеноПоПравам = 0;

	// Исключения работают так же, как в генераторе дымовых тестов Vanessa:
	// каталог txt-файлов, имя файла начинается с вида объекта
	Исключения = ПрочитатьИсключения(НастройкиГенерации.КаталогИсключений, Результат.Лог);
	ПропущеноПоИсключениям = 0;
	ПропущеноВнеРазделов = 0;

	// У-07. Объект, скрытый выключенной функциональной опцией, в интерфейсе
	// недоступен ровно так же, как объект без прав: сценарий по нему упал бы
	// на отсутствии команды или формы
	ОтключенныеОпциями = ОбъектыОтключенныеФункциональнымиОпциями(НастройкиГенерации);
	ПропущеноПоОпциям = 0;

	// У-02. Слепок фактических форм: имя формы, которая реально открылась в прогоне,
	// точнее метаданных. Основная форма списка в метаданных — «ФормаСписка»,
	// а команда раздела открывает «ФормаСпискаДокументов»; заголовок окна вообще
	// живёт своей жизнью («Приемка товаров» вместо «Приходные ордера на товары»)
	СлепокФорм = ПрочитатьСлепокФорм(НастройкиГенерации.ФайлСлепкаФорм, Результат.Лог);

	Если ПользовательОтбора <> Неопределено Тогда
		// Дальше везде работаем с именем входа, как оно записано в базе: в нём
		// самом могут быть скобки («БушуевЭР (Менеджер)»), и обрезать их нельзя —
		// именно эта строка нужна для подключения клиента тестирования
		НастройкиГенерации.ПользовательИБ = ПользовательОтбора.Имя;
	КонецЕсли;

	// Разделы командного интерфейса нужны для сценариев, которые открывают объект
	// так же, как пользователь: «Закупки» → «Поставщики». Разделы, которых
	// пользователь не видит, в индекс не попадают — иначе сценарий падал бы
	// на «Кнопка панели разделов <Администрирование> не найдена»
	РазделыКомандногоИнтерфейса = ИндексРазделовКомандногоИнтерфейса(ПользовательОтбора);

	// Группировка по процессам даёт наборы, понятные заказчику («Продажа и касса»),
	// по видам — привычные разработчику
	Группы = Новый Соответствие;
	ПорядокГрупп = Новый Массив;

	Для Каждого СтрокаКарты Из Карта Цикл

		Если СтрокаКарты.Критичность < НастройкиГенерации.МинимальнаяКритичность Тогда
			ОтметитьПокрытие(Результат.Покрытие, СтрокаКарты, РазделыКомандногоИнтерфейса,
				Ложь, "критичность ниже порога");
			Продолжить;
		КонецЕсли;

		Если ПользовательОтбора <> Неопределено
			И Не ОбъектДоступенПользователю(СтрокаКарты.ПолноеИмя, ПользовательОтбора) Тогда
			ПропущеноПоПравам = ПропущеноПоПравам + 1;
			ОтметитьПокрытие(Результат.Покрытие, СтрокаКарты, РазделыКомандногоИнтерфейса,
				Ложь, "нет прав у пользователя");
			Продолжить;
		КонецЕсли;

		Если ОбъектИсключен(Исключения, СтрокаКарты, "") Тогда
			ПропущеноПоИсключениям = ПропущеноПоИсключениям + 1;
			ОтметитьПокрытие(Результат.Покрытие, СтрокаКарты, РазделыКомандногоИнтерфейса,
				Ложь, "в файле исключений");
			Продолжить;
		КонецЕсли;

		Если ОтключенныеОпциями[СтрокаКарты.ПолноеИмя] <> Неопределено Тогда
			ПропущеноПоОпциям = ПропущеноПоОпциям + 1;
			ОтметитьПокрытие(Результат.Покрытие, СтрокаКарты, РазделыКомандногоИнтерфейса,
				Ложь, "выключена опция «" + ОтключенныеОпциями[СтрокаКарты.ПолноеИмя] + "»");
			Продолжить;
		КонецЕсли;

		// Прав на объект мало: пользователь работает с тем, что видит в меню.
		// Объект, не попавший ни в один доступный ему раздел, в интерфейсе
		// недостижим — сценарий по нему проверял бы несуществующий путь
		Если ПользовательОтбора <> Неопределено
			И НастройкиГенерации.ТолькоВидимыеРазделы
			И РазделыКомандногоИнтерфейса[СтрокаКарты.ПолноеИмя] = Неопределено Тогда
			ПропущеноВнеРазделов = ПропущеноВнеРазделов + 1;
			ОтметитьПокрытие(Результат.Покрытие, СтрокаКарты, РазделыКомандногоИнтерфейса,
				Ложь, "нет в доступных разделах");
			Продолжить;
		КонецЕсли;

		СценарииОбъекта = СценарииДляОбъекта(СтрокаКарты, НастройкиГенерации, РазделыКомандногоИнтерфейса,
			Исключения, ПропущеноПоИсключениям, СлепокФорм, ПользовательОтбора);
		Если СценарииОбъекта.Количество() = 0 Тогда
			ОтметитьПокрытие(Результат.Покрытие, СтрокаКарты, РазделыКомандногоИнтерфейса,
				Ложь, "нечего проверять при текущих настройках");
			Продолжить;
		КонецЕсли;

		Результат.Объектов = Результат.Объектов + 1;
		ОтметитьПокрытие(Результат.Покрытие, СтрокаКарты, РазделыКомандногоИнтерфейса,
			Истина, "", СценарииОбъекта.Количество());

		ИмяГруппы = ИмяГруппыНабора(СтрокаКарты, НастройкиГенерации, РазделыКомандногоИнтерфейса);

		Сценарии = Группы[ИмяГруппы];
		Если Сценарии = Неопределено Тогда
			Сценарии = Новый Массив;
			Группы.Вставить(ИмяГруппы, Сценарии);
			ПорядокГрупп.Добавить(ИмяГруппы);
		КонецЕсли;

		Для Каждого Сценарий Из СценарииОбъекта Цикл

			Если НастройкиГенерации.ЛимитСценариев > 0
				И Результат.Сценариев >= НастройкиГенерации.ЛимитСценариев Тогда
				Прервать;
			КонецЕсли;

			Сценарии.Добавить(Сценарий);
			Результат.Сценариев = Результат.Сценариев + 1;

		КонецЦикла;

	КонецЦикла;

	Для Каждого ИмяГруппы Из ПорядокГрупп Цикл

		Сценарии = Группы[ИмяГруппы];
		Если Сценарии.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;

		// У-06. Читающие и пишущие сценарии — в разные файлы: набор, который
		// ничего не меняет, можно гонять хоть на копии рабочей базы, а пишущий —
		// только там, где не жалко данных
		Части = РазделитьСценарииПоВлияниюНаДанные(Сценарии, НастройкиГенерации);

		Для Каждого Часть Из Части Цикл

			Если Часть.Сценарии.Количество() = 0 Тогда
				Продолжить;
			КонецЕсли;

			ОписаниеФайла = Новый Структура;
			ОписаниеФайла.Вставить("Группа",         ИмяГруппы);
			ОписаниеФайла.Вставить("ИмяФайла",       ИмяФайлаФичи(ИмяГруппы + Часть.Суффикс));
			ОписаниеФайла.Вставить("Путь",           "");
			ОписаниеФайла.Вставить("Сценариев",      Часть.Сценарии.Количество());
			ОписаниеФайла.Вставить("ИзменяетДанные", Часть.ИзменяетДанные);
			ОписаниеФайла.Вставить("Текст",          ТекстФичи(ИмяГруппы + Часть.Суффикс,
				Часть.Сценарии, НастройкиГенерации, Часть.ИзменяетДанные));

			Результат.Файлы.Добавить(ОписаниеФайла);

		КонецЦикла;

	КонецЦикла;

	// У-08. Раскладка по потокам: Vanessa умеет гонять несколько клиентов
	// тестирования, и час на 575 сценариев делится между ними
	РазложитьПоПотокам(Результат, НастройкиГенерации);

	// Файлы пишет тот, у кого есть доступ к нужному каталогу: из формы это
	// клиент, а вызов из сценария или пакетного режима сохраняет здесь же
	ЗаписыватьФайлы = Истина;
	НастройкиГенерации.Свойство("ЗаписыватьФайлы", ЗаписыватьФайлы);

	Если ЗаписыватьФайлы И Не ПустаяСтрока(НастройкиГенерации.КаталогСценариев) Тогда
		СохранитьСценарииVanessa(Результат, НастройкиГенерации.КаталогСценариев);
	КонецЕсли;

	Результат.Лог.Добавить("Сценарии Vanessa: объектов — " + Результат.Объектов
		+ ", сценариев — " + Результат.Сценариев
		+ ", файлов — " + Результат.Файлы.Количество() + ".");

	Для Каждого СтрокаСводки Из СводкаПокрытияИнтерфейса(Результат.Покрытие) Цикл
		Результат.Лог.Добавить(СтрокаСводки);
	КонецЦикла;

	Если ПользовательОтбора <> Неопределено Тогда
		Результат.Лог.Добавить("Отбор по правам пользователя «" + НастройкиГенерации.ПользовательИБ
			+ "»: пропущено недоступных объектов — " + ПропущеноПоПравам + ".");
	КонецЕсли;

	Если ПропущеноПоОпциям > 0 Тогда
		Результат.Лог.Добавить("Выключенные функциональные опции: пропущено объектов — "
			+ ПропущеноПоОпциям + ".");
	КонецЕсли;

	Если ПропущеноВнеРазделов > 0 Тогда
		Результат.Лог.Добавить("Вне доступных пользователю разделов командного интерфейса: пропущено объектов — "
			+ ПропущеноВнеРазделов + ".");
	КонецЕсли;

	Если Исключения.Количество() > 0 Тогда
		Результат.Лог.Добавить("Исключения из каталога «" + НастройкиГенерации.КаталогИсключений
			+ "»: пропущено проверок — " + ПропущеноПоИсключениям + ".");
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Сохраняет сгенерированные фичи в каталог. Имя файла совпадает с именем группы.
Процедура СохранитьСценарииVanessa(РезультатГенерации, Каталог) Экспорт

	ОбъектКаталога = Новый Файл(Каталог);
	Если Не ОбъектКаталога.Существует() Тогда
		СоздатьКаталог(Каталог);
	КонецЕсли;

	Разделитель = ПолучитьРазделительПути();

	// Прежний набор удаляем: иначе после смены пользователя или группировки
	// в каталоге остаются файлы от старой выгрузки и набор выглядит так, будто
	// в него попали лишние разделы. Удаляются только файлы самого генератора
	// У-08. Набор может лежать в подкаталогах «поток-N», поэтому ищем и там
	Удалено = 0;
	Для Каждого Файл Из НайтиФайлы(Каталог, "UI. *.feature", Истина) Цикл
		УдалитьФайлы(Файл.ПолноеИмя);
		Удалено = Удалено + 1;
	КонецЦикла;

	Для Каждого ОписаниеФайла Из РезультатГенерации.Файлы Цикл

		Путь = Каталог + ?(Прав(Каталог, 1) = Разделитель, "", Разделитель) + ОписаниеФайла.ИмяФайла;

		// Имя файла может содержать подкаталог потока — его нужно создать
		ПодКаталог = КаталогИзПути(Путь);
		Если Не ПустаяСтрока(ПодКаталог) Тогда
			ОбъектПодкаталога = Новый Файл(ПодКаталог);
			Если Не ОбъектПодкаталога.Существует() Тогда
				СоздатьКаталог(ПодКаталог);
			КонецЕсли;
		КонецЕсли;

		ЗаписатьТекстВФайл(Путь, ОписаниеФайла.Текст);
		ОписаниеФайла.Путь = Путь;

	КонецЦикла;

	Если Удалено > 0 Тогда
		РезультатГенерации.Лог.Добавить("Файлов прошлой выгрузки удалено: " + Удалено + ".");
	КонецЕсли;

КонецПроцедуры

// Раскладывает в каталоге заготовки файлов исключений — по одному на вид объекта.
// Существующие файлы не трогаются: в них уже может быть ручной список.
//
// Возвращаемое значение:
//  Число - сколько файлов создано.
Функция СоздатьЗаготовкиИсключений(Каталог) Экспорт

	ОбъектКаталога = Новый Файл(Каталог);
	Если Не ОбъектКаталога.Существует() Тогда
		СоздатьКаталог(Каталог);
	КонецЕсли;

	Разделитель = ПолучитьРазделительПути();
	Создано = 0;

	Для Каждого Элемент Из СоответствиеИменФайловВидам() Цикл

		ИмяФайла = ИмяФайлаИсключений(Элемент.Значение);
		Путь = Каталог + ?(Прав(Каталог, 1) = Разделитель, "", Разделитель) + ИмяФайла;

		ФайлИсключений = Новый Файл(Путь);
		Если ФайлИсключений.Существует() Тогда
			Продолжить;
		КонецЕсли;

		ЗаписатьТекстВФайл(Путь, ШапкаФайлаИсключений(Элемент.Значение));
		Создано = Создано + 1;

	КонецЦикла;

	Возврат Создано;

КонецФункции

Функция ИмяФайлаИсключений(Вид)

	Соответствие = Новый Соответствие;
	Для Каждого Элемент Из СоответствиеИменФайловВидам() Цикл
		Соответствие.Вставить(Элемент.Значение, Элемент.Ключ);
	КонецЦикла;

	Имя = Соответствие[Вид];

	Возврат ?(Имя = Неопределено, Вид, ПредставлениеФайлаИсключений(Имя)) + ".txt";

КонецФункции

// Имена файлов пишем в привычном виде («Справочники», «РегистрыСведений»),
// а сравниваются они всё равно без учёта регистра
Функция ПредставлениеФайлаИсключений(ИмяВНижнемРегистре)

	Соответствие = Новый Соответствие;
	Соответствие.Вставить("справочники",             "Справочники");
	Соответствие.Вставить("документы",               "Документы");
	Соответствие.Вставить("регистрысведений",        "РегистрыСведений");
	Соответствие.Вставить("регистрынакопления",      "РегистрыНакопления");
	Соответствие.Вставить("регистрыбухгалтерии",     "РегистрыБухгалтерии");
	Соответствие.Вставить("планывидовхарактеристик", "ПланыВидовХарактеристик");
	Соответствие.Вставить("планысчетов",             "ПланыСчетов");
	Соответствие.Вставить("планыобмена",             "ПланыОбмена");
	Соответствие.Вставить("бизнеспроцессы",          "БизнесПроцессы");
	Соответствие.Вставить("задачи",                  "Задачи");
	Соответствие.Вставить("отчеты",                  "Отчеты");
	Соответствие.Вставить("обработки",               "Обработки");

	Представление = Соответствие[ИмяВНижнемРегистре];

	Возврат ?(Представление = Неопределено, ИмяВНижнемРегистре, Представление);

КонецФункции

Функция ШапкаФайлаИсключений(Вид)

	Строки = Новый Массив;
	Строки.Добавить("// Исключения генератора UI-сценариев, вид объектов: " + ПредставлениеВида(Вид) + ".");
	Строки.Добавить("// Одна строка — один объект. Пустые строки и строки с // пропускаются.");
	Строки.Добавить("//");
	Строки.Добавить("// Формат: ИмяОбъекта[.ТипПроверки]");
	Строки.Добавить("//   ИмяОбъекта  — имя как в конфигураторе, звёздочка допустима в любом месте");
	Строки.Добавить("//   ТипПроверки — Список, Создание, Форма или КомандныйИнтерфейс;");
	Строки.Добавить("//                 без него объект исключается целиком");
	Строки.Добавить("//");
	Строки.Добавить("// Примеры:");
	Строки.Добавить("//   РассылкиОтчетов.Список          — не проверять только форму списка");
	Строки.Добавить("//   ПрисоединенныеФайлы*            — пропустить все присоединённые файлы");
	Строки.Добавить("//   НастройкиПочты.Создание         — не открывать форму создания");
	Строки.Добавить("");

	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

// У-03. Разбор результатов прогона Vanessa (каталог allure-results) и подготовка
// исключений для объектов, упавших со «штатными» отказами конфигурации.
//
// Отделить штатный отказ от дефекта можно по тексту ошибки: «самостоятельное
// использование формы не предусмотрено», «только на основании», «не выбран…» —
// это поведение конфигурации, а не сломанный интерфейс. Всё остальное остаётся
// в отчёте как есть: прятать настоящие ошибки исключениями нельзя.
//
// Параметры:
//  КаталогРезультатов - Строка - каталог allure-results.
//  КаталогИсключений  - Строка - куда дописывать строки; пусто — только разбор.
//
// Возвращаемое значение:
//  Структура:
//   *Предложения - ТаблицаЗначений - Вид, Имя, ТипПроверки, Причина, Сценарий.
//   *Дефекты     - ТаблицаЗначений - падения, которые исключать нельзя.
//   *Записано    - Число - сколько строк дописано в файлы исключений.
//   *Лог         - Массив из Строка.
Функция РазобратьРезультатыПрогона(КаталогРезультатов, КаталогИсключений = "") Экспорт

	Результат = Новый Структура;
	Результат.Вставить("Предложения", ТаблицаПредложенийИсключений());
	Результат.Вставить("Дефекты",     ТаблицаПредложенийИсключений());
	Результат.Вставить("Записано",    0);
	Результат.Вставить("Лог",         Новый Массив);

	ОбъектКаталога = Новый Файл(КаталогРезультатов);
	Если Не ОбъектКаталога.Существует() Тогда
		Результат.Лог.Добавить("Каталог результатов «" + КаталогРезультатов + "» не найден.");
		Возврат Результат;
	КонецЕсли;

	Файлы = НайтиФайлы(КаталогРезультатов, "*-result.json", Ложь);
	Разобрано = 0;

	Для Каждого Файл Из Файлы Цикл

		Данные = ПрочитатьJSONИзФайла(Файл.ПолноеИмя);
		Если Данные = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Статус = ЗначениеJSON(Данные, "status");
		Если Статус = Неопределено
			Или (НРег(Статус) <> "failed" И НРег(Статус) <> "broken") Тогда
			Продолжить;
		КонецЕсли;

		Разобрано = Разобрано + 1;

		ИмяСценария = ЗначениеJSON(Данные, "name");
		ИмяСценария = ?(ИмяСценария = Неопределено, "", ИмяСценария);

		ТекстОшибки = ТекстОшибкиРезультата(Данные);
		Объект = ОбъектИзТеговРезультата(Данные);

		Строка = ?(ШтатныйОтказКонфигурации(ТекстОшибки),
			Результат.Предложения.Добавить(), Результат.Дефекты.Добавить());

		Строка.Вид         = Объект.Вид;
		Строка.Имя         = Объект.Имя;
		Строка.ТипПроверки = ТипПроверкиИзТегов(Данные);
		Строка.Причина     = Лев(ТекстОшибки, 150);
		Строка.Сценарий    = ИмяСценария;

	КонецЦикла;

	Результат.Лог.Добавить("Разобрано падений: " + Разобрано
		+ ", из них штатных отказов конфигурации — " + Результат.Предложения.Количество()
		+ ", требуют разбора — " + Результат.Дефекты.Количество() + ".");

	Если Не ПустаяСтрока(КаталогИсключений) Тогда
		Результат.Записано = ДописатьИсключения(Результат.Предложения, КаталогИсключений, Результат.Лог);
	КонецЕсли;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыГенератораСценариев

// JSON читается в соответствие, но тот же код должен работать и со структурой,
// если формат чтения когда-нибудь поменяется.
Функция ЗначениеJSON(Данные, Ключ)

	Если Данные = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если ТипЗнч(Данные) = Тип("Соответствие") Тогда
		Возврат Данные[Ключ];
	КонецЕсли;

	Значение = Неопределено;
	Попытка
		Данные.Свойство(Ключ, Значение);
	Исключение
		Возврат Неопределено;
	КонецПопытки;

	Возврат Значение;

КонецФункции

Функция ТаблицаПредложенийИсключений()

	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Вид",         Новый ОписаниеТипов("Строка"));
	Таблица.Колонки.Добавить("Имя",         Новый ОписаниеТипов("Строка"));
	Таблица.Колонки.Добавить("ТипПроверки", Новый ОписаниеТипов("Строка"));
	Таблица.Колонки.Добавить("Причина",     Новый ОписаниеТипов("Строка"));
	Таблица.Колонки.Добавить("Сценарий",    Новый ОписаниеТипов("Строка"));

	Возврат Таблица;

КонецФункции

// Признаки того, что конфигурация отказала намеренно.
Функция ШтатныйОтказКонфигурации(ТекстОшибки)

	Текст = НРег(ТекстОшибки);

	Признаки = Новый Массив;
	Признаки.Добавить("самостоятельное использование формы");
	Признаки.Добавить("только на основании");
	Признаки.Добавить("возможно открыть только");
	Признаки.Добавить("открытие отчета не возможно");
	Признаки.Добавить("не выбран");
	Признаки.Добавить("не выбрана");
	Признаки.Добавить("не предусмотрено");
	Признаки.Добавить("команда меню");
	Признаки.Добавить("не получилось нажать на команду");
	Признаки.Добавить("кнопка панели разделов");
	// Не отказ конфигурации, а предел самого стенда: в данных попадаются коды
	// маркировки с управляющими символами (GS), и клиент с сервером не могут
	// передать их друг другу в XML. Интерфейс тут ни при чём — объект исключаем
	Признаки.Добавить("текст xml содержит недопустимый символ");
	Признаки.Добавить("ошибка преобразования данных xdto");

	Для Каждого Признак Из Признаки Цикл
		Если СтрНайти(Текст, Признак) > 0 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

Функция ТекстОшибкиРезультата(Данные)

	Детали = ЗначениеJSON(Данные, "statusDetails");
	Если Детали = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Сообщение = ЗначениеJSON(Детали, "message");

	Возврат ?(Сообщение = Неопределено, "", СокрЛП(Сообщение));

КонецФункции

// Полное имя объекта генератор кладёт в тег вида «Справочник_Номенклатура» —
// по нему падение и сопоставляется с объектом конфигурации.
Функция ОбъектИзТеговРезультата(Данные)

	Объект = Новый Структура("Вид, Имя", "", "");

	Метки = ЗначениеJSON(Данные, "labels");
	Если Метки = Неопределено Тогда
		Возврат Объект;
	КонецЕсли;

	Виды = СоответствиеИменФайловВидам();

	Для Каждого Метка Из Метки Цикл

		ИмяМетки = ЗначениеJSON(Метка, "name");
		Если ИмяМетки = Неопределено Или НРег(ИмяМетки) <> "tag" Тогда
			Продолжить;
		КонецЕсли;

		Значение = ЗначениеJSON(Метка, "value");
		Если Значение = Неопределено Или СтрНайти(Значение, "_") = 0 Тогда
			Продолжить;
		КонецЕсли;

		Части = СтрРазделить(Значение, "_", Ложь);
		Если Части.Количество() < 2 Тогда
			Продолжить;
		КонецЕсли;

		ВидКандидат = Части[0];
		Для Каждого Элемент Из Виды Цикл
			Если НРег(Элемент.Значение) = НРег(ВидКандидат) Тогда
				Объект.Вид = Элемент.Значение;
				Части.Удалить(0);
				Объект.Имя = СтрСоединить(Части, "_");
				Возврат Объект;
			КонецЕсли;
		КонецЦикла;

	КонецЦикла;

	Возврат Объект;

КонецФункции

Функция ТипПроверкиИзТегов(Данные)

	Метки = ЗначениеJSON(Данные, "labels");
	Если Метки = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Типы = Новый Массив;
	Типы.Добавить("Список");
	Типы.Добавить("Создание");
	Типы.Добавить("Форма");
	Типы.Добавить("КомандныйИнтерфейс");

	Для Каждого Метка Из Метки Цикл

		ИмяМетки = ЗначениеJSON(Метка, "name");
		Если ИмяМетки = Неопределено Или НРег(ИмяМетки) <> "tag" Тогда
			Продолжить;
		КонецЕсли;

		Значение = ЗначениеJSON(Метка, "value");
		Если Значение = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Для Каждого Тип Из Типы Цикл
			Если НРег(Значение) = НРег(Тип) Тогда
				Возврат Тип;
			КонецЕсли;
		КонецЦикла;

	КонецЦикла;

	Возврат "";

КонецФункции

// Дописывает предложения в файлы исключений, не трогая уже имеющиеся строки.
Функция ДописатьИсключения(Предложения, Каталог, Лог)

	ОбъектКаталога = Новый Файл(Каталог);
	Если Не ОбъектКаталога.Существует() Тогда
		СоздатьКаталог(Каталог);
	КонецЕсли;

	Разделитель = ПолучитьРазделительПути();
	Записано = 0;

	// Группируем по видам: один файл открывается один раз
	ПоВидам = Новый Соответствие;

	Для Каждого Строка Из Предложения Цикл

		Если ПустаяСтрока(Строка.Вид) Или ПустаяСтрока(Строка.Имя) Тогда
			Продолжить;
		КонецЕсли;

		Список = ПоВидам[Строка.Вид];
		Если Список = Неопределено Тогда
			Список = Новый Массив;
			ПоВидам.Вставить(Строка.Вид, Список);
		КонецЕсли;

		Значение = Строка.Имя + ?(ПустаяСтрока(Строка.ТипПроверки), "", "." + Строка.ТипПроверки);
		Если Список.Найти(Значение) = Неопределено Тогда
			Список.Добавить(Значение);
		КонецЕсли;

	КонецЦикла;

	Для Каждого Элемент Из ПоВидам Цикл

		Путь = Каталог + ?(Прав(Каталог, 1) = Разделитель, "", Разделитель) + ИмяФайлаИсключений(Элемент.Ключ);

		Существующие = Новый Соответствие;
		ФайлИсключений = Новый Файл(Путь);
		Если ФайлИсключений.Существует() Тогда
			Чтение = Новый ЧтениеТекста(Путь, КодировкаТекста.UTF8);
			Строка = Чтение.ПрочитатьСтроку();
			Пока Строка <> Неопределено Цикл
				Существующие.Вставить(НРег(СокрЛП(Строка)), Истина);
				Строка = Чтение.ПрочитатьСтроку();
			КонецЦикла;
			Чтение.Закрыть();
		Иначе
			ЗаписатьТекстВФайл(Путь, ШапкаФайлаИсключений(Элемент.Ключ));
		КонецЕсли;

		Новые = Новый Массив;
		Для Каждого Значение Из Элемент.Значение Цикл
			Если Существующие[НРег(Значение)] = Неопределено Тогда
				Новые.Добавить(Значение);
			КонецЕсли;
		КонецЦикла;

		Если Новые.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;

		Запись = Новый ЗаписьТекста(Путь, КодировкаТекста.UTF8, , Истина);
		Запись.ЗаписатьСтроку("");
		Запись.ЗаписатьСтроку("// Добавлено разбором прогона " + Формат(ТекущаяДатаСеанса(), "ДФ=dd.MM.yyyy HH:mm"));
		Для Каждого Значение Из Новые Цикл
			Запись.ЗаписатьСтроку(Значение);
			Записано = Записано + 1;
		КонецЦикла;
		Запись.Закрыть();

	КонецЦикла;

	Лог.Добавить("В файлы исключений дописано строк: " + Записано + ".");

	Возврат Записано;

КонецФункции




// Запасной разбор для случая, когда в настройку попало представление вида
// «Имя (Полное имя)». Сначала всегда пробуем строку целиком: у пользователя
// имя входа само может содержать скобки, и тогда обрезать его нельзя.
Функция ИмяПользователяИзПредставления(Значение) Экспорт

	Имя = СокрЛП(Значение);

	Позиция = СтрНайти(Имя, " (");
	Если Позиция > 1 Тогда
		Имя = Лев(Имя, Позиция - 1);
	КонецЕсли;

	Возврат Имя;

КонецФункции

// Пользователь информационной базы по имени. Неопределено означает, что отбор
// по правам не нужен: набор строится по всей конфигурации.
Функция ПользовательИБПоИмени(ИмяПользователя)

	Если ПустаяСтрока(ИмяПользователя) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Имя = СокрЛП(ИмяПользователя);

	ПользовательИБ = ПользователиИнформационнойБазы.НайтиПоИмени(Имя);

	Если ПользовательИБ = Неопределено Тогда
		ПользовательИБ = ПользователиИнформационнойБазы.НайтиПоИмени(ИмяПользователяИзПредставления(Имя));
	КонецЕсли;

	Если ПользовательИБ = Неопределено Тогда
		ВызватьИсключение "Пользователь информационной базы «" + ИмяПользователя + "» не найден.";
	КонецЕсли;

	Возврат ПользовательИБ;

КонецФункции

// Доступен ли объект пользователю. Право «Просмотр» есть не у всех видов
// объектов (у регистров, например, только «Чтение»), поэтому проверяем оба.
//
// ПравоДоступа принимает третьим параметром именно объект ПользовательИнформационнойБазы:
// с уникальным идентификатором платформа отвечает по текущему сеансу и возвращает
// «право есть» даже для несуществующего пользователя.
Функция ОбъектДоступенПользователю(ПолноеИмя, ПользовательИБ)

	МО = Метаданные.НайтиПоПолномуИмени(ПолноеИмя);
	Если МО = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Попытка
		Если ПравоДоступа("Просмотр", МО, ПользовательИБ) Тогда
			Возврат Истина;
		КонецЕсли;
	Исключение
		// право неприменимо к этому виду объектов — проверяем чтение
	КонецПопытки;

	Попытка
		Возврат ПравоДоступа("Чтение", МО, ПользовательИБ);
	Исключение
		Возврат Ложь;
	КонецПопытки;

КонецФункции

// Право на объект с учётом того, что не все права применимы ко всем видам
// объектов: для неприменимого права платформа бросает исключение, и это не отказ
// в доступе — такую проверку просто нечем сделать, объект остаётся в наборе.
Функция ЕстьПравоНаОбъект(Право, МО, ПользовательИБ)

	Если ПользовательИБ = Неопределено Тогда
		Возврат Истина;
	КонецЕсли;

	Попытка
		Возврат ПравоДоступа(Право, МО, ПользовательИБ);
	Исключение
		Возврат Истина;
	КонецПопытки;

КонецФункции

// У-05. Есть ли у объекта печатные формы. Макет может быть не печатным
// (условное оформление, схема компоновки), поэтому смотрим на тип макета.
Функция ЕстьПечатныеФормы(МО)

	Попытка
		Макеты = МО.Макеты;
	Исключение
		Возврат Ложь;
	КонецПопытки;

	Для Каждого Макет Из Макеты Цикл
		Если Макет.ТипМакета = Метаданные.СвойстваОбъектов.ТипМакета.ТабличныйДокумент Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

// У-05. Печать существующего объекта. Своих данных сценарий не заводит:
// печатать нечего — значит и проверять нечего, поэтому список строк проверяется
// условием, а не утверждением.
Функция СценарийПечати(СтрокаКарты, МО, Настройки)

	// Заголовок команды печати из метаданных не выводится: синоним макета
	// («ПФ MXL Поступление товаров») и подпись команды («М-4 (Приходный ордер)») —
	// разные вещи. Спрашиваем у БСП, какие команды печати объект объявляет сам
	Команда = ПерваяКомандаПечати(МО);
	Если Команда = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	ТаймаутПечати = 30;
	Настройки.Свойство("ТаймаутПечати", ТаймаутПечати);
	ТаймаутПечати = ?(ТаймаутПечати = Неопределено Или ТаймаутПечати <= 0, 30, Цел(ТаймаутПечати));

	ИмяФормыОбъекта = ИмяОсновнойФормы(МО, "ОсновнаяФормаОбъекта");

	Шаги = Новый Массив;

	// Объект ищем запросом в самом сценарии, а не подставляем ссылку при генерации:
	// зашитый идентификатор живёт ровно до первой перезаливки данных, после чего
	// весь набор начинает падать на несуществующих ссылках
	ДобавитьПоискОбъектаДляПечати(Шаги, СтрокаКарты, Настройки);

	Шаги.Добавить("Если переменная ""ЕстьЧтоПечатать"" имеет значение ""Да"" Тогда");
	Шаги.Добавить(Символы.Таб + Шаг(Настройки, "ОткрытьСсылку", "$СсылкаНаОбъект$"));
	Шаги.Добавить(Символы.Таб + ШагОжиданияФормы(Настройки, ИмяФормыОбъекта));
	// Нажимаем по имени, а не по заголовку: команды печати лежат в свёрнутом
	// подменю, и клик по подписи упирается в «недоступный пользователю элемент».
	// Имя платформа собирает из идентификатора команды, а префикс зависит
	// от того, попала команда в «Важное» или в «Обычное» — отсюда маска
	Шаги.Добавить(Символы.Таб + Шаг(Настройки, "НажатьКнопкуПоИмени",
		"ПодменюПечать*__" + Команда.Идентификатор));

	ФормаПечати = "";
	Настройки.Свойство("ФормаПечатиБСП", ФормаПечати);

	Если ПустаяСтрока(ФормаПечати) Тогда
		// Конфигурация без БСП — остаётся ждать любое новое окно
		Шаги.Вставить(Шаги.ВГраница(), Символы.Таб + Шаг(Настройки, "ЗапомнитьОкно"));
		Шаги.Добавить(Символы.Таб + Шаг(Настройки, "ЖдуДругоеОкно", "", ТаймаутПечати));
	Иначе
		Шаги.Добавить(Символы.Таб
			+ Шаг(Настройки, "ЖдуФормуПоИмени", ФормаПечати, ТаймаутПечати));
	КонецЕсли;

	// Окно печати открылось — но форма могла остаться пустой. Ждём, пока в поле
	// табличного документа появятся данные: это и есть смысл проверки печати
	ЭлементПечати = "";
	Настройки.Свойство("ЭлементПечатнойФормы", ЭлементПечати);

	Если Не ПустаяСтрока(ЭлементПечати) Тогда
		Шаги.Добавить(Символы.Таб
			+ Шаг(Настройки, "ЖдуТабличныйДокумент", ЭлементПечати, ТаймаутПечати));
	КонецЕсли;

	Шаги.Добавить(Шаг(Настройки, "ЗакрытьОкна"));
	// Печатная форма может спросить про настройки печати или подпись
	Шаги.Добавить(Шаг(Настройки, "ЕслиПредупреждение"));
	Шаги.Добавить(Символы.Таб + Шаг(Настройки, "ЗакрытьПредупреждение"));
	Шаги.Добавить(Символы.Таб + Шаг(Настройки, "ЗакрытьОкна"));

	Возврат НовыйСценарий(
		ЗаголовокСценария(Настройки, "Печать", СтрокаКарты, Команда.Представление),
		ТегиСценария(СтрокаКарты, "Печать"),
		Шаги);

КонецФункции

// Шаги поиска объекта, который имеет смысл печатать: проведённый документ
// или непомеченный элемент справочника. Запрос выполняется при прогоне —
// набор остаётся годным на любой базе и переживает перезаливку данных.
Процедура ДобавитьПоискОбъектаДляПечати(Шаги, СтрокаКарты, Настройки, ИмяПеременной = "СсылкаНаОбъект")

	ТолькоПроведенные = Истина;
	Настройки.Свойство("ПечатьТолькоПроведенных", ТолькоПроведенные);

	ЭтоДокумент = (СтрокаКарты.Вид = "Документ");

	Условия = Новый Массив;
	Если ЭтоДокумент И ТолькоПроведенные Тогда
		Условия.Добавить("Т.Проведен");
	КонецЕсли;
	Условия.Добавить("НЕ Т.ПометкаУдаления");

	ТекстЗапроса = "ВЫБРАТЬ ПЕРВЫЕ 1 Т.Ссылка КАК Ссылка ИЗ " + СтрокаКарты.ПолноеИмя + " КАК Т"
		+ " ГДЕ " + СтрСоединить(Условия, " И ")
		// Свежий документ показательнее старого: на нём вероятнее актуальные реквизиты
		+ ?(ЭтоДокумент, " УПОРЯДОЧИТЬ ПО Т.Дата УБЫВ", "");

	Шаги.Добавить("И я выполняю код встроенного языка на сервере с передачей переменных");
	Шаги.Добавить("""""""bsl");
	Шаги.Добавить(Символы.Таб + "Запрос = Новый Запрос(""" + ТекстЗапроса + """);");
	Шаги.Добавить(Символы.Таб + "Выборка = Запрос.Выполнить().Выбрать();");
	Шаги.Добавить(Символы.Таб + "Если Выборка.Следующий() Тогда");
	Шаги.Добавить(Символы.Таб + Символы.Таб + "Контекст.Вставить(""ЕстьЧтоПечатать"", ""Да"");");
	Шаги.Добавить(Символы.Таб + Символы.Таб + "Контекст.Вставить(""" + ИмяПеременной
		+ """, ПолучитьНавигационнуюСсылку(Выборка.Ссылка));");
	Шаги.Добавить(Символы.Таб + "Иначе");
	// Печатать нечего — это состояние чистой базы, а не дефект интерфейса
	Шаги.Добавить(Символы.Таб + Символы.Таб + "Контекст.Вставить(""ЕстьЧтоПечатать"", ""Нет"");");
	Шаги.Добавить(Символы.Таб + Символы.Таб + "Контекст.Вставить(""" + ИмяПеременной + """, """");");
	Шаги.Добавить(Символы.Таб + "КонецЕсли;");
	Шаги.Добавить("""""""");

КонецПроцедуры

// Поиск объекта работает со строкой карты объектов, а основание приходит
// объектом метаданных — заворачиваем его в ту же структуру.
Функция ОписаниеОснования(МО)

	ПолноеИмя = МО.ПолноеИмя();

	Описание = Новый Структура;
	Описание.Вставить("ПолноеИмя", ПолноеИмя);
	Описание.Вставить("Вид",       СтрРазделить(ПолноеИмя, ".", Ложь)[0]);

	Возврат Описание;

КонецФункции

// Подпись первой команды печати объекта — так, как её видит пользователь на форме.
// Спрашиваем у БСП: команды печати объявляются в модуле менеджера, а не в макетах.
// Конфигурация может быть и без БСП — тогда проверку печати не строим вовсе,
// гадать имя кнопки бесполезно.
Функция ПерваяКомандаПечати(МО)

	Попытка

		Коллекция = УправлениеПечатью.СоздатьКоллекциюКомандПечати();
		Менеджер = ОбщегоНазначения.МенеджерОбъектаПоПолномуИмени(МО.ПолноеИмя());
		Менеджер.ДобавитьКомандыПечати(Коллекция);

		// Первая команда в списке — не всегда та, что имеет смысл: у поступления
		// товаров это «Акт расхождений», который печатается пустым, если расхождений
		// нет. Берём ту, которую конфигурация называет основной
		Запасная = Неопределено;

		Для Каждого Команда Из Коллекция Цикл

			Если Команда.Отключена Или Команда.СкрытаФункциональнымиОпциями Тогда
				Продолжить;
			КонецЕсли;

			Если ПустаяСтрока(Команда.Представление) Или ПустаяСтрока(Команда.Идентификатор) Тогда
				Продолжить;
			КонецЕсли;

			Описание = Новый Структура;
			Описание.Вставить("Представление", Команда.Представление);
			Описание.Вставить("Идентификатор", Команда.Идентификатор);

			Если Команда.ОсновнаяПечатнаяФорма Или Команда.КомандаПоУмолчанию Тогда
				Возврат Описание;
			КонецЕсли;

			Если Запасная = Неопределено Тогда
				Запасная = Описание;
			КонецЕсли;

		КонецЦикла;

		Если Запасная <> Неопределено Тогда
			Возврат Запасная;
		КонецЕсли;

	Исключение
		// БСП нет или у объекта нет ДобавитьКомандыПечати — печать не проверяем
	КонецПопытки;

	Возврат Неопределено;

КонецФункции

// У-05. Ввод на основании. Форма нового документа заполняется данными основания,
// и часть конфигураций при закрытии предлагает записать — поэтому сценарий
// помечается как изменяющий данные (У-06).
Функция СценарииВводаНаОсновании(СтрокаКарты, МО, Настройки, ПользовательИБ)

	Сценарии = Новый Массив;

	Попытка
		Основания = МО.ВводитсяНаОсновании;
	Исключение
		Возврат Сценарии;
	КонецПопытки;

	Если Основания.Количество() = 0 Тогда
		Возврат Сценарии;
	КонецЕсли;

	// Создавать документ пользователь должен иметь право: иначе команда
	// «Создать на основании» ему просто не покажется
	Если Не ЕстьПравоНаОбъект("ИнтерактивноеДобавление", МО, ПользовательИБ) Тогда
		Возврат Сценарии;
	КонецЕсли;

	Для Каждого Основание Из Основания Цикл

		Если Не ЕстьПравоНаОбъект("Просмотр", Основание, ПользовательИБ) Тогда
			Продолжить;
		КонецЕсли;

		Шаги = Новый Массив;

		// На основании вводят проведённый документ: с черновика конфигурация
		// либо откажет, либо заполнит новый документ мусором. Ищем основание
		// запросом при прогоне — зашитая ссылка не пережила бы перезаливку данных
		ДобавитьПоискОбъектаДляПечати(Шаги, ОписаниеОснования(Основание), Настройки, "СсылкаОснования");

		Шаги.Добавить("Если переменная ""ЕстьЧтоПечатать"" имеет значение ""Да"" Тогда");
		Шаги.Добавить(Символы.Таб + Шаг(Настройки, "ОткрытьСсылку", "$СсылкаОснования$"));
		Шаги.Добавить(Символы.Таб
			+ ШагОжиданияФормы(Настройки, ИмяОсновнойФормы(Основание, "ОсновнаяФормаОбъекта")));
		Шаги.Добавить(Символы.Таб + Шаг(Настройки, "НажатьКнопку", "Создать на основании"));
		Шаги.Добавить(Символы.Таб + Шаг(Настройки, "ПунктМеню", БезопасныйШаблон(СтрокаКарты.Синоним)));
		// Форма нового документа заполняется данными основания — ждём именно её
		Шаги.Добавить(Символы.Таб
			+ ШагОжиданияФормы(Настройки, ИмяОсновнойФормы(МО, "ОсновнаяФормаОбъекта")));
		Шаги.Добавить(Шаг(Настройки, "ЗакрытьОкна"));
		// Заполненная на основании форма считается изменённой и спрашивает про запись
		Шаги.Добавить(Шаг(Настройки, "ЕслиПредупреждение"));
		Шаги.Добавить(Символы.Таб + Шаг(Настройки, "ЗакрытьПредупреждение"));
		Шаги.Добавить(Символы.Таб + Шаг(Настройки, "ЗакрытьОкна"));

		Сценарии.Добавить(НовыйСценарий(
			ЗаголовокСценария(Настройки, "НаОсновании", СтрокаКарты, Основание.Синоним),
			ТегиСценария(СтрокаКарты, "НаОсновании"),
			Шаги,
			Истина));

	КонецЦикла;

	Возврат Сценарии;

КонецФункции

// У-06. Делит сценарии группы на читающие и пишущие.
//
// Возвращаемое значение:
//  Массив из Структура - Сценарии, Суффикс, ИзменяетДанные.
Функция РазделитьСценарииПоВлияниюНаДанные(Сценарии, Настройки)

	Части = Новый Массив;

	Если Не Настройки.ОтделятьПишущиеСценарии Тогда
		Части.Добавить(ЧастьНабора(Сценарии, "", Ложь));
		Возврат Части;
	КонецЕсли;

	Читающие = Новый Массив;
	Пишущие  = Новый Массив;

	Для Каждого Сценарий Из Сценарии Цикл
		ИзменяетДанные = Ложь;
		Сценарий.Свойство("ИзменяетДанные", ИзменяетДанные);
		Если ИзменяетДанные = Истина Тогда
			Пишущие.Добавить(Сценарий);
		Иначе
			Читающие.Добавить(Сценарий);
		КонецЕсли;
	КонецЦикла;

	Части.Добавить(ЧастьНабора(Читающие, "", Ложь));
	Части.Добавить(ЧастьНабора(Пишущие, " (изменяет данные)", Истина));

	Возврат Части;

КонецФункции

Функция ЧастьНабора(Сценарии, Суффикс, ИзменяетДанные)

	Часть = Новый Структура;
	Часть.Вставить("Сценарии",       Сценарии);
	Часть.Вставить("Суффикс",        Суффикс);
	Часть.Вставить("ИзменяетДанные", ИзменяетДанные);

	Возврат Часть;

КонецФункции

// У-08. Раскладывает файлы набора по подкаталогам «поток-N». Балансируем по числу
// сценариев, а не файлов: раздел «Склад» один стоит трёх мелких.
Процедура РазложитьПоПотокам(Результат, Настройки)

	Потоков = 1;
	Настройки.Свойство("ПотоковПрогона", Потоков);
	Потоков = ?(Потоков = Неопределено, 1, Цел(Потоков));

	Если Потоков < 2 Или Результат.Файлы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Потоков = Мин(Потоков, Результат.Файлы.Количество());

	// Самые тяжёлые файлы раскладываем первыми — так потоки заканчивают вместе
	Порядок = Новый ТаблицаЗначений;
	Порядок.Колонки.Добавить("Индекс",    Новый ОписаниеТипов("Число"));
	Порядок.Колонки.Добавить("Сценариев", Новый ОписаниеТипов("Число"));

	Для Индекс = 0 По Результат.Файлы.Количество() - 1 Цикл
		Строка = Порядок.Добавить();
		Строка.Индекс    = Индекс;
		Строка.Сценариев = Результат.Файлы[Индекс].Сценариев;
	КонецЦикла;

	Порядок.Сортировать("Сценариев Убыв");

	Нагрузка = Новый Массив;
	Для Поток = 1 По Потоков Цикл
		Нагрузка.Добавить(0);
	КонецЦикла;

	Для Каждого Строка Из Порядок Цикл

		// Кладём в самый свободный поток
		Легчайший = 0;
		Для Поток = 1 По Потоков - 1 Цикл
			Если Нагрузка[Поток] < Нагрузка[Легчайший] Тогда
				Легчайший = Поток;
			КонецЕсли;
		КонецЦикла;

		Нагрузка[Легчайший] = Нагрузка[Легчайший] + Строка.Сценариев;

		ОписаниеФайла = Результат.Файлы[Строка.Индекс];
		ОписаниеФайла.ИмяФайла = "поток-" + Формат(Легчайший + 1, "ЧГ=0")
			+ ПолучитьРазделительПути() + ОписаниеФайла.ИмяФайла;

	КонецЦикла;

	Сводка = Новый Массив;
	Для Поток = 0 По Потоков - 1 Цикл
		Сводка.Добавить("поток-" + Формат(Поток + 1, "ЧГ=0") + ": " + Нагрузка[Поток]);
	КонецЦикла;

	Результат.Лог.Добавить("Набор разложен на " + Потоков + " потоков — "
		+ СтрСоединить(Сводка, ", ") + ".");

КонецПроцедуры

// У-09. Покрытие интерфейса: строка на объект конфигурации с ответом на вопрос
// «есть ли он в наборе, а если нет — почему».
Функция ТаблицаПокрытияИнтерфейса()

	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Раздел",    Новый ОписаниеТипов("Строка"));
	Таблица.Колонки.Добавить("Процесс",   Новый ОписаниеТипов("Строка"));
	Таблица.Колонки.Добавить("Вид",       Новый ОписаниеТипов("Строка"));
	Таблица.Колонки.Добавить("ПолноеИмя", Новый ОписаниеТипов("Строка"));
	Таблица.Колонки.Добавить("Синоним",   Новый ОписаниеТипов("Строка"));
	Таблица.Колонки.Добавить("Покрыт",    Новый ОписаниеТипов("Булево"));
	Таблица.Колонки.Добавить("Сценариев", Новый ОписаниеТипов("Число"));
	Таблица.Колонки.Добавить("Причина",   Новый ОписаниеТипов("Строка"));

	Возврат Таблица;

КонецФункции

Процедура ОтметитьПокрытие(Покрытие, СтрокаКарты, РазделыКомандногоИнтерфейса,
	Покрыт, Причина, Сценариев = 0)

	Раздел = РазделыКомандногоИнтерфейса[СтрокаКарты.ПолноеИмя];

	Строка = Покрытие.Добавить();
	Строка.Раздел    = ?(Раздел = Неопределено, "Вне разделов", Раздел);
	Строка.Процесс   = СтрокаКарты.Процесс;
	Строка.Вид       = СтрокаКарты.Вид;
	Строка.ПолноеИмя = СтрокаКарты.ПолноеИмя;
	Строка.Синоним   = СтрокаКарты.Синоним;
	Строка.Покрыт    = Покрыт;
	Строка.Сценариев = Сценариев;
	Строка.Причина   = Причина;

КонецПроцедуры

// У-09. Сводка покрытия по разделам — то, что попадает в лог и в отчёт.
Функция СводкаПокрытияИнтерфейса(Покрытие) Экспорт

	Строки = Новый Массив;

	Если Покрытие.Количество() = 0 Тогда
		Возврат Строки;
	КонецЕсли;

	Всего = Покрытие.Количество();
	Покрыто = Покрытие.НайтиСтроки(Новый Структура("Покрыт", Истина)).Количество();

	Строки.Добавить("Покрытие интерфейса: " + Покрыто + " из " + Всего + " объектов ("
		+ Формат(Покрыто / Всего * 100, "ЧДЦ=1; ЧН=0") + " %).");

	Итоги = Покрытие.Скопировать(, "Раздел");
	Итоги.Свернуть("Раздел");
	Итоги.Сортировать("Раздел");

	Для Каждого СтрокаИтога Из Итоги Цикл

		ВРазделе = Покрытие.НайтиСтроки(Новый Структура("Раздел", СтрокаИтога.Раздел));
		ПокрытоВРазделе = 0;
		Для Каждого Строка Из ВРазделе Цикл
			ПокрытоВРазделе = ПокрытоВРазделе + ?(Строка.Покрыт, 1, 0);
		КонецЦикла;

		Строки.Добавить("  " + СтрокаИтога.Раздел + ": " + ПокрытоВРазделе
			+ " из " + ВРазделе.Количество());

	КонецЦикла;

	Возврат Строки;

КонецФункции

// У-09. Отчёт покрытия в Markdown: его удобно и в репозитории смотреть,
// и в merge request приложить.
Функция ОтчетПокрытияИнтерфейса(Покрытие) Экспорт

	Строки = Новый Массив;
	Строки.Добавить("# Покрытие интерфейса UI-сценариями");
	Строки.Добавить("");
	Строки.Добавить("Сформировано: " + Формат(ТекущаяДата(), "ДФ='dd.MM.yyyy HH:mm'")
		+ ", конфигурация " + Метаданные.Синоним + " " + Метаданные.Версия + ".");
	Строки.Добавить("");

	Для Каждого СтрокаСводки Из СводкаПокрытияИнтерфейса(Покрытие) Цикл
		Строки.Добавить(СтрокаСводки);
	КонецЦикла;

	Строки.Добавить("");
	Строки.Добавить("## Объекты вне набора");
	Строки.Добавить("");
	Строки.Добавить("| Раздел | Объект | Почему не покрыт |");
	Строки.Добавить("| --- | --- | --- |");

	Непокрытые = Покрытие.НайтиСтроки(Новый Структура("Покрыт", Ложь));

	Для Каждого Строка Из Непокрытые Цикл
		Строки.Добавить("| " + Строка.Раздел + " | " + Строка.ПолноеИмя
			+ " | " + Строка.Причина + " |");
	КонецЦикла;

	Если Непокрытые.Количество() = 0 Тогда
		Строки.Добавить("| — | — | все объекты попали в набор |");
	КонецЕсли;

	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

// У-10. Шаблоны шагов. Vanessa поставляется с русской и английской библиотеками,
// и конфигурация с английским интерфейсом требует второго набора формулировок.
//
// Параметры:
//  Настройки - Структура - нужен ЯзыкШагов.
//  Ключ      - Строка    - какой шаг нужен.
//  Значение  - Строка    - подставляется вместо %1.
Функция Шаг(Настройки, Ключ, Значение = "", Таймаут = 0) Экспорт

	Язык = "ru";
	Настройки.Свойство("ЯзыкШагов", Язык);
	Язык = ?(ПустаяСтрока(Язык), "ru", НРег(Язык));

	Шаблоны = ШаблоныШагов(Язык);
	Шаблон = Шаблоны[Ключ];

	Если Шаблон = Неопределено Тогда
		// Неизвестный ключ лучше увидеть в файле, чем получить пустую строку
		Возврат "# неизвестный шаг: " + Ключ;
	КонецЕсли;

	Если Таймаут <= 0 Тогда
		Таймаут = 8;
		Настройки.Свойство("ТаймаутОжидания", Таймаут);
		Таймаут = ?(Таймаут = Неопределено Или Таймаут <= 0, 8, Цел(Таймаут));
	КонецЕсли;

	Результат = СтрЗаменить(Шаблон, "%1", Значение);

	Возврат СтрЗаменить(Результат, "%2", Формат(Таймаут, "ЧГ=0"));

КонецФункции

// Ожидание открытия формы вместо паузы: если имя формы известно — ждём именно её,
// иначе ждём любое окно, отличное от текущего. Фиксированная пауза остаётся только
// там, где ждать нечего.
// Действие, после которого должно появиться окно, но какое именно — неизвестно:
// форма, отказ конфигурации или предупреждение. Запоминаем текущее окно до действия
// и ждём появления любого другого — сценарий продолжится сразу после реакции.
Процедура ДобавитьОжиданиеНовогоОкна(Шаги, Настройки, ШагДействия)

	Если Настройки = Неопределено Тогда
		Шаги.Добавить(ШагДействия);
		Шаги.Добавить("И Пауза 2");
		Возврат;
	КонецЕсли;

	Шаги.Добавить(Шаг(Настройки, "ЗапомнитьОкно"));
	Шаги.Добавить(ШагДействия);
	Шаги.Добавить(Шаг(Настройки, "ЖдуДругоеОкно"));

КонецПроцедуры

Функция ШагОжиданияФормы(Настройки, ИмяФормы)

	Если ПустаяСтрока(ИмяФормы) Тогда
		Возврат Шаг(Настройки, "ЖдуДругоеОкно");
	КонецЕсли;

	Возврат Шаг(Настройки, "ЖдуФормуПоИмени", ИмяФормы);

КонецФункции

