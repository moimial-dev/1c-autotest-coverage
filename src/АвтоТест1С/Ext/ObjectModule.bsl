// У-10. Заголовок сценария на языке набора.
Функция ЗаголовокСценария(Настройки, ВидПроверки, СтрокаКарты, Дополнение = "")

	Язык = "ru";
	Настройки.Свойство("ЯзыкШагов", Язык);
	Язык = ?(ПустаяСтрока(Язык), "ru", НРег(Язык));

	Если Язык = "en" Тогда

		Если ВидПроверки = "Печать" Тогда
			Возврат "UI. " + СтрокаКарты.ПолноеИмя + " — print form «" + Дополнение + "» opens";
		КонецЕсли;

		Возврат "UI. " + СтрокаКарты.ПолноеИмя + " — created on the basis of " + Дополнение;

	КонецЕсли;

	Если ВидПроверки = "Печать" Тогда
		Возврат "UI. " + ПредставлениеВида(СтрокаКарты.Вид) + " «" + СтрокаКарты.Синоним
			+ "» — печатная форма «" + Дополнение + "» открывается";
	КонецЕсли;

	Возврат "UI. " + ПредставлениеВида(СтрокаКарты.Вид) + " «" + СтрокаКарты.Синоним
		+ "» — вводится на основании «" + Дополнение + "»";

КонецФункции

// Имя файла набора. По разделам — то, что пользователь видит в панели разделов
// («Закупки», «Склад»); по процессам — язык заказчика («Продажа и касса»);
// иначе — вид объекта. Раздел точнее прочего отвечает на вопрос «где это в меню».
Функция ИмяГруппыНабора(СтрокаКарты, Настройки, РазделыКомандногоИнтерфейса)

	Если Настройки.ГруппироватьПоРазделам Тогда

		Раздел = РазделыКомандногоИнтерфейса[СтрокаКарты.ПолноеИмя];
		Если Раздел <> Неопределено Тогда
			Возврат Раздел;
		КонецЕсли;

		// Объекты вне разделов (регистры, служебные справочники) собираем отдельно:
		// в меню их нет, но проверить открытие списка по ссылке всё равно полезно
		Возврат "Вне разделов";

	КонецЕсли;

	Если Настройки.ГруппироватьПоПроцессам Тогда
		Возврат СтрокаКарты.Процесс;
	КонецЕсли;

	Возврат ПредставлениеВида(СтрокаКарты.Вид);

КонецФункции

// У-07. Объекты, отключённые выключенными функциональными опциями.
// Опция хранится в константе: если она выключена, весь её состав в интерфейсе скрыт.
//
// Возвращаемое значение:
//  Соответствие - ключ «полное имя объекта», значение — имя опции, из-за которой он скрыт.
Функция ОбъектыОтключенныеФункциональнымиОпциями(Настройки) Экспорт

	Отключенные = Новый Соответствие;

	Если Не Настройки.УчитыватьФункциональныеОпции Тогда
		Возврат Отключенные;
	КонецЕсли;

	Для Каждого Опция Из Метаданные.ФункциональныеОпции Цикл

		Если ОпцияВключена(Опция) Тогда
			Продолжить;
		КонецЕсли;

		Для Каждого ЭлементСостава Из Опция.Состав Цикл
			Если ЭлементСостава.Объект <> Неопределено Тогда
				Отключенные.Вставить(ЭлементСостава.Объект.ПолноеИмя(), Опция.Имя);
			КонецЕсли;
		КонецЦикла;

	КонецЦикла;

	Возврат Отключенные;

КонецФункции

// Значение опции читаем из её хранилища. Опции с разделителями (зависящие от
// организации или склада) считаем включёнными: их значение зависит от данных,
// и отсеивать по ним объекты было бы неверно.
Функция ОпцияВключена(Опция)

	Если Опция.Хранение = Неопределено Тогда
		Возврат Истина;
	КонецЕсли;

	// Опция может зависеть от параметров (организации, склада) — тогда
	// ПолучитьФункциональнуюОпцию без параметров вызовет исключение. Такие опции
	// считаем включёнными: их значение зависит от данных, и отсеивать по ним объекты
	// было бы неверно
	Попытка
		Значение = ПолучитьФункциональнуюОпцию(Опция.Имя);
	Исключение
		Возврат Истина;
	КонецПопытки;

	Возврат Значение <> Ложь;

КонецФункции

// Читает исключения из каталога txt-файлов. Формат тот же, что у генератора
// дымовых тестов Vanessa: имя файла начинается с вида объекта («Справочники.txt»),
// строка — один исключаемый объект, пустые строки и строки с «//» пропускаются.
//
// Строка: ИмяОбъекта[.ТипПроверки], где ТипПроверки — Список, Создание, Форма
// или КомандныйИнтерфейс. Без типа исключается объект целиком. В конце имени
// допускается «*»: «Присоединенные*» закроет все присоединённые файлы разом.
//
// Возвращаемое значение:
//  Соответствие - ключ «Вид|Имя[|ТипПроверки]», значение Истина.
Функция ПрочитатьИсключения(Каталог, Лог = Неопределено) Экспорт

	Исключения = Новый Соответствие;

	Если ПустаяСтрока(Каталог) Тогда
		Возврат Исключения;
	КонецЕсли;

	ОбъектКаталога = Новый Файл(Каталог);
	Если Не ОбъектКаталога.Существует() Тогда
		Если Лог <> Неопределено Тогда
			Лог.Добавить("Каталог исключений «" + Каталог + "» не найден — исключения не применялись.");
		КонецЕсли;
		Возврат Исключения;
	КонецЕсли;

	СоответствиеВидов = СоответствиеИменФайловВидам();
	Файлы = НайтиФайлы(Каталог, "*.txt", Ложь);
	Прочитано = 0;

	Для Каждого Файл Из Файлы Цикл

		Вид = ВидОбъектаПоИмениФайла(Файл.ИмяБезРасширения, СоответствиеВидов);
		Если Вид = Неопределено Тогда
			Если Лог <> Неопределено Тогда
				Лог.Добавить("Файл исключений «" + Файл.Имя + "» пропущен: имя должно начинаться с вида объекта.");
			КонецЕсли;
			Продолжить;
		КонецЕсли;

		Чтение = Новый ЧтениеТекста(Файл.ПолноеИмя, КодировкаТекста.UTF8);
		Строка = Чтение.ПрочитатьСтроку();

		Пока Строка <> Неопределено Цикл

			Значение = СокрЛП(Строка);
			Строка = Чтение.ПрочитатьСтроку();

			Если ПустаяСтрока(Значение) Или СтрНачинаетсяС(Значение, "//") Тогда
				Продолжить;
			КонецЕсли;

			Исключения.Вставить(Вид + "|" + НРег(Значение), Истина);
			Прочитано = Прочитано + 1;

		КонецЦикла;

		Чтение.Закрыть();

	КонецЦикла;

	Если Лог <> Неопределено И Прочитано > 0 Тогда
		Лог.Добавить("Исключений прочитано: " + Прочитано + " из " + Файлы.Количество() + " файлов.");
	КонецЕсли;

	Возврат Исключения;

КонецФункции

// Исключён ли объект целиком (ТипПроверки = "") или конкретная проверка.
Функция ОбъектИсключен(Исключения, СтрокаКарты, ТипПроверки) Экспорт

	Если Исключения.Количество() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;

	Имя = НРег(СтрокаКарты.Имя);
	Ключ = ?(ПустаяСтрока(ТипПроверки), Имя, Имя + "." + НРег(ТипПроверки));

	Если Исключения[СтрокаКарты.Вид + "|" + Ключ] <> Неопределено Тогда
		Возврат Истина;
	КонецЕсли;

	// Маски вида «Присоединенные*» разбираем перебором: их немного, а список
	// объектов конфигурации обходится один раз за генерацию
	Для Каждого Элемент Из Исключения Цикл

		Части = СтрРазделить(Элемент.Ключ, "|", Истина);
		Если Части.Количество() < 2 Или Части[0] <> СтрокаКарты.Вид Тогда
			Продолжить;
		КонецЕсли;

		Шаблон = Части[1];
		Если СтрНайти(Шаблон, "*") = 0 Тогда
			Продолжить;
		КонецЕсли;

		Если СтрокаСоответствуетШаблонуИсключения(Ключ, Шаблон) Тогда
			Возврат Истина;
		КонецЕсли;

	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Обёртка для проверок: считает, сколько раз исключение сработало.
Функция ПроверкаИсключена(Исключения, СтрокаКарты, ТипПроверки, ПропущеноПоИсключениям)

	Если ОбъектИсключен(Исключения, СтрокаКарты, ТипПроверки) Тогда
		ПропущеноПоИсключениям = ПропущеноПоИсключениям + 1;
		Возврат Истина;
	КонецЕсли;

	Возврат Ложь;

КонецФункции

// Звёздочка допускается в любом месте шаблона: «Присоединенные*» закроет объекты
// по началу имени, «*ПрисоединенныеФайлы» — по концу (имена вида
// «НоменклатураПрисоединенныеФайлы»), «*Файлы*» — по вхождению.
Функция СтрокаСоответствуетШаблонуИсключения(Значение, Шаблон)

	Если Шаблон = "*" Тогда
		Возврат Истина;
	КонецЕсли;

	СвободноеНачало = СтрНачинаетсяС(Шаблон, "*");
	СвободныйКонец  = СтрЗаканчиваетсяНа(Шаблон, "*");

	Части = СтрРазделить(Шаблон, "*", Ложь);
	Если Части.Количество() = 0 Тогда
		Возврат Истина;
	КонецЕсли;

	ТекущаяПозиция = 1;

	Для Индекс = 0 По Части.ВГраница() Цикл

		Часть = Части[Индекс];
		Если ПустаяСтрока(Часть) Тогда
			Продолжить;
		КонецЕсли;

		Найдено = СтрНайти(Значение, Часть, НаправлениеПоиска.СНачала, ТекущаяПозиция);
		Если Найдено = 0 Тогда
			Возврат Ложь;
		КонецЕсли;

		Если Индекс = 0 И Не СвободноеНачало И Найдено <> 1 Тогда
			Возврат Ложь;
		КонецЕсли;

		ТекущаяПозиция = Найдено + СтрДлина(Часть);

	КонецЦикла;

	Если Не СвободныйКонец И ТекущаяПозиция <> СтрДлина(Значение) + 1 Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат Истина;

КонецФункции

Функция СоответствиеИменФайловВидам()

	Соответствие = Новый Соответствие;
	Соответствие.Вставить("справочники",             "Справочник");
	Соответствие.Вставить("документы",               "Документ");
	Соответствие.Вставить("регистрысведений",        "РегистрСведений");
	Соответствие.Вставить("регистрынакопления",      "РегистрНакопления");
	Соответствие.Вставить("регистрыбухгалтерии",     "РегистрБухгалтерии");
	Соответствие.Вставить("планывидовхарактеристик", "ПланВидовХарактеристик");
	Соответствие.Вставить("планысчетов",             "ПланСчетов");
	Соответствие.Вставить("планыобмена",             "ПланОбмена");
	Соответствие.Вставить("бизнеспроцессы",          "БизнесПроцесс");
	Соответствие.Вставить("задачи",                  "Задача");
	Соответствие.Вставить("отчеты",                  "Отчет");
	Соответствие.Вставить("обработки",               "Обработка");

	Возврат Соответствие;

КонецФункции

// Имя файла должно начинаться с вида объекта, остальное — произвольно:
// так один вид можно разложить по нескольким файлам («Справочники БСП.txt»)
Функция ВидОбъектаПоИмениФайла(ИмяФайла, СоответствиеВидов)

	Имя = НРег(СокрЛП(ИмяФайла));

	Для Каждого Элемент Из СоответствиеВидов Цикл
		Если СтрНачинаетсяС(Имя, Элемент.Ключ) Тогда
			Возврат Элемент.Значение;
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

// Возвращает массив сценариев (структур Заголовок, Теги, Шаги) для одного объекта.
Функция СценарииДляОбъекта(СтрокаКарты, Настройки, РазделыКомандногоИнтерфейса,
	Исключения, ПропущеноПоИсключениям, СлепокФорм = Неопределено, ПользовательИБ = Неопределено)

	Сценарии = Новый Массив;

	МО = Метаданные.НайтиПоПолномуИмени(СтрокаКарты.ПолноеИмя);
	Если МО = Неопределено Тогда
		Возврат Сценарии;
	КонецЕсли;

	Вид = СтрокаКарты.Вид;

	Если Вид = "Отчет" Тогда

		Если Настройки.ПроверятьОтчеты
			И ЕстьПравоНаОбъект("Использование", МО, ПользовательИБ)
			И Не ПроверкаИсключена(Исключения, СтрокаКарты, "Форма", ПропущеноПоИсключениям) Тогда
			Сценарии.Добавить(СценарийОткрытияОбъекта(СтрокаКарты, МО, Настройки));
		КонецЕсли;

	ИначеЕсли Вид = "Обработка" Тогда

		Если Настройки.ПроверятьОбработки
			И ЕстьПравоНаОбъект("Использование", МО, ПользовательИБ)
			И Не ПроверкаИсключена(Исключения, СтрокаКарты, "Форма", ПропущеноПоИсключениям) Тогда
			Сценарии.Добавить(СценарийОткрытияОбъекта(СтрокаКарты, МО, Настройки));
		КонецЕсли;

	ИначеЕсли Вид = "Константа" Тогда

		// У константы нет собственного списка — проверять нечего

	ИначеЕсли ЭтоРегистр(Вид) Тогда

		Если Настройки.ПроверятьРегистры И Настройки.ПроверятьСписки
			И Не ПроверкаИсключена(Исключения, СтрокаКарты, "Список", ПропущеноПоИсключениям) Тогда
			Сценарии.Добавить(СценарийСписка(СтрокаКарты, МО, Настройки, СлепокФорм));
		КонецЕсли;

	Иначе

		Если Настройки.ПроверятьСписки
			И Не ПроверкаИсключена(Исключения, СтрокаКарты, "Список", ПропущеноПоИсключениям) Тогда
			Сценарии.Добавить(СценарийСписка(СтрокаКарты, МО, Настройки, СлепокФорм));
		КонецЕсли;

		// У подчинённых объектов форма нового элемента по ссылке не открывается:
		// платформе нужен владелец, и вместо формы остаётся начальная страница
		// «Недостаточно прав для создания»: чтение объекта ещё не даёт права
		// добавлять. Маркетолог видит список номенклатуры, но создать её не может
		Если Настройки.ПроверятьСозданиеФорм
			И ЕстьПравоНаОбъект("ИнтерактивноеДобавление", МО, ПользовательИБ)
			И Не ЭтоПодчиненныйОбъект(МО)
			И Не ПроверкаИсключена(Исключения, СтрокаКарты, "Создание", ПропущеноПоИсключениям) Тогда
			Сценарии.Добавить(СценарийСозданияЭлемента(СтрокаКарты, МО, СлепокФорм, Настройки));
		КонецЕсли;

		// У-05. Печать: макеты есть — значит у объекта должна быть команда печати.
		// Печатать можно только существующий объект, поэтому сценарий сначала
		// проверяет, что в списке вообще есть строки
		// Собственные макеты объекта ни о чём не говорят: печать может идти
		// и по общим макетам БСП. Единственный надёжный признак — команда печати
		Если Настройки.ПроверятьПечать
			И ЕстьПравоНаОбъект("Просмотр", МО, ПользовательИБ)
			И Не ПроверкаИсключена(Исключения, СтрокаКарты, "Печать", ПропущеноПоИсключениям) Тогда
			СценарийПечатиОбъекта = СценарийПечати(СтрокаКарты, МО, Настройки);
			Если СценарийПечатиОбъекта <> Неопределено Тогда
				Сценарии.Добавить(СценарийПечатиОбъекта);
			КонецЕсли;
		КонецЕсли;

		// У-05. Ввод на основании: проверяем со стороны основания — так же,
		// как это делает пользователь, из формы исходного объекта
		Если Настройки.ПроверятьВводНаОсновании
			И Не ПроверкаИсключена(Исключения, СтрокаКарты, "НаОсновании", ПропущеноПоИсключениям) Тогда

			Для Каждого Сценарий Из СценарииВводаНаОсновании(СтрокаКарты, МО, Настройки, ПользовательИБ) Цикл
				Сценарии.Добавить(Сценарий);
			КонецЦикла;

		КонецЕсли;

	КонецЕсли;

	// Навигационная ссылка открывает форму в обход меню, поэтому неверная команда
	// раздела так и останется незамеченной. Этот сценарий проходит тем же путём,
	// что и пользователь: панель разделов → панель функций
	Если Настройки.ПроверятьКоманды И ЕстьКомандаВПанелиФункций(Вид)
		И Не ПроверкаИсключена(Исключения, СтрокаКарты, "КомандныйИнтерфейс", ПропущеноПоИсключениям) Тогда

		Раздел = РазделыКомандногоИнтерфейса[СтрокаКарты.ПолноеИмя];
		Если Раздел <> Неопределено Тогда
			Сценарии.Добавить(СценарийКомандногоИнтерфейса(СтрокаКарты, МО, Раздел, Настройки));
		КонецЕсли;

	КонецЕсли;

	Возврат Сценарии;

КонецФункции

Функция СценарийСписка(СтрокаКарты, МО, Настройки, СлепокФорм = Неопределено)

	Если Настройки.ОбучающийНабор Тогда
		Возврат СценарийОбучения(СтрокаКарты, Настройки);
	КонецЕсли;

	Шаги = Новый Массив;
	ИмяФормыСписка = ИмяФормыДляПроверки(СлепокФорм, СтрокаКарты.ПолноеИмя, "Список", МО, "ОсновнаяФормаСписка");

	Шаги.Добавить("Дано Я открываю навигационную ссылку ""e1cib/list/" + СтрокаКарты.ПолноеИмя + """");
	// Ждём форму, а не фиксированные секунды: список открывается за доли секунды,
	// а пауза стоила бы своих двух на каждом из сотен сценариев
	Шаги.Добавить(ШагОжиданияФормы(Настройки, ИмяФормыСписка));
	Шаги.Добавить(ШагПроверкиФормы(ИмяФормыСписка, ШаблонЗаголовкаСписка(МО, СтрокаКарты)));

	// У-01. Пустой список — законное состояние чистой базы, но на рабочих данных
	// он означает неудавшийся обмен или миграцию, поэтому проверка включается флажком
	Если Настройки.ПроверятьНепустыеСписки Тогда
		// Динамический список наполняется асинхронно: проверка сразу после открытия
		// ловила бы ещё пустую таблицу
		Шаги.Добавить(Шаг(Настройки, "ЖдуСтроки"));
	КонецЕсли;

	Шаги.Добавить("И я закрываю все окна клиентского приложения");

	Заголовок = "UI. " + ПредставлениеВида(СтрокаКарты.Вид) + " «" + СтрокаКарты.Синоним
		+ ?(Настройки.ПроверятьНепустыеСписки, "» — список открывается и не пуст", "» — список открывается");

	Возврат НовыйСценарий(Заголовок, ТегиСценария(СтрокаКарты, "Список"), Шаги);

КонецФункции

Функция СценарийСозданияЭлемента(СтрокаКарты, МО, СлепокФорм = Неопределено, Настройки = Неопределено)

	Шаги = Новый Массив;
	// Форму нового объекта открываем ссылкой, а не кнопкой списка: кнопка ищется
	// в активном окне, и любой оставшийся от предыдущего сценария диалог ломает шаг
	// Что откроется — форма или отказ «только на основании» — заранее неизвестно,
	// поэтому ждём не конкретную форму, а любое новое окно: так сценарий идёт дальше
	// сразу после реакции системы, а не досиживает фиксированную паузу
	ДобавитьОжиданиеНовогоОкна(Шаги, Настройки,
		"Дано Я открываю навигационную ссылку ""e1cib/data/" + СтрокаКарты.ПолноеИмя + """");
	// Часть объектов запрещено вводить вручную («только на основании…»), и вместо
	// формы конфигурация показывает предупреждение. Это штатное поведение,
	// а не дефект интерфейса, поэтому такой ответ считается пройденной проверкой
	Шаги.Добавить("Если появилось окно с заголовком '1С:Предприятие' Тогда");
	Шаги.Добавить(Символы.Таб + "И я закрываю окно предупреждения");
	Шаги.Добавить("Иначе");
	// Заголовок новой формы складывается из представления объекта и данных, поэтому
	// сверяем имя формы: оно от данных не зависит. Если основная форма не задана,
	// остаётся пометка платформы «(создание)» в заголовке
	Шаги.Добавить(Символы.Таб + ШагПроверкиФормы(
		ИмяФормыДляПроверки(СлепокФорм, СтрокаКарты.ПолноеИмя, "Создание", МО, "ОсновнаяФормаОбъекта"), "*(создание)*"));
	Шаги.Добавить("И я закрываю все окна клиентского приложения");
	// Пустую форму платформа закрывает молча, но отдельные формы заполняют себя
	// при открытии и спрашивают про сохранение — снимаем и этот диалог
	Шаги.Добавить("Если появилось окно с заголовком '1С:Предприятие' Тогда");
	Шаги.Добавить(Символы.Таб + "И я закрываю окно предупреждения");
	Шаги.Добавить(Символы.Таб + "И я закрываю все окна клиентского приложения");

	Возврат НовыйСценарий(
		"UI. " + ПредставлениеВида(СтрокаКарты.Вид) + " «" + СтрокаКарты.Синоним + "» — форма создания открывается",
		ТегиСценария(СтрокаКарты, "Создание"),
		Шаги);

КонецФункции

Функция СценарийОткрытияОбъекта(СтрокаКарты, МО, Настройки = Неопределено)

	// Автоформа отчёта называется «Отчет.<Имя>.ФормаОбъекта», а заголовок окна
	// платформа берёт из варианта отчёта («Ведомость по товарам на складах» →
	// «Остатки на складах»), поэтому проверять заголовок бесполезно
	ИмяФормы = ИмяОсновнойФормы(МО, "ОсновнаяФормаОтчета");
	Если ПустаяСтрока(ИмяФормы) Тогда
		ИмяФормы = ИмяОсновнойФормы(МО, "ОсновнаяФорма");
	КонецЕсли;
	Если ПустаяСтрока(ИмяФормы) Тогда
		ИмяФормы = СтрокаКарты.ПолноеИмя + ".ФормаОбъекта";
	КонецЕсли;

	Шаги = Новый Массив;
	ДобавитьОжиданиеНовогоОкна(Шаги, Настройки,
		"Дано Я открываю навигационную ссылку ""e1cib/data/" + СтрокаКарты.ПолноеИмя + """");
	// Отчёт может требовать параметр («не выбран сегмент») и вместо формы показать
	// предупреждение — это штатный отказ конфигурации, а не дефект интерфейса
	Шаги.Добавить("Если появилось окно с заголовком '1С:Предприятие' Тогда");
	Шаги.Добавить(Символы.Таб + "И я закрываю окно предупреждения");
	Шаги.Добавить("Иначе");
	Шаги.Добавить(Символы.Таб + "Тогда открылась форма с именем '" + ИмяФормы + "'");
	Шаги.Добавить("И я закрываю все окна клиентского приложения");
	Шаги.Добавить("Если появилось окно с заголовком '1С:Предприятие' Тогда");
	Шаги.Добавить(Символы.Таб + "И я закрываю окно предупреждения");
	Шаги.Добавить(Символы.Таб + "И я закрываю все окна клиентского приложения");

	Возврат НовыйСценарий(
		"UI. " + ПредставлениеВида(СтрокаКарты.Вид) + " «" + СтрокаКарты.Синоним + "» — форма открывается",
		ТегиСценария(СтрокаКарты, "Форма"),
		Шаги);

КонецФункции

Функция СценарийКомандногоИнтерфейса(СтрокаКарты, МО, Раздел, Настройки = Неопределено)

	КомандаРаздела = КомандаПанелиФункций(МО, СтрокаКарты);

	Шаги = Новый Массив;
	ДобавитьОжиданиеНовогоОкна(Шаги, Настройки,
		"И В командном интерфейсе я выбираю """ + Раздел + """ """ + КомандаРаздела + """");
	// Что именно откроется, заранее неизвестно: команда ведёт не обязательно
	// на основную форму списка (у документов ЕГАИС это «ФормаСпискаДокументов»),
	// а заголовок окна не совпадает ни с синонимом объекта, ни с подписью команды
	// («Отражение результатов пересчетов» → «Ордера на отражение результатов
	// пересчетов товаров»). Ценность сценария — в самом факте: команда есть
	// в меню и нажимается. Открытие форм проверяют сценарии по навигационным ссылкам
	Шаги.Добавить("И я закрываю все окна клиентского приложения");

	Возврат НовыйСценарий(
		"UI. " + ПредставлениеВида(СтрокаКарты.Вид) + " «" + СтрокаКарты.Синоним
			+ "» — открывается из раздела «" + Раздел + "»",
		ТегиСценария(СтрокаКарты, "КомандныйИнтерфейс"),
		Шаги);

КонецФункции

// В панели функций команда подписана представлением списка объекта, а не его
// именем: у справочника «Контрагенты» это, например, «Поставщики»
Функция КомандаПанелиФункций(МО, СтрокаКарты)

	Представление = "";

	Попытка
		Представление = СокрЛП(МО.ПредставлениеСписка);
	Исключение
		Представление = "";
	КонецПопытки;

	Если ПустаяСтрока(Представление) Тогда
		Представление = СтрокаКарты.Синоним;
	КонецЕсли;

	Возврат БезопасныйШаблон(Представление);

КонецФункции

// Соответствие «полное имя объекта» → «заголовок раздела командного интерфейса».
// Берём корневые подсистемы, включённые в командный интерфейс: именно их
// пользователь видит в панели разделов.
Функция ИндексРазделовКомандногоИнтерфейса(ПользовательОтбора = Неопределено)

	Индекс = Новый Соответствие;

	Для Каждого Подсистема Из Метаданные.Подсистемы Цикл

		Если Не Подсистема.ВключатьВКомандныйИнтерфейс Тогда
			Продолжить;
		КонецЕсли;

		Если Не РазделВиденПользователю(Подсистема, ПользовательОтбора) Тогда
			Продолжить;
		КонецЕсли;

		Раздел = ?(ПустаяСтрока(Подсистема.Синоним), Подсистема.Имя, Подсистема.Синоним);
		ЗаполнитьРазделПоСоставу(Подсистема, БезопасныйШаблон(Раздел), Индекс);

	КонецЦикла;

	Возврат Индекс;

КонецФункции

// У подсистем есть собственное право «Просмотр»: именно оно решает, увидит ли
// пользователь раздел в панели разделов. Без этой проверки сценарии командного
// интерфейса генерировались для разделов, которых у пользователя нет.
Функция РазделВиденПользователю(Подсистема, ПользовательОтбора)

	Если ПользовательОтбора = Неопределено Тогда
		Возврат Истина;
	КонецЕсли;

	Попытка
		Возврат ПравоДоступа("Просмотр", Подсистема, ПользовательОтбора);
	Исключение
		Возврат Истина;
	КонецПопытки;

КонецФункции

Процедура ЗаполнитьРазделПоСоставу(Подсистема, Раздел, Индекс)

	Для Каждого Объект Из Подсистема.Состав Цикл
		Ключ = Объект.ПолноеИмя();
		Если Индекс[Ключ] = Неопределено Тогда
			Индекс.Вставить(Ключ, Раздел);
		КонецЕсли;
	КонецЦикла;

	// Объекты вложенных подсистем попадают в панель функций того же раздела,
	// поэтому спускаемся вглубь, не меняя заголовок
	Для Каждого ВложеннаяПодсистема Из Подсистема.Подсистемы Цикл
		Если ВложеннаяПодсистема.ВключатьВКомандныйИнтерфейс Тогда
			ЗаполнитьРазделПоСоставу(ВложеннаяПодсистема, Раздел, Индекс);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// У-02. Сценарий сбора слепка: открывает список и дописывает в файл фактическое
// имя открывшейся формы. Такой набор гоняется один раз, его результат — слепок.
Функция СценарийОбучения(СтрокаКарты, Настройки)

	ПутьСлепка = ?(ПустаяСтрока(Настройки.ФайлСлепкаФорм),
		"C:\АвтоТест1С-слепок-форм.txt", Настройки.ФайлСлепкаФорм);

	Шаги = Новый Массив;
	ДобавитьОжиданиеНовогоОкна(Шаги, Настройки,
		"Дано Я открываю навигационную ссылку ""e1cib/list/" + СтрокаКарты.ПолноеИмя + """");
	Шаги.Добавить("И я запоминаю имя формы в переменную 'ИмяФормы'");
	Шаги.Добавить("И я запоминаю заголовок формы в переменную 'ЗаголовокФормы'");
	Шаги.Добавить("И я выполняю код встроенного языка (Расширение)");
	Шаги.Добавить("""""""bsl");
	Шаги.Добавить(Символы.Таб + "Запись = Новый ЗаписьТекста(""" + ПутьСлепка
		+ """, КодировкаТекста.UTF8, , Истина);");
	Шаги.Добавить(Символы.Таб + "Запись.ЗаписатьСтроку(""" + СтрокаКарты.ПолноеИмя
		+ ";Список;$ИмяФормы$;$ЗаголовокФормы$"");");
	Шаги.Добавить(Символы.Таб + "Запись.Закрыть();");
	Шаги.Добавить("""""""");
	Шаги.Добавить("И я закрываю все окна клиентского приложения");

	Возврат НовыйСценарий(
		"Обучение. " + ПредставлениеВида(СтрокаКарты.Вид) + " «" + СтрокаКарты.Синоним + "»",
		ТегиСценария(СтрокаКарты, "Обучение"),
		Шаги);

КонецФункции

// Читает слепок форм: строки «ПолноеИмя;ТипПроверки;ИмяФормы;Заголовок».
//
// Возвращаемое значение:
//  Соответствие - ключ «ПолноеИмя|ТипПроверки», значение — имя формы.
Функция ПрочитатьСлепокФорм(ПутьФайла, Лог = Неопределено) Экспорт

	Слепок = Новый Соответствие;

	Если ПустаяСтрока(ПутьФайла) Тогда
		Возврат Слепок;
	КонецЕсли;

	Файл = Новый Файл(ПутьФайла);
	Если Не Файл.Существует() Тогда
		Если Лог <> Неопределено Тогда
			Лог.Добавить("Слепок форм «" + ПутьФайла + "» не найден — имена форм берутся из метаданных.");
		КонецЕсли;
		Возврат Слепок;
	КонецЕсли;

	Чтение = Новый ЧтениеТекста(ПутьФайла, КодировкаТекста.UTF8);
	Строка = Чтение.ПрочитатьСтроку();

	Пока Строка <> Неопределено Цикл

		Значение = СокрЛП(Строка);
		Строка = Чтение.ПрочитатьСтроку();

		Если ПустаяСтрока(Значение) Или СтрНачинаетсяС(Значение, "//") Тогда
			Продолжить;
		КонецЕсли;

		Части = СтрРазделить(Значение, ";", Истина);
		Если Части.Количество() < 3 Тогда
			Продолжить;
		КонецЕсли;

		ИмяФормы = СокрЛП(Части[2]);
		Если ПустаяСтрока(ИмяФормы) Тогда
			Продолжить;
		КонецЕсли;

		Слепок.Вставить(СокрЛП(Части[0]) + "|" + НРег(СокрЛП(Части[1])), ИмяФормы);

	КонецЦикла;

	Чтение.Закрыть();

	Если Лог <> Неопределено И Слепок.Количество() > 0 Тогда
		Лог.Добавить("Слепок форм: прочитано записей — " + Слепок.Количество() + ".");
	КонецЕсли;

	Возврат Слепок;

КонецФункции

// Имя формы для проверки: сначала слепок (что открылось на самом деле),
// затем метаданные.
Функция ИмяФормыДляПроверки(СлепокФорм, ПолноеИмя, ТипПроверки, МО, ИмяСвойства)

	Если СлепокФорм <> Неопределено Тогда
		ИзСлепка = СлепокФорм[ПолноеИмя + "|" + НРег(ТипПроверки)];
		Если ИзСлепка <> Неопределено Тогда
			Возврат ИзСлепка;
		КонецЕсли;
	КонецЕсли;

	Возврат ИмяОсновнойФормы(МО, ИмяСвойства);

КонецФункции

// Проверка открытия: по имени формы, если оно известно из метаданных, иначе —
// по заголовку окна. Имя формы надёжнее: заголовок зависит от данных объекта
// и от варианта отчёта, а имя формы — нет.
Функция ШагПроверкиФормы(ИмяФормы, ШаблонЗаголовка)

	Если Не ПустаяСтрока(ИмяФормы) Тогда
		Возврат "Тогда открылась форма с именем '" + ИмяФормы + "'";
	КонецЕсли;

	Возврат "Тогда открылось окно '" + ШаблонЗаголовка + "'";

КонецФункции

// Полное имя основной формы объекта метаданных. Свойства у разных видов
// называются по-разному, а у части объектов формы вообще не заданы —
// платформа создаёт их на лету, и имени в метаданных нет.
Функция ИмяОсновнойФормы(МО, ИмяСвойства)

	Если МО = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Попытка
		Форма = МО[ИмяСвойства];
	Исключение
		Возврат "";
	КонецПопытки;

	Если Форма = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Попытка
		Возврат Форма.ПолноеИмя();
	Исключение
		Возврат "";
	КонецПопытки;

КонецФункции

Функция НовыйСценарий(Заголовок, Теги, Шаги, ИзменяетДанные = Ложь)

	Сценарий = Новый Структура;
	Сценарий.Вставить("Заголовок",      Заголовок);
	Сценарий.Вставить("Теги",           Теги);
	Сценарий.Вставить("Шаги",           Шаги);
	Сценарий.Вставить("ИзменяетДанные", ИзменяетДанные);

	Возврат Сценарий;

КонецФункции

Функция ТегиСценария(СтрокаКарты, ВидПроверки)

	Теги = Новый Массив;
	Теги.Добавить("@UI");
	Теги.Добавить("@" + ВидПроверки);
	Теги.Добавить("@Критичность" + Формат(СтрокаКарты.Критичность, "ЧЦ=1; ЧГ=0"));
	// Тег с полным именем связывает сценарий с объектом метаданных: по нему
	// отбирается прогон после точечной доработки
	Теги.Добавить("@" + ИмяТегаОбъекта(СтрокаКарты.ПолноеИмя));

	Возврат Теги;

КонецФункции

Функция ТекстФичи(ИмяГруппы, Сценарии, Настройки, ИзменяетДанные = Ложь)

	Язык = "ru";
	Настройки.Свойство("ЯзыкШагов", Язык);
	Язык = ?(ПустаяСтрока(Язык), "ru", НРег(Язык));
	Английский = (Язык = "en");

	Строки = Новый Массив;
	Строки.Добавить("#language: " + ?(Английский, "en", "ru"));
	Строки.Добавить("@tree");
	Строки.Добавить("@UI");

	// У-06. Тег на весь файл: по нему набор целиком отбирается или отсекается
	// при запуске, не разбираясь в отдельных сценариях
	Если ИзменяетДанные Тогда
		Строки.Добавить(?(Английский, "@ChangesData", "@ИзменяетДанные"));
	КонецЕсли;

	Строки.Добавить(?(Английский, "Feature: UI checks. ", "Функциональность: UI-проверки. ") + ИмяГруппы);
	Строки.Добавить("");
	Строки.Добавить("# Файл сгенерирован обработкой «АвтоТест1С» по карте объектов конфигурации.");
	Строки.Добавить("# Править вручную не нужно: при следующей генерации изменения затрутся.");

	Если ИзменяетДанные Тогда
		Строки.Добавить("# ВНИМАНИЕ: сценарии этого файла могут оставить след в данных");
		Строки.Добавить("# (заполненная на основании форма предлагает запись). На рабочей базе");
		Строки.Добавить("# и её копии набор отсекается тегом @ИзменяетДанные.");
	Иначе
		Строки.Добавить("# Каждый сценарий открывает объект интерфейсом и закрывает окна за собой,");
		Строки.Добавить("# данные не изменяются.");
	КонецЕсли;

	Строки.Добавить("");
	Строки.Добавить(?(Английский, "Background:", "Контекст:"));

	Логин = СокрЛП(Настройки.ПользовательИБ);

	Если Не ПустаяСтрока(Логин) Тогда
		// Набор собран по правам конкретного пользователя, поэтому и выполняться
		// он должен под ним: иначе проверялись бы права администратора
		ИмяКлиента = ?(ПустаяСтрока(Настройки.ПрофильКлиента), Логин, Настройки.ПрофильКлиента);
		Строки.Добавить(Символы.Таб + "И я подключаю TestClient """ + ИмяКлиента
			+ """ логин """ + Логин + """ пароль """ + Настройки.ПарольПользователя + """");
	ИначеЕсли Не ПустаяСтрока(Настройки.ПрофильКлиента) Тогда
		Строки.Добавить(Символы.Таб + "Дано я подключаю профиль TestClient """ + Настройки.ПрофильКлиента + """");
	Иначе
		Строки.Добавить(Символы.Таб + ?(Английский,
			"Given I launch TestClient opening scenario or connect an existing one",
			"Дано Я запускаю сценарий открытия TestClient или подключаю уже существующий"));
	КонецЕсли;

	Строки.Добавить(Символы.Таб + Шаг(Настройки, "ЗакрытьОкна"));

	Для Каждого Сценарий Из Сценарии Цикл

		Теги = Новый Массив;
		Для Каждого Тег Из Сценарий.Теги Цикл
			Теги.Добавить(Тег);
		КонецЦикла;

		ИзменяетДанныеСценария = Ложь;
		Сценарий.Свойство("ИзменяетДанные", ИзменяетДанныеСценария);
		Если ИзменяетДанныеСценария = Истина Тогда
			Теги.Добавить(?(Английский, "@ChangesData", "@ИзменяетДанные"));
		КонецЕсли;

		Строки.Добавить("");
		Строки.Добавить(СтрСоединить(Теги, " "));
		Строки.Добавить(?(Английский, "Scenario: ", "Сценарий: ") + Сценарий.Заголовок);

		Для Каждого Шаг Из Сценарий.Шаги Цикл
			Строки.Добавить(Символы.Таб + Шаг);
		КонецЦикла;

	КонецЦикла;

	Строки.Добавить("");

	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

// Заголовок окна списка: у объекта может быть задано представление списка,
// иначе берём синоним. Кавычки в синонимах ломают Gherkin, поэтому меняем их
// на «*» — для сравнения по шаблону этого достаточно.
Функция ШаблонЗаголовкаСписка(МО, СтрокаКарты)

	Представление = "";

	Попытка
		Представление = СокрЛП(МО.РасширенноеПредставлениеСписка);
	Исключение
		Представление = "";
	КонецПопытки;

	Если ПустаяСтрока(Представление) Тогда
		Попытка
			Представление = СокрЛП(МО.ПредставлениеСписка);
		Исключение
			Представление = "";
		КонецПопытки;
	КонецЕсли;

	Если ПустаяСтрока(Представление) Тогда
		Представление = СтрокаКарты.Синоним;
	КонецЕсли;

	Возврат БезопасныйШаблон(Представление) + "*";

КонецФункции

Функция БезопасныйШаблон(Текст)

	Результат = СтрЗаменить(СокрЛП(Текст), """", "*");
	Результат = СтрЗаменить(Результат, "'", "*");
	Результат = СтрЗаменить(Результат, "|", "*");

	Возврат Результат;

КонецФункции

// Для проверки открывшейся формы берём первое слово представления: полный
// заголовок дополняется номером, датой и пометками вида «(создание)»
Функция ПервоеСлово(Текст)

	Очищенный = БезопасныйШаблон(Текст);
	Позиция = СтрНайти(Очищенный, " ");

	Возврат ?(Позиция > 0, Лев(Очищенный, Позиция - 1), Очищенный);

КонецФункции

Функция ИмяТегаОбъекта(ПолноеИмя)

	Результат = СтрЗаменить(ПолноеИмя, ".", "_");
	Результат = СтрЗаменить(Результат, " ", "_");

	Возврат Результат;

КонецФункции

Функция КаталогИзПути(Путь)

	Позиция = СтрНайти(Путь, ПолучитьРазделительПути(), НаправлениеПоиска.СКонца);

	Возврат ?(Позиция = 0, "", Лев(Путь, Позиция - 1));

КонецФункции

Функция ИмяФайлаФичи(ИмяГруппы)

	Имя = БезопасныйШаблон(ИмяГруппы);

	НедопустимыеСимволы = "\/:*?<>";
	Для Позиция = 1 По СтрДлина(НедопустимыеСимволы) Цикл
		Имя = СтрЗаменить(Имя, Сред(НедопустимыеСимволы, Позиция, 1), " ");
	КонецЦикла;

	Имя = СокрЛП(Имя);
	Если ПустаяСтрока(Имя) Тогда
		Имя = "Прочее";
	КонецЕсли;

	Возврат "UI. " + Имя + ".feature";

КонецФункции

// Видимость команд в панели функций настраивается в конфигураторе и через
// метаданные не читается, поэтому по составу подсистемы нельзя судить, увидит
// ли команду пользователь. Справочники и документы попадают в панель почти
// всегда, а отчёты, обработки и планы видов характеристик там чаще скрыты —
// для них сценарий давал бы ложное падение
Функция ЕстьКомандаВПанелиФункций(Вид)

	Возврат Вид = "Справочник" Или Вид = "Документ";

КонецФункции

Функция ЭтоПодчиненныйОбъект(МО)

	Попытка
		Владельцы = МО.Владельцы;
	Исключение
		Возврат Ложь;
	КонецПопытки;

	Возврат Владельцы <> Неопределено И Владельцы.Количество() > 0;

КонецФункции

Функция ЭтоРегистр(Вид)

	Возврат Вид = "РегистрСведений"
		Или Вид = "РегистрНакопления"
		Или Вид = "РегистрБухгалтерии";

КонецФункции

Функция ПредставлениеВида(Вид)

	Если Вид = "Справочник" Тогда
		Возврат "Справочник";
	ИначеЕсли Вид = "Документ" Тогда
		Возврат "Документ";
	ИначеЕсли Вид = "РегистрСведений" Тогда
		Возврат "Регистр сведений";
	ИначеЕсли Вид = "РегистрНакопления" Тогда
		Возврат "Регистр накопления";
	ИначеЕсли Вид = "РегистрБухгалтерии" Тогда
		Возврат "Регистр бухгалтерии";
	ИначеЕсли Вид = "ПланВидовХарактеристик" Тогда
		Возврат "План видов характеристик";
	ИначеЕсли Вид = "ПланСчетов" Тогда
		Возврат "План счетов";
	ИначеЕсли Вид = "БизнесПроцесс" Тогда
		Возврат "Бизнес-процесс";
	ИначеЕсли Вид = "Задача" Тогда
		Возврат "Задача";
	ИначеЕсли Вид = "Отчет" Тогда
		Возврат "Отчёт";
	ИначеЕсли Вид = "Обработка" Тогда
		Возврат "Обработка";
	ИначеЕсли Вид = "ПланОбмена" Тогда
		Возврат "План обмена";
	КонецЕсли;

	Возврат Вид;

КонецФункции

#КонецОбласти
