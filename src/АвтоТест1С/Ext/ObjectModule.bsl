// Порог ложных срабатываний — открытый риск из требований: неполнота
// автоданных не должна выглядеть как дефект конфигурации.
Функция КлассифицироватьОшибку(ТекстОшибки) Экспорт

	Текст = ВРег(ТекстОшибки);

	Маркеры = Новый Массив;
	Маркеры.Добавить("НЕ ЗАПОЛНЕН");
	Маркеры.Добавить("НЕ ЗАПОЛНЕНО");
	Маркеры.Добавить("НЕ ЗАПОЛНЕНА");
	Маркеры.Добавить("ПОЛЕ НЕ ЗАПОЛНЕНО");
	Маркеры.Добавить("НЕОБХОДИМО ЗАПОЛНИТЬ");
	Маркеры.Добавить("НЕ УКАЗАН");
	Маркеры.Добавить("НЕ ВЫБРАН");

	Для Каждого Маркер Из Маркеры Цикл
		Если СтрНайти(Текст, Маркер) > 0 Тогда
			Возврат Новый Структура("Статус, Причина", "Предупреждение", "Неполные тестовые данные");
		КонецЕсли;
	КонецЦикла;

	Если СтрНайти(Текст, "НЕДОСТАТОЧНО ПРАВ") > 0 Или СтрНайти(Текст, "НАРУШЕНИЕ ПРАВ ДОСТУПА") > 0 Тогда
		Возврат Новый Структура("Статус, Причина", "Предупреждение", "Ограничение прав доступа");
	КонецЕсли;

	Возврат Новый Структура("Статус, Причина", "Ошибка", "Дефект");

КонецФункции

Функция МенеджерОбъекта(Вид, Имя)

	Если Вид = "Справочник" Тогда
		Возврат Справочники[Имя];
	ИначеЕсли Вид = "Документ" Тогда
		Возврат Документы[Имя];
	ИначеЕсли Вид = "ПланВидовХарактеристик" Тогда
		Возврат ПланыВидовХарактеристик[Имя];
	ИначеЕсли Вид = "ПланСчетов" Тогда
		Возврат ПланыСчетов[Имя];
	ИначеЕсли Вид = "БизнесПроцесс" Тогда
		Возврат БизнесПроцессы[Имя];
	ИначеЕсли Вид = "Задача" Тогда
		Возврат Задачи[Имя];
	ИначеЕсли Вид = "ПланОбмена" Тогда
		Возврат ПланыОбмена[Имя];
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

Функция СоздатьНовыйОбъект(Менеджер, Вид)

	Если Вид = "Справочник" Или Вид = "ПланВидовХарактеристик" Или Вид = "ПланОбмена" Тогда
		Возврат Менеджер.СоздатьЭлемент();
	ИначеЕсли Вид = "ПланСчетов" Тогда
		Возврат Менеджер.СоздатьСчет();
	ИначеЕсли Вид = "БизнесПроцесс" Тогда
		Возврат Менеджер.СоздатьБизнесПроцесс();
	ИначеЕсли Вид = "Задача" Тогда
		Возврат Менеджер.СоздатьЗадачу();
	КонецЕсли;

	Возврат Неопределено;

