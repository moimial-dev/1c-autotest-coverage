
////////////////////////////////////////////////////////////////////////////////
// АвтоТест1С — управляющая форма.
//
// Серверная часть прогона выполняется в модуле объекта, обход интерфейса
// (FR-02) — здесь, на клиенте: только клиентский контекст умеет создавать
// управляемые формы и ловить исключения их модулей.
//
// Порядок работы:
//   1. «Только карта объектов» — быстрое автообнаружение метаданных (FR-01).
//   2. «Сохранить снимок конфигурации» — фиксация структуры «до» доработки.
//   3. «Выполнить прогон» — полное автопокрытие, риск-карта, покрытие.
//   4. «Сохранить отчёты» — JSON для CI/CD, HTML для бизнеса, MXL для печати.
//
// ВАЖНО: имена процедур не должны совпадать с глобальными свойствами платформы,
// иначе модуль формы не компилируется в рантайме без внятной диагностики.
////////////////////////////////////////////////////////////////////////////////

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Настройки = РеквизитФормыВЗначение("Объект").НастройкиПрогона();

	ПроверятьСправочники        = Настройки.ПроверятьСправочники;
	ПроверятьДокументы          = Настройки.ПроверятьДокументы;
	ПроводитьДокументы          = Настройки.ПроводитьДокументы;
	ПроверятьРегистры           = Настройки.ПроверятьРегистры;
	ПроверятьОтчеты             = Настройки.ПроверятьОтчеты;
	ПроверятьКонстанты          = Настройки.ПроверятьКонстанты;
	ПроверятьСтандарты          = Настройки.ПроверятьСтандарты;
	ПроверятьПрава              = Настройки.ПроверятьПрава;
	ПроверятьПерсональныеДанные = Настройки.ПроверятьПерсональныеДанные;
	ПроверятьИзоляцию           = Настройки.ПроверятьИзоляцию;
	ОбходитьФормы               = Настройки.ОбходитьФормы;

	ЛимитОбъектовНаВид = 0;
	ЛимитФорм          = 300;

	// Все пути по умолчанию — в одном рабочем каталоге: временный каталог
	// у каждого пользователя свой и чистится системой, а сюда можно заглянуть
	// руками и положить каталог под контроль версий
	КаталогОтчетов = БазовыйКаталогПоУмолчанию();
	ПутьСнимка     = КаталогОтчетов + "\снимок-конфигурации.json";

	НастройкиСценариев = РеквизитФормыВЗначение("Объект").НастройкиГенерацииСценариев();

	СценарииСписки      = НастройкиСценариев.ПроверятьСписки;
	СценарииСоздание    = НастройкиСценариев.ПроверятьСозданиеФорм;
	СценарииОтчеты      = НастройкиСценариев.ПроверятьОтчеты;
	СценарииОбработки   = НастройкиСценариев.ПроверятьОбработки;
	СценарииРегистры    = НастройкиСценариев.ПроверятьРегистры;
	СценарииКоманды     = НастройкиСценариев.ПроверятьКоманды;
	СценарииТолькоВидимыеРазделы = НастройкиСценариев.ТолькоВидимыеРазделы;
	СценарииНепустыеСписки = НастройкиСценариев.ПроверятьНепустыеСписки;
	СценарииОбучение = НастройкиСценариев.ОбучающийНабор;
	ФайлСлепкаФорм = КаталогОтчетов + "\слепок-форм.txt";
	СценарииУчитыватьОпции = НастройкиСценариев.УчитыватьФункциональныеОпции;
	СценарииПечать         = НастройкиСценариев.ПроверятьПечать;
	СценарииНаОсновании    = НастройкиСценариев.ПроверятьВводНаОсновании;
	СценарииОтделятьПишущие = НастройкиСценариев.ОтделятьПишущиеСценарии;
	СценарииПотоков        = НастройкиСценариев.ПотоковПрогона;
	СценарииТаймаут        = НастройкиСценариев.ТаймаутОжидания;
	СценарииЯзыкШагов      = НастройкиСценариев.ЯзыкШагов;
	СценарииМинимальнаяКритичность = НастройкиСценариев.МинимальнаяКритичность;
	СценарииПоРазделам  = НастройкиСценариев.ГруппироватьПоРазделам;
	СценарииПоПроцессам = НастройкиСценариев.ГруппироватьПоПроцессам;
	ЛимитСценариев      = 0;

	КаталогСценариев   = КаталогОтчетов + "\сценарии-vanessa";
	КаталогИсключений  = КаталогОтчетов + "\исключения";
	КаталогРезультатов = КаталогОтчетов + "\allure-results";

	Лог = "АвтоТест1С готов к работе." + Символы.ПС
		+ "Конфигурация: " + Метаданные.Синоним + " " + Метаданные.Версия + Символы.ПС
		+ "Нажмите «Выполнить прогон» — сценарии писать не нужно.";

	ЗаполнитьСписокПользователей();

КонецПроцедуры

// Пакетный режим для CI/CD (FR-21): полный автопрогон без участия человека.
//   1cv8 ENTERPRISE /F<база> /Execute АвтоТест1С.epf /CАвтоТест1С;<каталог>;<лимитОбъектов>;<лимитФорм>
// Лимиты необязательны: 0 — без ограничения, -1 для форм — не обходить интерфейс.
// По завершении отчёты сохраняются в указанный каталог, сеанс закрывается.
&НаКлиенте
Процедура ПриОткрытии(Отказ)

	// Файлы обработка пишет на клиенте, поэтому и рабочий каталог создаём здесь:
	// в клиент-серверной базе C:\1C-auto есть у пользователя, а не на сервере приложений
	ОбеспечитьКаталогНаКлиенте(КаталогОтчетов);

	Если Не СтрНачинаетсяС(ВРег(ПараметрЗапуска), "АВТОТЕСТ1С") Тогда
		Возврат;
	КонецЕсли;

	Части = СтрРазделить(ПараметрЗапуска, ";", Ложь);

	Если Части.Количество() > 1 И Не ПустаяСтрока(Части[1]) Тогда
		КаталогОтчетов = СокрЛП(Части[1]);
	КонецЕсли;

	Попытка

		Если Части.Количество() > 2 И Не ПустаяСтрока(Части[2]) Тогда
			Лимит = Цел(Число(СокрЛП(Части[2])));
			ЛимитОбъектовНаВид = ?(Лимит < 0, 0, Лимит);
		КонецЕсли;

		Если Части.Количество() > 3 И Не ПустаяСтрока(Части[3]) Тогда
			Лимит = Цел(Число(СокрЛП(Части[3])));
			Если Лимит < 0 Тогда
				ОбходитьФормы = Ложь;
			Иначе
				ЛимитФорм = Лимит;
			КонецЕсли;
		КонецЕсли;

	Исключение
		// лимиты заданы некорректно — используются значения по умолчанию
	КонецПопытки;

	ЗаписатьОтметкуПакетногоРежима("старт.log", "Пакетный режим принят, параметр: " + ПараметрЗапуска);
	ПодключитьОбработчикОжидания("ВыполнитьПакетныйПрогон", 0.5, Истина);

КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьПакетныйПрогон()

	ВыполнитьПрогонБезДиалогов();
	СохранитьОтчеты(Неопределено);
	ЗаписатьОтметкуПакетногоРежима("финиш.log", Лог);
	ЗавершитьРаботуСистемы(Ложь, Ложь);

КонецПроцедуры

// Отметки хода пакетного прогона — чтобы в CI было видно, где остановился сеанс.
&НаКлиенте
Процедура ЗаписатьОтметкуПакетногоРежима(ИмяФайла, Текст)

	Если Не ОбеспечитьКаталогНаКлиенте(КаталогОтчетов) Тогда
		Возврат;
	КонецЕсли;

	ЗаписатьФайлНаКлиенте(ПутьВКаталоге(КаталогОтчетов, "АвтоТест1С-" + ИмяФайла), Текст);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ВыполнитьПрогон(Команда) Экспорт

	ВыполнитьПрогонБезДиалогов();
	ПоказатьПредупреждение(, "Прогон завершён. Отчёт — в нижней части формы.");

КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьПрогонБезДиалогов()

	Состояние("АвтоТест1С: серверные проверки...");
	СписокФорм = ЗапуститьПрогонНаСервере();

	ДанныеОбхода = Новый Массив;
	Если ОбходитьФормы И СписокФорм.Количество() > 0 Тогда
		ДанныеОбхода = ОбойтиФормыВКлиенте(СписокФорм);
	КонецЕсли;

	Состояние("АвтоТест1С: расчёт покрытия и риск-карты...");
	ЗавершитьПрогонНаСервере(ДанныеОбхода);
	Состояние();

КонецПроцедуры

&НаКлиенте
Процедура ПостроитьКарту(Команда) Экспорт

	ПостроитьКартуНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура СохранитьСнимок(Команда) Экспорт

	Данные = ТекстСнимкаНаСервере();
	Если Данные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если Не ЗаписатьФайлНаКлиенте(ПутьСнимка, Данные.Текст) Тогда
		Возврат;
	КонецЕсли;

	Лог = "FR-08 / FR-12. Снимок конфигурации сохранён: " + ПутьСнимка + Символы.ПС
		+ "Зафиксировано объектов: " + Данные.Объектов + Символы.ПС
		+ "После доработки включите «Только затронутые изменением» — прогон сузится до задетых объектов.";

КонецПроцедуры

&НаКлиенте
Процедура СохранитьОтчеты(Команда) Экспорт

	Если ПустаяСтрока(АдресРезультата) Тогда
		ПоказатьПредупреждение(, "Сначала выполните прогон.");
		Возврат;
	КонецЕсли;

	Данные = ТекстыОтчетовНаСервере();
	Если Данные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если Не ОбеспечитьКаталогНаКлиенте(КаталогОтчетов) Тогда
		Возврат;
	КонецЕсли;

	Сохранено = Новый Массив;

	Для Каждого ОписаниеФайла Из Данные.Файлы Цикл
		Путь = ПутьВКаталоге(КаталогОтчетов, ОписаниеФайла.ИмяФайла);
		Если ЗаписатьФайлНаКлиенте(Путь, ОписаниеФайла.Текст) Тогда
			Сохранено.Добавить(Путь);
		КонецЕсли;
	КонецЦикла;

	// Табличный документ умеет записывать себя сам — и на клиенте тоже
	ПутьMXL = ПутьВКаталоге(КаталогОтчетов, Данные.ИмяMXL);
	Попытка
		Отчет.Записать(ПутьMXL);
		Сохранено.Добавить(ПутьMXL);
	Исключение
		Лог = Лог + Символы.ПС + "Не удалось записать " + ПутьMXL + ": "
			+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	Текст = "Отчёты сохранены:";
	Для Каждого Путь Из Сохранено Цикл
		Текст = Текст + Символы.ПС + "  " + Путь;
	КонецЦикла;

	Лог = ?(ПустаяСтрока(Лог), Текст, Лог + Символы.ПС + Символы.ПС + Текст);

КонецПроцедуры

&НаКлиенте
Процедура ОчиститьРезультаты(Команда)

	Лог = "";
	Отчет = Новый ТабличныйДокумент;
	АдресРезультата = "";

КонецПроцедуры

// FR-02, FR-06. Сценарии интерфейса для Vanessa Automation: карта объектов
// превращается в .feature-файлы, которые можно запускать как обычный набор.
&НаКлиенте
Процедура СгенерироватьСценарииVanessa(Команда) Экспорт

	Если ПустаяСтрока(КаталогСценариев) Тогда
		ПоказатьПредупреждение(, "Укажите каталог, в который сохранять сценарии.");
		Возврат;
	КонецЕсли;

	РезультатГенерации = СгенерироватьСценарииНаСервере();
	Если РезультатГенерации = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ЗаписатьСценарииНаКлиенте(РезультатГенерации);

КонецПроцедуры

// Запись набора на клиенте. Прежнюю выгрузку удаляем: иначе после смены
// пользователя или группировки в каталоге остаются файлы от старого набора,
// и он выглядит так, будто в него попали лишние разделы.
&НаКлиенте
Процедура ЗаписатьСценарииНаКлиенте(РезультатГенерации)

	Если Не ОбеспечитьКаталогНаКлиенте(КаталогСценариев) Тогда
		Возврат;
	КонецЕсли;

	Удалено = 0;
	Попытка
		Для Каждого Файл Из НайтиФайлы(КаталогСценариев, "UI. *.feature", Истина) Цикл
			УдалитьФайлы(Файл.ПолноеИмя);
			Удалено = Удалено + 1;
		КонецЦикла;
	Исключение
		// файл мог быть занят открытым редактором — это не повод прерывать запись
	КонецПопытки;

	Записано = 0;
	ТекстЛога = "Сценарии Vanessa сгенерированы: " + РезультатГенерации.Сценариев
		+ " сценариев по " + РезультатГенерации.Объектов + " объектам, файлов — "
		+ РезультатГенерации.Файлы.Количество() + "."
		+ Символы.ПС + "Каталог: " + КаталогСценариев;

	Для Каждого ОписаниеФайла Из РезультатГенерации.Файлы Цикл

		Путь = ПутьВКаталоге(КаталогСценариев, ОписаниеФайла.ИмяФайла);
		Если Не ЗаписатьФайлНаКлиенте(Путь, ОписаниеФайла.Текст) Тогда
			Продолжить;
		КонецЕсли;

		Записано = Записано + 1;
		ТекстЛога = ТекстЛога + Символы.ПС + "  • " + ОписаниеФайла.ИмяФайла
			+ " — сценариев: " + ОписаниеФайла.Сценариев;

	КонецЦикла;

	Если Удалено > 0 Тогда
		ТекстЛога = ТекстЛога + Символы.ПС + "Файлов прошлой выгрузки удалено: " + Удалено + ".";
	КонецЕсли;

	Если Записано < РезультатГенерации.Файлы.Количество() Тогда
		ТекстЛога = ТекстЛога + Символы.ПС + "Записано файлов: " + Записано
			+ " из " + РезультатГенерации.Файлы.Количество() + ".";
	КонецЕсли;

	Лог = ?(ПустаяСтрока(Лог), ТекстЛога, Лог + Символы.ПС + ТекстЛога);

КонецПроцедуры

#КонецОбласти

// Заготовки файлов исключений: удобнее один раз получить готовую структуру
// с пояснениями в комментариях, чем вспоминать формат строк.
&НаКлиенте
Процедура СоздатьФайлыИсключений(Команда) Экспорт

	Если ПустаяСтрока(КаталогИсключений) Тогда
		ПоказатьПредупреждение(, "Укажите каталог исключений.");
		Возврат;
	КонецЕсли;

	Заготовки = ЗаготовкиИсключенийНаСервере();
	Если Заготовки = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если Не ОбеспечитьКаталогНаКлиенте(КаталогИсключений) Тогда
		Возврат;
	КонецЕсли;

	Создано = 0;

	Для Каждого Заготовка Из Заготовки Цикл

		Путь = ПутьВКаталоге(КаталогИсключений, Заготовка.ИмяФайла);

		// Существующий файл не трогаем: в нём уже может быть ручной список
		ФайлИсключений = Новый Файл(Путь);
		Если ФайлИсключений.Существует() Тогда
			Продолжить;
		КонецЕсли;

		Если ЗаписатьФайлНаКлиенте(Путь, Заготовка.Текст) Тогда
			Создано = Создано + 1;
		КонецЕсли;

	КонецЦикла;

	Лог = Лог + Символы.ПС + "Файлы исключений: создано " + Создано
		+ " в каталоге " + КаталогИсключений + "."
		+ Символы.ПС + "Строка файла — имя объекта, при необходимости с типом проверки:"
		+ Символы.ПС + "  РассылкиОтчетов.Список — исключить только список,"
		+ Символы.ПС + "  Присоединенные* — исключить все объекты по маске.";

КонецПроцедуры

&НаСервере
Функция ЗаготовкиИсключенийНаСервере()

	Попытка
		Возврат РеквизитФормыВЗначение("Объект").ЗаготовкиИсключений();
	Исключение
		Лог = Лог + Символы.ПС + "Не удалось подготовить файлы исключений: "
			+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

// У-09. Отчёт «покрытие интерфейса»: сколько объектов конфигурации попало
// в набор и почему не попали остальные.
&НаКлиенте
Процедура СохранитьПокрытиеИнтерфейса(Команда) Экспорт

	Если ПустаяСтрока(АдресПокрытия) Тогда
		ПоказатьПредупреждение(, "Сначала сгенерируйте сценарии: покрытие считается при генерации.");
		Возврат;
	КонецЕсли;

	Текст = ОтчетПокрытияНаСервере();
	Если Текст = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Путь = ПутьВКаталоге(КаталогОтчетов, "АвтоТест1С-покрытие-интерфейса.md");
	Если Не ЗаписатьФайлНаКлиенте(Путь, Текст) Тогда
		Возврат;
	КонецЕсли;

	Лог = Лог + Символы.ПС + "Отчёт покрытия интерфейса: " + Путь;

КонецПроцедуры

&НаСервере
Функция ОтчетПокрытияНаСервере()

	Покрытие = ПолучитьИзВременногоХранилища(АдресПокрытия);
	Если Покрытие = Неопределено Тогда
		Лог = Лог + Символы.ПС + "Данные покрытия потеряны — сгенерируйте сценарии заново.";
		Возврат Неопределено;
	КонецЕсли;

	Попытка
		Возврат РеквизитФормыВЗначение("Объект").ОтчетПокрытияИнтерфейса(Покрытие);
	Исключение
		Лог = Лог + Символы.ПС + "Отчёт покрытия не сформирован: "
			+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

// У-03. Разбор результатов прогона: штатные отказы конфигурации выносятся
// в исключения, остальные падения остаются для разбора человеком.
&НаКлиенте
Процедура РазобратьРезультатыПрогона(Команда) Экспорт

	Если ПустаяСтрока(КаталогРезультатов) Тогда
		ПоказатьПредупреждение(, "Укажите каталог результатов прогона (allure-results).");
		Возврат;
	КонецЕсли;

	Если Не ОбеспечитьКаталогНаКлиенте(КаталогИсключений) Тогда
		Возврат;
	КонецЕсли;

	ФайлыИсключений = РазобратьРезультатыНаСервере();
	Если ФайлыИсключений = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ДописатьИсключенияНаКлиенте(ФайлыИсключений);

КонецПроцедуры

// Дописывает предложенные исключения, не трогая то, что уже есть в файле:
// в нём может быть ручной список, и перезаписывать его нельзя.
&НаКлиенте
Процедура ДописатьИсключенияНаКлиенте(ФайлыИсключений)

	Записано = 0;

	Для Каждого ОписаниеФайла Из ФайлыИсключений Цикл

		Путь = ПутьВКаталоге(КаталогИсключений, ОписаниеФайла.ИмяФайла);

		Существующие = Новый Соответствие;
		Файл = Новый Файл(Путь);

		Если Файл.Существует() Тогда
			Попытка
				Чтение = Новый ЧтениеТекста(Путь, КодировкаТекста.UTF8);
				Строка = Чтение.ПрочитатьСтроку();
				Пока Строка <> Неопределено Цикл
					Существующие.Вставить(НРег(СокрЛП(Строка)), Истина);
					Строка = Чтение.ПрочитатьСтроку();
				КонецЦикла;
				Чтение.Закрыть();
			Исключение
				Лог = Лог + Символы.ПС + "Не удалось прочитать «" + Путь + "»: "
					+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
				Продолжить;
			КонецПопытки;
		ИначеЕсли Не ЗаписатьФайлНаКлиенте(Путь, ОписаниеФайла.Шапка) Тогда
			Продолжить;
		КонецЕсли;

		Новые = Новый Массив;
		Для Каждого Значение Из ОписаниеФайла.Строки Цикл
			Если Существующие[НРег(Значение)] = Неопределено Тогда
				Новые.Добавить(Значение);
			КонецЕсли;
		КонецЦикла;

		Если Новые.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;

		Попытка
			Запись = Новый ЗаписьТекста(Путь, КодировкаТекста.UTF8, , Истина);
			Запись.ЗаписатьСтроку("");
			Запись.ЗаписатьСтроку("// Добавлено разбором прогона "
				+ Формат(ТекущаяДата(), "ДФ=dd.MM.yyyy HH:mm"));
			Для Каждого Значение Из Новые Цикл
				Запись.ЗаписатьСтроку(Значение);
				Записано = Записано + 1;
			КонецЦикла;
			Запись.Закрыть();
		Исключение
			Лог = Лог + Символы.ПС + "Не удалось дописать «" + Путь + "»: "
				+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		КонецПопытки;

	КонецЦикла;

	Лог = Лог + Символы.ПС + "В файлы исключений дописано строк: " + Записано + ".";

КонецПроцедуры

&НаСервере
Функция РазобратьРезультатыНаСервере()

	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");

	Попытка
		// Каталог исключений не передаём: дописывать в файлы будет клиент
		Разбор = ОбработкаОбъект.РазобратьРезультатыПрогона(КаталогРезультатов);
		ФайлыИсключений = ОбработкаОбъект.ИсключенияПоФайлам(Разбор.Предложения);
	Исключение
		Лог = Лог + Символы.ПС + "Не удалось разобрать результаты прогона: "
			+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат Неопределено;
	КонецПопытки;

	Текст = "";
	Для Каждого СтрокаЛога Из Разбор.Лог Цикл
		Текст = Текст + ?(ПустаяСтрока(Текст), "", Символы.ПС) + СтрокаЛога;
	КонецЦикла;

	Если Разбор.Дефекты.Количество() > 0 Тогда
		Текст = Текст + Символы.ПС + "Требуют разбора (в исключения не добавлены):";
		Показано = 0;
		Для Каждого Дефект Из Разбор.Дефекты Цикл
			Если Показано >= 15 Тогда
				Текст = Текст + Символы.ПС + "  … и ещё " + (Разбор.Дефекты.Количество() - Показано);
				Прервать;
			КонецЕсли;
			Текст = Текст + Символы.ПС + "  • " + Дефект.Сценарий + " — " + Дефект.Причина;
			Показано = Показано + 1;
		КонецЦикла;
	КонецЕсли;

	Лог = ?(ПустаяСтрока(Лог), Текст, Лог + Символы.ПС + Текст);

	Возврат ФайлыИсключений;

КонецФункции

#Область РаботаСФайламиНаКлиенте

// Файлы обработка пишет на клиенте: в клиент-серверной базе каталог вроде
// C:\1C-auto существует на машине пользователя, а не на сервере приложений,
// и записанный сервером набор пользователь у себя просто не нашёл бы.
&НаКлиенте
Функция ОбеспечитьКаталогНаКлиенте(Каталог)

	Если ПустаяСтрока(Каталог) Тогда
		Возврат Ложь;
	КонецЕсли;

	Попытка

		ОбъектКаталога = Новый Файл(Каталог);
		Если Не ОбъектКаталога.Существует() Тогда
			СоздатьКаталог(Каталог);
		КонецЕсли;

		Возврат Истина;

	Исключение

		Лог = Лог + Символы.ПС + "Не удалось создать каталог «" + Каталог + "»: "
			+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат Ложь;

	КонецПопытки;

КонецФункции

&НаКлиенте
Функция ЗаписатьФайлНаКлиенте(Путь, Текст)

	Если Не ОбеспечитьКаталогНаКлиенте(КаталогФайла(Путь)) Тогда
		Возврат Ложь;
	КонецЕсли;

	Попытка
		Запись = Новый ЗаписьТекста(Путь, КодировкаТекста.UTF8);
		Запись.Записать(Текст);
		Запись.Закрыть();
		Возврат Истина;
	Исключение
		Лог = Лог + Символы.ПС + "Не удалось записать «" + Путь + "»: "
			+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат Ложь;
	КонецПопытки;

КонецФункции

&НаКлиенте
Функция ПутьВКаталоге(Каталог, ИмяФайла)

	Разделитель = ПолучитьРазделительПути();

	Возврат Каталог + ?(Прав(Каталог, 1) = Разделитель, "", Разделитель) + ИмяФайла;

КонецФункции

&НаКлиенте
Функция КаталогФайла(Путь)

	Позиция = СтрНайти(Путь, ПолучитьРазделительПути(), НаправлениеПоиска.СКонца);

	Возврат ?(Позиция = 0, "", Лев(Путь, Позиция - 1));

КонецФункции

