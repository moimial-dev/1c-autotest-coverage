#Область ОбходИнтерфейса

// FR-02. Автоматический обход интерфейса: создаём каждую форму конфигурации
// и фиксируем необработанные исключения с причиной, а не только фактом ошибки.
&НаКлиенте
Функция ОбойтиФормыВКлиенте(СписокФорм)

	ДанныеОбхода = Новый Массив;
	Всего = СписокФорм.Количество();
	Номер = 0;

	Для Каждого Описание Из СписокФорм Цикл

		Номер = Номер + 1;
		ОбработкаПрерыванияПользователя();

		Если Номер % 10 = 0 Или Номер = 1 Тогда
			Состояние("АвтоТест1С: обход форм " + Номер + " из " + Всего + "...");
		КонецЕсли;

		Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();

		Элемент = Новый Структура;
		Элемент.Вставить("ИмяФормы",    Описание.ИмяФормы);
		Элемент.Вставить("Объект",      Описание.Объект);
		Элемент.Вставить("Вид",         Описание.Вид);
		Элемент.Вставить("Процесс",     Описание.Процесс);
		Элемент.Вставить("Критичность", Описание.Критичность);

		Попытка
			Форма = ПолучитьФорму(Описание.ИмяФормы);
			Форма = Неопределено;
			Элемент.Вставить("Успех",     Истина);
			Элемент.Вставить("Сообщение", "");
		Исключение
			Элемент.Вставить("Успех",     Ложь);
			Элемент.Вставить("Сообщение", КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;

		Элемент.Вставить("Длительность", (ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало) / 1000);
		ДанныеОбхода.Добавить(Элемент);

	КонецЦикла;

	Возврат ДанныеОбхода;

КонецФункции

#КонецОбласти

#Область СерверныеВызовы

&НаСервере
Функция ЗапуститьПрогонНаСервере()

	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");

	Настройки = СобратьНастройки(ОбработкаОбъект);
	Результат = ОбработкаОбъект.ВыполнитьПрогон(Настройки);

	СписокФорм = Новый Массив;
	Если ОбходитьФормы Тогда
		СписокФорм = ОтобратьФормыДляОбхода(ОбработкаОбъект.СписокФормДляОбхода(Результат, Настройки));
	КонецЕсли;

	АдресРезультата = ПоместитьВоВременноеХранилище(Результат, УникальныйИдентификатор);
	ВывестиЛог(Результат);

	Возврат СписокФорм;

КонецФункции

&НаСервере
Процедура ЗавершитьПрогонНаСервере(ДанныеОбхода)

	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	Результат = ПолучитьИзВременногоХранилища(АдресРезультата);

	Если ДанныеОбхода.Количество() > 0 Тогда
		ОбработкаОбъект.ДобавитьРезультатыОбходаФорм(Результат, ДанныеОбхода);
	КонецЕсли;

	ОбработкаОбъект.ЗавершитьПрогон(Результат);

	АдресРезультата = ПоместитьВоВременноеХранилище(Результат, УникальныйИдентификатор);
	Отчет = ОбработкаОбъект.ОтчетТабличныйДокумент(Результат);
	ВывестиЛог(Результат);

КонецПроцедуры

&НаСервере
Процедура ПостроитьКартуНаСервере()

	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	Настройки = СобратьНастройки(ОбработкаОбъект);

	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Карта = ОбработкаОбъект.ПостроитьКартуОбъектов(Настройки);
	Длительность = (ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало) / 1000;

	ПоВидам = Новый Соответствие;
	Для Каждого Строка Из Карта Цикл
		ПоВидам.Вставить(Строка.Вид, ?(ПоВидам[Строка.Вид] = Неопределено, 0, ПоВидам[Строка.Вид]) + 1);
	КонецЦикла;

	Текст = Новый Массив;
	Текст.Добавить("FR-01. Карта объектов построена за " + Формат(Длительность, "ЧДЦ=2") + " сек.");
	Текст.Добавить("Всего объектов: " + Карта.Количество());
	Для Каждого КлючЗначение Из ПоВидам Цикл
		Текст.Добавить("  " + КлючЗначение.Ключ + ": " + КлючЗначение.Значение);
	КонецЦикла;

	Лог = СтрСоединить(Текст, Символы.ПС);

КонецПроцедуры

// Сервер только считает содержимое: сам файл пишет клиент.
&НаСервере
Функция ТекстСнимкаНаСервере()

	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	Настройки = СобратьНастройки(ОбработкаОбъект);

	Попытка
		Карта = ОбработкаОбъект.ПостроитьКартуОбъектов(Настройки);
		Текст = ОбработкаОбъект.ТекстСнимка(Карта);
	Исключение
		Лог = Лог + Символы.ПС + "Снимок конфигурации не построен: "
			+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат Неопределено;
	КонецПопытки;

	Данные = Новый Структура;
	Данные.Вставить("Текст",    Текст);
	Данные.Вставить("Объектов", Карта.Количество());

	Возврат Данные;

КонецФункции

&НаСервере
Функция ТекстыОтчетовНаСервере()

	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	Результат = ПолучитьИзВременногоХранилища(АдресРезультата);

	Попытка
		Файлы = ОбработкаОбъект.ТекстыОтчетов(Результат);
		Отчет = ОбработкаОбъект.ОтчетТабличныйДокумент(Результат);
	Исключение
		Лог = Лог + Символы.ПС + "Отчёты не сформированы: "
			+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат Неопределено;
	КонецПопытки;

	Данные = Новый Структура;
	Данные.Вставить("Файлы",  Файлы);
	Данные.Вставить("ИмяMXL", "АвтоТест1С-"
		+ Формат(Результат.ДатаНачала, "ДФ=yyyyMMdd-HHmmss") + ".mxl");

	Возврат Данные;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция СгенерироватьСценарииНаСервере()

	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");

	НастройкиГенерации = ОбработкаОбъект.НастройкиГенерацииСценариев();
	НастройкиГенерации.КаталогСценариев        = КаталогСценариев;
	НастройкиГенерации.ПроверятьСписки         = СценарииСписки;
	НастройкиГенерации.ПроверятьСозданиеФорм   = СценарииСоздание;
	НастройкиГенерации.ПроверятьОтчеты         = СценарииОтчеты;
	НастройкиГенерации.ПроверятьОбработки      = СценарииОбработки;
	НастройкиГенерации.ПроверятьРегистры       = СценарииРегистры;
	НастройкиГенерации.ПроверятьКоманды        = СценарииКоманды;
	НастройкиГенерации.ГруппироватьПоРазделам  = СценарииПоРазделам;
	НастройкиГенерации.ГруппироватьПоПроцессам = СценарииПоПроцессам;
	НастройкиГенерации.ЛимитОбъектовНаВид      = ЛимитОбъектовНаВид;
	НастройкиГенерации.ЛимитСценариев          = ЛимитСценариев;
	НастройкиГенерации.ПрофильКлиента          = ПрофильКлиентаСценариев;
	НастройкиГенерации.ПользовательИБ          = ПользовательСценариев;
	НастройкиГенерации.ПарольПользователя      = ПарольПользователяСценариев;
	НастройкиГенерации.КаталогИсключений       = КаталогИсключений;
	НастройкиГенерации.ТолькоВидимыеРазделы    = СценарииТолькоВидимыеРазделы;
	НастройкиГенерации.ПроверятьНепустыеСписки = СценарииНепустыеСписки;
	НастройкиГенерации.ОбучающийНабор          = СценарииОбучение;
	НастройкиГенерации.ФайлСлепкаФорм          = ФайлСлепкаФорм;
	НастройкиГенерации.УчитыватьФункциональныеОпции = СценарииУчитыватьОпции;
	НастройкиГенерации.МинимальнаяКритичность  = СценарииМинимальнаяКритичность;
	НастройкиГенерации.ПроверятьПечать         = СценарииПечать;
	НастройкиГенерации.ПроверятьВводНаОсновании = СценарииНаОсновании;
	НастройкиГенерации.ОтделятьПишущиеСценарии = СценарииОтделятьПишущие;
	НастройкиГенерации.ПотоковПрогона          = СценарииПотоков;
	НастройкиГенерации.ТаймаутОжидания         = ?(СценарииТаймаут > 0, СценарииТаймаут, 8);
	НастройкиГенерации.ЯзыкШагов               = ?(ПустаяСтрока(СценарииЯзыкШагов), "ru", СценарииЯзыкШагов);

	// Набор пишет клиент: у сервера приложений своего C:\1C-auto нет
	НастройкиГенерации.ЗаписыватьФайлы = Ложь;

	Попытка
		РезультатГенерации = ОбработкаОбъект.СгенерироватьСценарииVanessa(НастройкиГенерации);
	Исключение
		Лог = Лог + Символы.ПС + "Генерация сценариев не выполнена: "
			+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат Неопределено;
	КонецПопытки;

	// У-09. Покрытие считается при генерации: отдельный пересчёт дал бы другие цифры,
	// если между генерацией и отчётом поменять настройки
	АдресПокрытия = ПоместитьВоВременноеХранилище(РезультатГенерации.Покрытие, УникальныйИдентификатор);

	Если РезультатГенерации.Лог.Количество() > 0 Тогда
		ТекстЛога = СтрСоединить(РезультатГенерации.Лог, Символы.ПС);
		Лог = ?(ПустаяСтрока(Лог), ТекстЛога, Лог + Символы.ПС + ТекстЛога);
	КонецЕсли;

	Возврат РезультатГенерации;

КонецФункции

// Список пользователей информационной базы для выбора: набор сценариев
// имеет смысл строить под конкретного пользователя — тогда в него попадут
// только доступные ему объекты, как их видит он сам.
&НаСервере
Процедура ЗаполнитьСписокПользователей()

	СписокВыбора = Элементы.ПользовательСценариевПоле.СписокВыбора;
	СписокВыбора.Очистить();
	СписокВыбора.Добавить("", "<все объекты конфигурации>");

	Попытка
		ПользователиИБ = ПользователиИнформационнойБазы.ПолучитьПользователей();
	Исключение
		// Список пользователей доступен только с правом администрирования.
		// Молча пустой список выглядел бы как поломка, поэтому пишем причину
		ОшибкаСписка = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Элементы.ПользовательСценариевПоле.ПодсказкаВвода = "Список недоступен: " + ОшибкаСписка;
		Лог = Лог + ?(ПустаяСтрока(Лог), "", Символы.ПС)
			+ "Не удалось получить список пользователей информационной базы: " + ОшибкаСписка;
		Возврат;
	КонецПопытки;

	Если ПользователиИБ.Количество() = 0 Тогда
		Лог = Лог + ?(ПустаяСтрока(Лог), "", Символы.ПС)
			+ "В информационной базе не заведено ни одного пользователя — отбор по правам недоступен.";
		Возврат;
	КонецЕсли;

	// В списке показываем имя входа как есть: в поле остаётся представление,
	// а оно потом идёт логином в шаг подключения клиента тестирования. Имя входа
	// само может содержать скобки («БушуевЭР (Менеджер)»), поэтому добавлять
	// к нему полное имя нельзя — строку станет невозможно разобрать обратно
	Имена = Новый СписокЗначений;
	Для Каждого ПользовательИБ Из ПользователиИБ Цикл
		Если Не ПустаяСтрока(ПользовательИБ.Имя) Тогда
			Имена.Добавить(ПользовательИБ.Имя, ПользовательИБ.Имя);
		КонецЕсли;
	КонецЦикла;

	Имена.СортироватьПоЗначению();

	Для Каждого Элемент Из Имена Цикл
		СписокВыбора.Добавить(Элемент.Значение, Элемент.Значение);
	КонецЦикла;

КонецПроцедуры

&НаСервере
Функция СобратьНастройки(ОбработкаОбъект)

	Настройки = ОбработкаОбъект.НастройкиПрогона();

	Настройки.ПроверятьСправочники        = ПроверятьСправочники;
	Настройки.ПроверятьДокументы          = ПроверятьДокументы;
	Настройки.ПроводитьДокументы          = ПроводитьДокументы;
	Настройки.ПроверятьРегистры           = ПроверятьРегистры;
	Настройки.ПроверятьОтчеты             = ПроверятьОтчеты;
	Настройки.ПроверятьКонстанты          = ПроверятьКонстанты;
	Настройки.ПроверятьСтандарты          = ПроверятьСтандарты;
	Настройки.ПроверятьПрава              = ПроверятьПрава;
	Настройки.ПроверятьПерсональныеДанные = ПроверятьПерсональныеДанные;
	Настройки.ПроверятьИзоляцию           = ПроверятьИзоляцию;
	Настройки.ОбходитьФормы               = ОбходитьФормы;
	Настройки.ЛимитОбъектовНаВид          = ЛимитОбъектовНаВид;
	Настройки.ЛимитФорм                   = ЛимитФорм;
	Настройки.ТолькоЗатронутыеИзменением  = ТолькоЗатронутыеИзменением;
	Настройки.ПутьСнимка                  = ПутьСнимка;
	Настройки.КаталогОтчетов              = КаталогОтчетов;

	Возврат Настройки;

КонецФункции

// Формы записи регистров и формы, требующие обязательных параметров, дают
// ложные срабатывания при слепом обходе — исключаем их заранее.
&НаСервере
Функция ОтобратьФормыДляОбхода(СписокФорм)

	Отобранные = Новый Массив;

	Для Каждого Описание Из СписокФорм Цикл

		ИмяВРег = ВРег(Описание.ИмяФормы);

		Если СтрНайти(ИмяВРег, "ФОРМАЗАПИСИ") > 0
			Или СтрНайти(ИмяВРег, "ФОРМАНАБОРАЗАПИСЕЙ") > 0 Тогда
			Продолжить;
		КонецЕсли;

		Отобранные.Добавить(Описание);

	КонецЦикла;

	Возврат Отобранные;

КонецФункции

&НаСервере
Процедура ВывестиЛог(Результат)

	Лог = СтрСоединить(Результат.Лог, Символы.ПС);

КонецПроцедуры

// Рабочий каталог по умолчанию — один на все пути обработки. Создаёт его
// клиент: в клиент-серверной базе C:\1C-auto есть на машине пользователя,
// а не на сервере приложений.
&НаКлиентеНаСервереБезКонтекста
Функция БазовыйКаталогПоУмолчанию()

	Возврат "C:\1C-auto\АвтоТест1С";

КонецФункции

#КонецОбласти
